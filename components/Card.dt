// DirectedType Standard Component Library: Card
// Universal surface container styled by a CardStyle bundle with reactive focus/blur styling.
// Always automatically sized to wrap its interior components; exposes read-only height and bottom aliases.
\use "components/CardStyle.dt"

// 1. Explicit / Fixed Width Card: zero references to parent.width, preventing layout DAG cycles
\Component Card(
    style: CardStyle,
    width: Distance,
    x: Distance,
    y: Distance,
    gap: Distance: 0,
    focused_bg: Color: #eff6ff,
    focused_border_color: Color: #3b82f6,
    focused_border_width: Distance: 2px,
    on_focus = self.focus,
    on_blur = self.blur
) {
    \state focused: Boolean = false;

    \alias right = x + width;
    \alias height = sum(children.height) + max(0, children.len - 1) * gap + (2 * style.padding_y);
    \alias bottom = y + height;

    \let current_bg = focused ? focused_bg : style.bg;
    \let current_border_color = focused ? focused_border_color : style.border_color;
    \let current_border_width = focused ? focused_border_width : style.border_width;

    \Rect(
        x: x,
        y: y,
        width: width,
        height: height,
        color: current_bg,
        radius: style.radius,
        border_color: current_border_color,
        border_width: current_border_width
    )

    \let inner_width = width - (2 * style.padding_x);

    \Children {
        x: left + style.padding_x,
        y: prev ? prev.bottom + gap : top + style.padding_y,
        width: inner_width
    }
}

// 2. Fluid / Parent-Filling Card: automatically spans parent width
\Component Card(
    style: CardStyle,
    x: Distance,
    y: Distance,
    gap: Distance: 0,
    focused_bg: Color: #eff6ff,
    focused_border_color: Color: #3b82f6,
    focused_border_width: Distance: 2px,
    on_focus = self.focus,
    on_blur = self.blur
) {
    \state focused: Boolean = false;

    \let resolved_width = parent.width - (2 * x);

    \alias right = x + resolved_width;
    \alias width = resolved_width;
    \alias height = sum(children.height) + max(0, children.len - 1) * gap + (2 * style.padding_y);
    \alias bottom = y + height;

    \let current_bg = focused ? focused_bg : style.bg;
    \let current_border_color = focused ? focused_border_color : style.border_color;
    \let current_border_width = focused ? focused_border_width : style.border_width;

    \Rect(
        x: x,
        y: y,
        width: resolved_width,
        height: height,
        color: current_bg,
        radius: style.radius,
        border_color: current_border_color,
        border_width: current_border_width
    )

    \let inner_width = resolved_width - (2 * style.padding_x);

    \Children {
        x: left + style.padding_x,
        y: prev ? prev.bottom + gap : top + style.padding_y,
        width: inner_width
    }
}
