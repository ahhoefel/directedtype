// DirectedType Standard Component Library: HDivider
// Clean 1px horizontal hairline separator rule for dividing sections, headers, and list items.

// 1. Fluid HDivider: spans full width of parent container
\Component HDivider(
    x: Distance = parent.left,
    y: Distance = parent.top,
    color: Color = #334155,
    thickness: Distance = 1px
) {
    \let resolved_width = parent.width;

    \alias width = resolved_width;
    \alias right = x + resolved_width;
    \alias bottom = y + thickness;
    \alias height = thickness;

    \Rect(
        x: x,
        y: y,
        width: resolved_width,
        height: thickness,
        color: color
    )
}

// 2. Fixed Width HDivider: renders horizontal hairline with explicit width
\Component HDivider(
    width: Distance,
    x: Distance = parent.left,
    y: Distance = parent.top,
    color: Color = #334155,
    thickness: Distance = 1px
) {
    \alias right = x + width;
    \alias bottom = y + thickness;
    \alias height = thickness;

    \Rect(
        x: x,
        y: y,
        width: width,
        height: thickness,
        color: color
    )
}
