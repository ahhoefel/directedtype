// DirectedType Standard Component Library: Divider
// Clean 1px hairline separator rule for dividing sections, headers, and list items.

// 1. Fluid Divider: spans full width of parent container
\Component Divider(
    x: Distance,
    y: Distance,
    color: Color = #334155,
    thickness: Distance = 1px
) {
    \let resolved_width = parent.width;

    \alias width = resolved_width;
    \alias right = x + resolved_width;
    \alias bottom = y + thickness;
    \alias height = thickness;

    \Rect(
        x: x,
        y: y,
        width: resolved_width,
        height: thickness,
        color: color
    )
}

// 2. Fixed Width Divider: renders hairline with explicit width
\Component Divider(
    width: Distance,
    x: Distance,
    y: Distance,
    color: Color = #334155,
    thickness: Distance = 1px
) {
    \alias right = x + width;
    \alias bottom = y + thickness;
    \alias height = thickness;

    \Rect(
        x: x,
        y: y,
        width: width,
        height: thickness,
        color: color
    )
}
