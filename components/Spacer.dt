// DirectedType Standard Component Library: Spacer
// Invisible, non-visual layout element used inside VStack and HStack to insert
// fixed intervals or custom spacing between sibling elements.

// 1. Vertical Spacer: inserts vertical whitespace in VStack
\Component Spacer(
    height: Distance,
    x: Distance,
    y: Distance
) {
    \alias right = x;
    \alias bottom = y + height;
    \alias width = 0px;
}

// 2. Horizontal Spacer: inserts horizontal whitespace in HStack
\Component Spacer(
    width: Distance,
    x: Distance,
    y: Distance
) {
    \alias right = x + width;
    \alias bottom = y;
    \alias height = 0px;
}

// 3. 2D Box Spacer: inserts explicit 2D spatial separation
\Component Spacer(
    width: Distance,
    height: Distance,
    x: Distance,
    y: Distance
) {
    \alias right = x + width;
    \alias bottom = y + height;
}
