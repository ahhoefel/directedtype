// DirectedType Standard Component Library: Button
// High-performance declarative button with variants, intrinsic text sizing, and companion state.
\use "components/Center.dt"

// 1. Explicit / Fixed Width Button: zero text_width measurement needed
\Component Button(
    width: Number,
    x: Number,
    y: Number,
    height: Number: 38,
    label: String: "",
    variant: String: "primary",
    disabled: Boolean: false,
    radius: Number: 8,
    size: Number: 14,
    weight: Number: 600,
    show_count: Boolean: false
) {
    state click_count: Number: 0;

    let font_size = size;
    let font_weight = weight;

    let is_primary = variant == "primary";
    let is_secondary = variant == "secondary";
    let is_outline = variant == "outline";
    let is_ghost = variant == "ghost";
    let is_danger = variant == "danger";
    let is_success = variant == "success";

    let bg_color = disabled ? #33415580 : (
        is_primary ? #2563eb : (
            is_secondary ? #334155 : (
                is_outline ? #0f172a : (
                    is_ghost ? #00000000 : (
                        is_danger ? #dc2626 : (
                            is_success ? #16a34a : #2563eb
                        )
                    )
                )
            )
        )
    );

    let text_color = disabled ? #64748b : (
        is_outline ? #38bdf8 : (
            is_ghost ? #94a3b8 : #ffffff
        )
    );

    let border_color = disabled ? #33415540 : (
        is_outline ? #38bdf8 : (
            is_primary ? #3b82f6 : (
                is_secondary ? #475569 : (
                    is_danger ? #ef4444 : (
                        is_success ? #22c55e : #00000000
                    )
                )
            )
        )
    );

    let border_w = is_outline ? 1.5 : (
        is_ghost ? 0 : 1
    );

    let display_label = (show_count && click_count > 0) ? (label + " (" + click_count + ")") : label;

    alias right = x + width;
    alias bottom = y + height;

    \Rect(
        x: x,
        y: y,
        width: width,
        height: height,
        color: bg_color,
        radius: radius,
        border_color: border_color,
        border_width: border_w,
        on_click: self.click
    ) {
        \Center {
            \Text(
                size: font_size,
                weight: font_weight,
                color: text_color,
                text: display_label
            )
        }
    }
}

// 2. Intrinsic Text-Sized Button: automatically sizes width based on label measurement
\Component Button(
    x: Number,
    y: Number,
    height: Number: 38,
    label: String: "",
    variant: String: "primary",
    disabled: Boolean: false,
    radius: Number: 8,
    size: Number: 14,
    weight: Number: 600,
    show_count: Boolean: false
) {
    state click_count: Number: 0;

    let font_size = size;
    let font_weight = weight;

    let is_primary = variant == "primary";
    let is_secondary = variant == "secondary";
    let is_outline = variant == "outline";
    let is_ghost = variant == "ghost";
    let is_danger = variant == "danger";
    let is_success = variant == "success";

    let bg_color = disabled ? #33415580 : (
        is_primary ? #2563eb : (
            is_secondary ? #334155 : (
                is_outline ? #0f172a : (
                    is_ghost ? #00000000 : (
                        is_danger ? #dc2626 : (
                            is_success ? #16a34a : #2563eb
                        )
                    )
                )
            )
        )
    );

    let text_color = disabled ? #64748b : (
        is_outline ? #38bdf8 : (
            is_ghost ? #94a3b8 : #ffffff
        )
    );

    let border_color = disabled ? #33415540 : (
        is_outline ? #38bdf8 : (
            is_primary ? #3b82f6 : (
                is_secondary ? #475569 : (
                    is_danger ? #ef4444 : (
                        is_success ? #22c55e : #00000000
                    )
                )
            )
        )
    );

    let border_w = is_outline ? 1.5 : (
        is_ghost ? 0 : 1
    );

    let display_label = (show_count && click_count > 0) ? (label + " (" + click_count + ")") : label;
    let measured_label_w = text_width(display_label, font_size, font_weight);
    let resolved_width = max(64, measured_label_w + 32);

    alias right = x + resolved_width;
    alias bottom = y + height;

    \Rect(
        x: x,
        y: y,
        width: resolved_width,
        height: height,
        color: bg_color,
        radius: radius,
        border_color: border_color,
        border_width: border_w,
        on_click: self.click
    ) {
        \Center {
            \Text(
                size: font_size,
                weight: font_weight,
                color: text_color,
                text: display_label
            )
        }
    }
}
