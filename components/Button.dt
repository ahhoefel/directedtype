// DirectedType Standard Component Library: Button
// High-performance declarative button styled by a ButtonStyle bundle.
\use "components/Center.dt"
\use "components/ButtonStyle.dt"

// 1. Explicit / Fixed Width Button: zero text_width measurement needed
\Component Button(
    style: ButtonStyle,
    width: Number,
    label: String,
    x: Number,
    y: Number,
    disabled: Boolean: false,
    show_count: Boolean: false
) {
    state click_count: Number: 0;

    let is_disabled = disabled;
    let bg_color = is_disabled ? style.disabled_bg : style.bg;
    let text_color = is_disabled ? style.disabled_text : style.text_color;
    let border_color = is_disabled ? style.disabled_border_color : style.border_color;

    let display_label = (show_count && click_count > 0) ? (label + " (" + click_count + ")") : label;

    alias right = x + width;
    alias bottom = y + style.height;
    alias height = style.height;

    \Rect(
        x: x,
        y: y,
        width: width,
        height: style.height,
        color: bg_color,
        radius: style.radius,
        border_color: border_color,
        border_width: style.border_width,
        on_click: self.click
    ) {
        \Center {
            \Text(
                size: style.size,
                weight: style.weight,
                color: text_color,
                text: display_label
            )
        }
    }
}

// 2. Intrinsic Text-Sized Button: automatically sizes width based on label measurement
\Component Button(
    style: ButtonStyle,
    label: String,
    x: Number,
    y: Number,
    disabled: Boolean: false,
    show_count: Boolean: false
) {
    state click_count: Number: 0;

    let is_disabled = disabled;
    let bg_color = is_disabled ? style.disabled_bg : style.bg;
    let text_color = is_disabled ? style.disabled_text : style.text_color;
    let border_color = is_disabled ? style.disabled_border_color : style.border_color;

    let display_label = (show_count && click_count > 0) ? (label + " (" + click_count + ")") : label;
    let measured_label_w = text_width(display_label, style.size, style.weight);
    let resolved_width = max(64, measured_label_w + 32);

    alias right = x + resolved_width;
    alias width = resolved_width;
    alias bottom = y + style.height;
    alias height = style.height;

    \Rect(
        x: x,
        y: y,
        width: resolved_width,
        height: style.height,
        color: bg_color,
        radius: style.radius,
        border_color: border_color,
        border_width: style.border_width,
        on_click: self.click
    ) {
        \Center {
            \Text(
                size: style.size,
                weight: style.weight,
                color: text_color,
                text: display_label
            )
        }
    }
}
