// DirectedType Standard Component Library: Center
// Declarative container that centers its single child along both horizontal and vertical axes.
// Anchors the child with minimum left/top alignment when available bounds are smaller than the child,
// and caps width and height on the lower end by the dimensions of its child.

// 1. Explicit Spatial Bounds Center
\Component Center(
    width: Distance,
    height: Distance,
    x: Distance,
    y: Distance
) {
    \assert children.len == 1 as "Should have only one child.";

    \alias right = x + width;
    \alias bottom = y + height;

    \Children(
        x: x + max(0, (width - child.width) / 2),
        y: y + max(0, (height - child.height) / 2)
    )
}

// 2. Explicit Dimensions Center (inherits origin from parent container)
\Component Center(
    width: Distance,
    height: Distance
) {
    \assert children.len == 1 as "Should have only one child.";

    \alias x = parent.left;
    \alias y = parent.top;
    \alias right = parent.left + width;
    \alias bottom = parent.top + height;

    \Children(
        x: x + max(0, (width - child.width) / 2),
        y: y + max(0, (height - child.height) / 2)
    )
}

// 3. Fluid Dimensions Center (explicit origin, fills remaining parent space)
\Component Center(
    x: Distance,
    y: Distance
) {
    \assert children.len == 1 as "Should have only one child.";

    \let available_width = parent.width - (2 * (x - parent.left));
    \let available_height = parent.height - (2 * (y - parent.top));
    \let resolved_width = max(available_width, only(children.width));
    \let resolved_height = max(available_height, only(children.height));

    \alias width = resolved_width;
    \alias height = resolved_height;
    \alias right = x + resolved_width;
    \alias bottom = y + resolved_height;

    \Children(
        x: x + max(0, (available_width - child.width) / 2),
        y: y + max(0, (available_height - child.height) / 2)
    )
}

// 4. Fluid Parent-Fitting Center: automatically fits parent container bounds
\Component Center {
    \assert children.len == 1 as "Should have only one child.";

    \let available_width = parent.width;
    \let available_height = parent.height;
    \let resolved_width = max(available_width, only(children.width));
    \let resolved_height = max(available_height, only(children.height));

    \alias width = resolved_width;
    \alias height = resolved_height;
    \alias x = parent.left;
    \alias y = parent.top;
    \alias right = parent.left + resolved_width;
    \alias bottom = parent.top + resolved_height;

    \Children(
        x: x + max(0, (available_width - child.width) / 2),
        y: y + max(0, (available_height - child.height) / 2)
    )
}
