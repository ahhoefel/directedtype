// DirectedType Standard Component Library: Link
// Declarative hypertext link component for inline typography and standalone navigation
// styled by an environmental LinkStyle bundle with reactive hover and focus styling.

// 1. Comprehensive LinkStyle (explicit normal, hover, and focus styling)
\Component LinkStyle(
    color: Color,
    underline: Boolean,
    bg: Color,
    hover_color: Color,
    hover_underline: Boolean,
    hover_bg: Color,
    focused_color: Color,
    focused_underline: Boolean,
    focused_bg: Color
) {}

// 2. Uniform LinkStyle (derives hover and focus from normal state)
\Component LinkStyle(
    color: Color,
    underline: Boolean,
    bg: Color
) {
    \alias hover_color = color;
    \alias hover_underline = underline;
    \alias hover_bg = bg;
    \alias focused_color = color;
    \alias focused_underline = underline;
    \alias focused_bg = bg;
}

\Span Link(
    url: String,
    env link_style: LinkStyle,
    env font: Font,
    view: ViewPort = window,
    x: Distance = parent.left,
    y: Distance = parent.top,
    cursor: String = "Pointer",
    on_click: Handler = self.click,
    on_focus: Handler = self.focus,
    on_blur: Handler = self.blur,
    on_pointer_enter: Handler = self.pointer_enter,
    on_pointer_leave: Handler = self.pointer_leave
) {
    \state focused: Boolean = false;
    \state hovered: Boolean = false;

    \let active_color = focused ? link_style.focused_color : (hovered ? link_style.hover_color : link_style.color);
    \let active_underline = focused ? link_style.focused_underline : (hovered ? link_style.hover_underline : link_style.underline);
    \let active_bg = focused ? link_style.focused_bg : (hovered ? link_style.hover_bg : link_style.bg);

    \alias color = active_color;
    \alias underline = active_underline;
    \alias bg = active_bg;
    \alias current_color = active_color;
    \alias current_underline = active_underline;
    \alias current_bg = active_bg;

    \Children
}

\Span Link(
    to: Anchor,
    env link_style: LinkStyle = \LinkStyle(color: #1d4ed8, underline: false, bg: #00000000),
    env font: Font,
    view: ViewPort = window,
    x: Distance = parent.left,
    y: Distance = parent.top,
    cursor: String = "Pointer",
    on_click: Handler = self.click,
    on_focus: Handler = self.focus,
    on_blur: Handler = self.blur,
    on_pointer_enter: Handler = self.pointer_enter,
    on_pointer_leave: Handler = self.pointer_leave
) {
    \state focused: Boolean = false;
    \state hovered: Boolean = false;

    \let active_color = focused ? link_style.focused_color : (hovered ? link_style.hover_color : link_style.color);
    \let active_underline = focused ? link_style.focused_underline : (hovered ? link_style.hover_underline : link_style.underline);
    \let active_bg = focused ? link_style.focused_bg : (hovered ? link_style.hover_bg : link_style.bg);

    \alias color = active_color;
    \alias underline = active_underline;
    \alias bg = active_bg;
    \alias current_color = active_color;
    \alias current_underline = active_underline;
    \alias current_bg = active_bg;

    \Children
}

\Span Link(
    to: Anchor,
    text: String,
    env link_style: LinkStyle = \LinkStyle(color: #1d4ed8, underline: false, bg: #00000000),
    env font: Font,
    view: ViewPort = window,
    x: Distance = parent.left,
    y: Distance = parent.top,
    cursor: String = "Pointer",
    on_click: Handler = self.click,
    on_focus: Handler = self.focus,
    on_blur: Handler = self.blur,
    on_pointer_enter: Handler = self.pointer_enter,
    on_pointer_leave: Handler = self.pointer_leave
) {
    \state focused: Boolean = false;
    \state hovered: Boolean = false;

    \let active_color = focused ? link_style.focused_color : (hovered ? link_style.hover_color : link_style.color);
    \let active_underline = focused ? link_style.focused_underline : (hovered ? link_style.hover_underline : link_style.underline);
    \let active_bg = focused ? link_style.focused_bg : (hovered ? link_style.hover_bg : link_style.bg);

    \alias color = active_color;
    \alias underline = active_underline;
    \alias bg = active_bg;
    \alias current_color = active_color;
    \alias current_underline = active_underline;
    \alias current_bg = active_bg;
}
