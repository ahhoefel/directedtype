// DirectedType Standard Component Library: VCenter
// Declarative container that centers its single child vertically within its available height.
// Anchors the child with minimum top alignment when available height is smaller than the child.

// 1. Explicit Height VCenter
\Component VCenter(
    height: Number,
    x: Number: parent.left,
    y: Number: parent.top
) {
    \assert num_children == 1 as "Should have only one child.";

    \alias width = parent.width;
    \alias right = parent.right;
    \alias bottom = y + height;

    \Children {
        x: x,
        y: y + max(0, (height - child.height) / 2)
    }
}

// 2. Fluid Height VCenter with explicit origin
\Component VCenter(
    x: Number,
    y: Number
) {
    \assert num_children == 1 as "Should have only one child.";

    \let resolved_height = parent.height - (2 * (y - parent.top));
    \let resolved_width = parent.width - (2 * (x - parent.left));

    \alias width = resolved_width;
    \alias right = x + resolved_width;
    \alias height = resolved_height;
    \alias bottom = y + resolved_height;

    \Children {
        x: x,
        y: y + max(0, (resolved_height - child.height) / 2)
    }
}

// 3. Fluid Parent-Fitting VCenter with explicit x
\Component VCenter(
    x: Number
) {
    \assert num_children == 1 as "Should have only one child.";

    \let resolved_width = parent.width - (2 * (x - parent.left));

    \alias width = resolved_width;
    \alias right = x + resolved_width;
    \alias height = parent.height;
    \alias y = parent.top;
    \alias bottom = parent.bottom;

    \Children {
        x: x,
        y: parent.top + max(0, (parent.height - child.height) / 2)
    }
}

// 4. Fluid Parent-Fitting VCenter
\Component VCenter {
    \assert num_children == 1 as "Should have only one child.";

    \alias width = parent.width;
    \alias height = parent.height;
    \alias x = parent.left;
    \alias y = parent.top;
    \alias right = parent.right;
    \alias bottom = parent.bottom;

    \Children {
        x: parent.left,
        y: parent.top + max(0, (parent.height - child.height) / 2)
    }
}
