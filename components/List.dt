\use { Align } from "components/Align.dt";

\Enum BulletType {
    Bullet,
    Number,
    Roman,
}

\Component List(x, y, width, inset, item_gap, gap, env font, bullet_type: BulletType: BulletType.Number, bullet: String: "•") {
    \let max_bullet_width = max(children.bullet_width);
    \Children {
        x: x + max(inset, max_bullet_width),
        y: prev ? prev.bottom + gap : y,
        width: width - max(inset, max_bullet_width),
        index: prev ? prev.index + 1 : 1,
        bullet_type,
        bullet,
        font,
        item_gap
    }
    \alias height = sum(children.height) + max(0, children.len - 1) * gap;
}

\Component Item(x,y, width, index: Integer, item_gap, bullet_type: BulletType, bullet: String: "•", env font) {
    \let bullet_node = \Text(
        x: x - bullet_node.width - item_gap,
        y: y,
        align: Align.Right,
        font: font,
        text: bullet_type == BulletType.Number ? ("" + index + ".") : bullet);
    \Children{
        x: x,
        y: y,
        width: width,
    }
    \alias bottom = max(children.bottom);
    \alias height = bottom - y;
    \alias bullet_width = bullet_node.width + item_gap;
}