// DirectedType Standard Component Library: ScrollView
// Container component providing hardware-accelerated clipped scrolling,
// interactive mousewheel/trackpad scrolling, and targeted anchor navigation.

\Component ScrollView(
    width: Distance,
    height: Distance,
    x: Distance = parent.left,
    y: Distance = parent.top,
    padding: Distance = 0,
    radius: Distance = 0,
    bg: Color = #00000000,
    border_color: Color = #00000000,
    border_width: Distance = 0,
    scrollbar_color: Color = #64748b80,
    scrollbar_width: Distance = 6px,
    on_scroll: Handler = self.on_scroll
) {
    \state scroll_y: Distance = 0;
    \state scroll_x: Distance = 0;

    \alias left = x;
    \alias top = y;
    \alias right = x + width;
    \alias bottom = y + height;

    // 1. Background frame & event capture surface
    \Rect(
        x: x,
        y: y,
        width: width,
        height: height,
        color: bg,
        radius: radius,
        border_width: border_width,
        border_color: border_color,
        on_scroll: on_scroll
    )

    // 2. Hardware clip node defining the rectangular or rounded boundary and scroll translation
    \let clip = \Clip(
        up: self.clip,
        box: \Box(
            x: x,
            y: y,
            width: width,
            height: height,
            radius: radius
        ),
        scroll_x: scroll_x,
        scroll_y: scroll_y
    );

    \let content_top = y + padding;
    \let content_left = x + padding;

    // 3. Children inherit the clip context and are positioned statically (decoupled from scroll state)
    \Children {
        clip: clip,
        x: prev ? prev.left : content_left,
        y: prev ? prev.bottom : content_top
    }

    // 4. Dynamic scrollbar
    \let content_bottom = max(children.bottom) + padding;
    \let content_height = max(height, content_bottom - y);
    \let max_scroll_y = max(1px, content_height - height);
    \let has_overflow = content_height > (height + 1px);
    \let track_inset = 4px;
    \let track_height = max(1px, height - (2 * track_inset));
    \let thumb_height = max(24px, min(track_height, track_height * (height / content_height)));
    \let scroll_ratio = min(1, max(0, scroll_y / max_scroll_y));
    \let thumb_y = y + track_inset + scroll_ratio * (track_height - thumb_height);

    \Rect(
        clip: self.clip,
        x: x + width - scrollbar_width - track_inset,
        y: thumb_y,
        width: scrollbar_width,
        height: thumb_height,
        color: has_overflow ? scrollbar_color : #00000000,
        radius: scrollbar_width / 2
    )
}
