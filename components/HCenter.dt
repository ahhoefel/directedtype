// DirectedType Standard Component Library: HCenter
// Declarative container that centers its single child horizontally within its available width,
// taking its off-axis (vertical) height top-down from its parent.
// Anchors the child with minimum left alignment when available width is smaller than the child.
// Caps width on the lower end by the width of its contents.
\use "components/HCenterUp.dt"

// 1. Explicit Width HCenter
\Component HCenter(
    width: Distance,
    x: Distance = parent.left,
    y: Distance = parent.top
) {
    \assert children.len == 1 as "Should have only one child.";

    \alias right = x + width;
    \alias height = parent.height;
    \alias bottom = parent.bottom;

    \Children(
        x: x + max(0, (width - child.width) / 2),
        y: y
    )
}

// 2. Fluid Width HCenter with explicit origin
\Component HCenter(
    x: Distance,
    y: Distance
) {
    \assert children.len == 1 as "Should have only one child.";

    \let available_width = parent.width - (2 * (x - parent.left));
    \let resolved_width = max(available_width, only(children.width));
    \let resolved_height = parent.height - (2 * (y - parent.top));

    \alias width = resolved_width;
    \alias right = x + resolved_width;
    \alias height = resolved_height;
    \alias bottom = y + resolved_height;

    \Children(
        x: x + max(0, (available_width - child.width) / 2),
        y: y
    )
}

// 3. Fluid Parent-Fitting HCenter with explicit y
\Component HCenter(
    y: Distance
) {
    \assert children.len == 1 as "Should have only one child.";

    \let available_width = parent.width;
    \let resolved_width = max(available_width, only(children.width));
    \let resolved_height = parent.height - (2 * (y - parent.top));

    \alias width = resolved_width;
    \alias x = parent.left;
    \alias right = parent.left + resolved_width;
    \alias height = resolved_height;
    \alias bottom = y + resolved_height;

    \Children(
        x: x + max(0, (available_width - child.width) / 2),
        y: y
    )
}

// 4. Fluid Parent-Fitting HCenter
\Component HCenter {
    \assert children.len == 1 as "Should have only one child.";

    \let available_width = parent.width;
    \let resolved_width = max(available_width, only(children.width));

    \alias width = resolved_width;
    \alias x = parent.left;
    \alias y = parent.top;
    \alias right = parent.left + resolved_width;
    \alias height = parent.height;
    \alias bottom = parent.bottom;

    \Children(
        x: x + max(0, (available_width - child.width) / 2),
        y: y
    )
}
