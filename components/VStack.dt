// DirectedType Standard Component Library: VStack
// Vertically stacked flow container with cross-axis alignment and child spacing (gap).
\use "components/Align.dt"

// 1. Explicit / Fixed Width VStack: zero references to parent.width, preventing layout DAG cycles
\Component VStack(
    width: Number,
    x: Number,
    y: Number,
    gap: Number: 0,
    align: Align: Align.Left
) {
    let is_stretch = align == Align.Stretch;
    let is_center = align == Align.Center;
    let is_right = align == Align.Right;

    alias right = x + width;
    alias bottom = max(children.bottom) > 0 ? max(children.bottom) : y;
    alias height = bottom - y;

    \Children {
        x: is_center ? (x + (width - child.width) / 2) : (
            is_right ? (x + width - child.width) : (
                x
            )
        ),
        y: prev ? prev.bottom + gap : y,
        width: is_stretch ? width : auto,
        text_align: align
    }
}

// 2. Fluid / Parent-Filling VStack: automatically spans parent width
\Component VStack(
    x: Number,
    y: Number,
    gap: Number: 0,
    align: Align: Align.Left
) {
    let resolved_width = parent.width - (2 * x);

    let is_stretch = align == Align.Stretch;
    let is_center = align == Align.Center;
    let is_right = align == Align.Right;

    alias right = x + resolved_width;
    alias width = resolved_width;
    alias bottom = max(children.bottom) > 0 ? max(children.bottom) : y;
    alias height = bottom - y;

    \Children {
        x: is_center ? (x + (resolved_width - child.width) / 2) : (
            is_right ? (x + resolved_width - child.width) : (
                x
            )
        ),
        y: prev ? prev.bottom + gap : y,
        width: is_stretch ? resolved_width : auto,
        text_align: align
    }
}
