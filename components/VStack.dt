// DirectedType Standard Component Library: VStack
// Vertically stacked flow container with cross-axis alignment and child spacing (gap).
\use "components/Align.dt"

// 1. Explicit Fixed Width & Fixed Height VStack: supports explicit bounds in both dimensions
\Component VStack(
    width: Distance,
    height: Distance,
    x: Distance = parent.left,
    y: Distance = parent.top,
    gap: Distance = 0,
    align: Align = Align.Left
) {
    \let is_center = align == Align.Center;
    \let is_right = align == Align.Right;

    \alias right = x + width;
    \alias bottom = y + height;

    \Children(
        x: is_center ? (x + (width - child.width) / 2) : (
            is_right ? (x + width - child.width) : (
                x
            )
        ),
        y: prev ? prev.bottom + gap : y
    )
}

// 2. Explicit Fixed Width & Intrinsic Height VStack: zero references to parent.width
\Component VStack(
    width: Distance,
    x: Distance = parent.left,
    y: Distance = parent.top,
    gap: Distance = 0,
    align: Align = Align.Left
) {
    \let is_center = align == Align.Center;
    \let is_right = align == Align.Right;

    \alias right = x + width;
    \alias height = sum(children.height) + max(0, children.len - 1) * gap;
    \alias bottom = y + height;

    \Children(
        x: is_center ? (x + (width - child.width) / 2) : (
            is_right ? (x + width - child.width) : (
                x
            )
        ),
        y: prev ? prev.bottom + gap : y
    )
}

// 3. Intrinsic / Content-Fitting Width VStack: wraps width to widest child (or min_width)
\Component VStack(
    x: Distance = parent.left,
    y: Distance = parent.top,
    min_width: Distance = 0,
    gap: Distance = 0,
    align: Align = Align.Left
) {
    \alias max_child_width: Distance = max(children.width);
    \let content_width: Distance = max_child_width > 0 ? max_child_width : 0;
    \let resolved_width: Distance = max(min_width, content_width);
    \let is_center = align == Align.Center;
    \let is_right = align == Align.Right;

    \alias width: Distance = resolved_width;
    \alias right: Distance = x + width;
    \alias height: Distance = sum(children.height) + max(0, children.len - 1) * gap;
    \alias bottom: Distance = y + height;

    \Children(
        x: is_center ? (x + (resolved_width - child.width) / 2) : (
            is_right ? (x + resolved_width - child.width) : (
                x
            )
        ),
        y: prev ? prev.bottom + gap : y
    )
}


