// DirectedType Standard Component Library: VStack
// Vertically stacked flow container with cross-axis alignment and child spacing (gap).
\use "components/Align.dt"

\Component VStack(
    x: Distance = parent.left,
    y: Distance = parent.top,
    min_width: Distance = 0,
    min_height: Distance = 0,
    gap: Distance = 0,
    align: Align = Align.Left,
    width: Distance = max(min_width, max(children.width)),
    height: Distance = max(min_height, sum(children.height) + max(0, children.len - 1) * gap)
) {
    \let is_center = align == Align.Center;
    \let is_right = align == Align.Right;

    \alias right: Distance = x + width;
    \alias bottom: Distance = y + height;

    \Children(
        x: is_center ? (x + (width - child.width) / 2) : (
            is_right ? (x + width - child.width) : (
                x
            )
        ),
        y: prev ? prev.bottom + gap : y
    )
}
