// DirectedType Standard Component Library: Link
// Declarative hypertext link component for inline typography and standalone navigation
// styled by an environmental LinkStyle bundle with reactive hover and focus styling.
\use "components/LinkStyle.dt"

\Component Link(
    url: String,
    env link_style: LinkStyle,
    cursor: String: "Pointer",
    on_click = self.click,
    on_focus = self.focus,
    on_blur = self.blur,
    on_pointer_enter = self.pointer_enter,
    on_pointer_leave = self.pointer_leave
) {
    state focused: Boolean = false;
    state hovered: Boolean = false;

    let active_color = focused ? link_style.focused_color : (hovered ? link_style.hover_color : link_style.color);
    let active_underline = focused ? link_style.focused_underline : (hovered ? link_style.hover_underline : link_style.underline);
    let active_bg = focused ? link_style.focused_bg : (hovered ? link_style.hover_bg : link_style.bg);

    alias current_color = active_color;
    alias current_underline = active_underline;
    alias current_bg = active_bg;

    \Text(
        color: active_color,
        underline: active_underline,
        on_click: on_click,
        on_focus: on_focus,
        on_blur: on_blur,
        on_pointer_enter: on_pointer_enter,
        on_pointer_leave: on_pointer_leave
    ) {
        \children
    }
}
