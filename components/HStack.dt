// DirectedType Standard Component Library: HStack
// Horizontally stacked flow container with cross-axis alignment and child spacing (gap).

// 1. Explicit / Fixed Width HStack: specifies width directly
\Component HStack(
    width: Number,
    x: Number,
    y: Number,
    gap: Number: 0,
    align: String: "top"
) {
    let is_center = align == "center" || align == "centered";
    let is_bottom = align == "bottom";

    alias max_child_height = max(children.height);
    alias right = x + width;
    alias bottom = max(children.bottom) > 0 ? max(children.bottom) : y;
    alias height = bottom - y;

    \Children {
        x: prev ? prev.right + gap : x,
        y: is_center ? (y + (parent.max_child_height - child.height) / 2) : (
            is_bottom ? (y + parent.max_child_height - child.height) : (
                y
            )
        )
    }
}

// 2. Intrinsic / Content-Wrapping HStack: automatically sizes width to wrap children
\Component HStack(
    x: Number,
    y: Number,
    gap: Number: 0,
    align: String: "top"
) {
    let is_center = align == "center" || align == "centered";
    let is_bottom = align == "bottom";

    alias max_child_height = max(children.height);
    alias right = max(children.right) > 0 ? max(children.right) : x;
    alias width = right - x;
    alias bottom = max(children.bottom) > 0 ? max(children.bottom) : y;
    alias height = bottom - y;

    \Children {
        x: prev ? prev.right + gap : x,
        y: is_center ? (y + (parent.max_child_height - child.height) / 2) : (
            is_bottom ? (y + parent.max_child_height - child.height) : (
                y
            )
        )
    }
}
