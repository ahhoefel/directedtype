// DirectedType Standard Component Library: Slider
// Horizontal slider component with interactive track, active fill, draggable thumb, and typed callback.

\Component Slider(
    x: Distance = 0,
    y: Distance = 0,
    width: Distance = 200px,
    height: Distance = 24px,
    min: Float = 0,
    max: Float = 100,
    value: Float = 0,
    track_height: Distance = 6px,
    thumb_size: Distance = 18px,
    track_color: Color = #334155,
    fill_color: Color = #3b82f6,
    thumb_color: Color = #ffffff,
    on_change: Handler = unset
) {
    \state current_value: Float = 0;

    // Inactive track background
    \Rect(
        x: x,
        y: y + (height - track_height) / 2,
        width: width,
        height: track_height,
        radius: track_height / 2,
        color: track_color
    )

    // Active fill track
    \Rect(
        x: x,
        y: y + (height - track_height) / 2,
        width: max(0, min(width, (current_value - min) / max(1, max - min) * (width - thumb_size) + thumb_size / 2)),
        height: track_height,
        radius: track_height / 2,
        color: fill_color
    )

    // Draggable thumb knob
    \Rect(
        x: x + max(0, min(width - thumb_size, (current_value - min) / max(1, max - min) * (width - thumb_size))),
        y: y + (height - thumb_size) / 2,
        width: thumb_size,
        height: thumb_size,
        radius: thumb_size / 2,
        color: thumb_color
    )

    // Full interactive hit area covering slider bounds
    \Rect(
        x: x,
        y: y,
        width: width,
        height: height,
        color: #00000000,
        on_pointer_down: on_pointer_down,
        on_pointer_move: on_pointer_move,
        on_pointer_up: on_pointer_up
    )
}
