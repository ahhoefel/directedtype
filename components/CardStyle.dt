// DirectedType Standard Component Library: CardStyle
// Styling bundle defining visual surface appearance and padding for Card components.

// 1. Uniform Padding CardStyle
\Component CardStyle(
    bg: Color,
    border_color: Color,
    border_width: Distance,
    radius: Distance,
    padding: Distance
) {
    \alias padding_x = padding;
    \alias padding_y = padding;
}

// 2. Asymmetric Padding CardStyle
\Component CardStyle(
    bg: Color,
    border_color: Color,
    border_width: Distance,
    radius: Distance,
    padding_x: Distance,
    padding_y: Distance
) {
    \alias padding = padding_y;
}
