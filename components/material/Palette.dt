// DirectedType Material UI Component Library: Palette
// Standard @mui/material color palette tokens, semantic color enum, and ColorChannel bundles.

\Enum MaterialColor {
    Primary,
    Secondary,
    Success,
    Error,
    Info,
    Warning,
    Inherit,
}

\Component ColorChannel(
    main: Color,
    light: Color,
    dark: Color,
    contrast_text: Color,
    hover_bg: Color,
    focus_bg: Color,
    active_bg: Color,
    outlined_border: Color
) {}

// Standard @mui/material Light Theme Color Channels
\let material_primary = \ColorChannel(
    main: #1976d2,
    light: #42a5f5,
    dark: #1565c0,
    contrast_text: #ffffff,
    hover_bg: #1976d20a,
    focus_bg: #1976d21f,
    active_bg: #1976d229,
    outlined_border: #1976d280
);

