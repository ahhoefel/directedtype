// DirectedType Material UI Component Library: Checkbox
// Selection control (\Checkbox) supporting Small (34x34 halo / 16x16 box) and Medium (42x42 halo / 18x18 box) sizes,
// unchecked/checked/indeterminate states, semantic MaterialColor channels, reactive hover/focus/pressed circular halos,
// disabled state, on_change(bool) callback emission, and standalone, `label: String`, or child text overloads.
// Reference: https://github.com/mui/material-ui/tree/master/packages/mui-material/src/Checkbox

\use "components/material/Palette.dt"

\Enum CheckboxSize {
    Small,
    Medium,
}

// 1. Checkbox with `label` prop (`\Checkbox(label: "Accept terms", checked: true)`)
\Component Checkbox(
    label: String,
    env font: Font = \Font(size: 16px),
    checked: Boolean = false,
    indeterminate: Boolean = false,
    disabled: Boolean = false,
    controlled: Boolean = false,
    color: MaterialColor = MaterialColor.Primary,
    size: CheckboxSize = CheckboxSize.Medium,
    label_gap: Distance = 2px,
    x: Distance = parent.left,
    y: Distance = parent.top,
    on_change: Handler = unset,
    on_click: Handler = self.click,
    on_focus: Handler = disabled ? unset : self.focus,
    on_blur: Handler = self.blur,
    on_pointer_enter: Handler = self.pointer_enter,
    on_pointer_leave: Handler = self.pointer_leave,
    on_pointer_down: Handler = self.pointer_down,
    on_pointer_up: Handler = self.pointer_up
) {
    \state is_checked: Boolean = checked;
    \state is_indeterminate: Boolean = indeterminate;
    \state hovered: Boolean = false;
    \state focused: Boolean = false;
    \state pressed: Boolean = false;

    \let on_click: Handler = disabled ? self.click : self.on_click;

    \let is_small = size == CheckboxSize.Small;

    \let control_size: Distance = is_small ? 34px : 42px;
    \let box_size: Distance = is_small ? 16px : 18px;
    \let box_inset: Distance = (control_size - box_size) / 2;

    \env font = \Font(
        font: self.font,
        size: is_small ? 14px : 16px,
        weight: 400,
        line_height: is_small ? 20px : 24px
    );

    \let is_primary = color == MaterialColor.Primary;
    \let is_secondary = color == MaterialColor.Secondary;
    \let is_success = color == MaterialColor.Success;
    \let is_error = color == MaterialColor.Error;
    \let is_info = color == MaterialColor.Info;
    \let is_warning = color == MaterialColor.Warning;

    \let ch_main = is_primary ? #1976d2 : (
        is_secondary ? #9c27b0 : (
            is_success ? #2e7d32 : (
                is_error ? #d32f2f : (
                    is_info ? #0288d1 : (
                        is_warning ? #ed6c02 : #212121
                    )
                )
            )
        )
    );

    \let ch_hover_bg = is_primary ? #1976d20a : (
        is_secondary ? #9c27b00a : (
            is_success ? #2e7d320a : (
                is_error ? #d32f2f0a : (
                    is_info ? #0288d10a : (
                        is_warning ? #ed6c020a : #0000000a
                    )
                )
            )
        )
    );

    \let ch_focus_bg = is_primary ? #1976d21f : (
        is_secondary ? #9c27b01f : (
            is_success ? #2e7d321f : (
                is_error ? #d32f2f1f : (
                    is_info ? #0288d11f : (
                        is_warning ? #ed6c021f : #0000001f
                    )
                )
            )
        )
    );

    \let ch_active_bg = is_primary ? #1976d229 : (
        is_secondary ? #9c27b029 : (
            is_success ? #2e7d3229 : (
                is_error ? #d32f2f29 : (
                    is_info ? #0288d129 : (
                        is_warning ? #ed6c0229 : #00000029
                    )
                )
            )
        )
    );

    \let is_filled = is_checked || is_indeterminate;
    \let show_check = is_checked && !is_indeterminate;
    \let show_dash = is_indeterminate;

    \let halo_color = disabled
        ? #00000000
        : (pressed
            ? (is_filled ? ch_active_bg : #00000029)
            : (focused
                ? (is_filled ? ch_focus_bg : #0000001f)
                : (hovered
                    ? (is_filled ? ch_hover_bg : #0000000a)
                    : #00000000)));

    \let box_bg = is_filled
        ? (disabled ? #00000042 : ch_main)
        : #00000000;

    \let box_border_color = is_filled
        ? #00000000
        : (disabled ? #00000042 : #00000099);

    \let box_border_w: Distance = is_filled ? 0px : 2px;

    \let has_label = label != "";
    \let eff_gap: Distance = has_label ? label_gap : 0px;
    \let label_w: Distance = has_label ? checkbox_label.width : 0px;
    \let resolved_w: Distance = control_size + eff_gap + label_w;
    \let resolved_h: Distance = has_label ? max(control_size, checkbox_label.height) : control_size;
    \let control_y: Distance = y + (resolved_h - control_size) / 2;

    \let box_x: Distance = x + box_inset;
    \let box_y: Distance = control_y + box_inset;

    \let label_color = disabled ? #00000061 : #000000de;

    \alias width = resolved_w;
    \alias height = resolved_h;
    \alias right = x + resolved_w;
    \alias bottom = y + resolved_h;

    \let hit_area = \Rect(
        x: x,
        y: y,
        width: resolved_w,
        height: resolved_h,
        color: #00000000
    );

    \let halo = \Rect(
        x: x,
        y: control_y,
        width: control_size,
        height: control_size,
        radius: control_size / 2,
        color: halo_color
    );

    \let box_rect = \Rect(
        x: box_x,
        y: box_y,
        width: box_size,
        height: box_size,
        radius: 2px,
        color: box_bg,
        border_color: box_border_color,
        border_width: box_border_w
    );

    \let check_short = \Line(
        x1: box_x + box_size * 0.22,
        y1: box_y + box_size * 0.52,
        x2: box_x + box_size * 0.42,
        y2: box_y + box_size * 0.72,
        thickness: show_check ? 2px : 0px,
        cap: LineCap.Round,
        color: show_check ? #ffffff : #00000000
    );

    \let check_long = \Line(
        x1: box_x + box_size * 0.42,
        y1: box_y + box_size * 0.72,
        x2: box_x + box_size * 0.78,
        y2: box_y + box_size * 0.28,
        thickness: show_check ? 2px : 0px,
        cap: LineCap.Round,
        color: show_check ? #ffffff : #00000000
    );

    \let dash_rect = \Rect(
        x: box_x + 3px,
        y: box_y + (box_size - 2px) / 2,
        width: box_size - 6px,
        height: 2px,
        radius: 1px,
        color: show_dash ? #ffffff : #00000000
    );

    \let checkbox_label = \Text(
        x: x + control_size + eff_gap,
        y: y + max(0px, (resolved_h - checkbox_label.height) / 2),
        font: env.font,
        color: has_label ? label_color : #00000000,
        text: label
    );
}

// 2. Standalone Checkbox or Checkbox with child text content (`\Checkbox(checked: true)` or `\Checkbox(checked: true) { Accept terms }`)
\Component Checkbox(
    env font: Font = \Font(size: 16px),
    checked: Boolean = false,
    indeterminate: Boolean = false,
    disabled: Boolean = false,
    controlled: Boolean = false,
    color: MaterialColor = MaterialColor.Primary,
    size: CheckboxSize = CheckboxSize.Medium,
    label_gap: Distance = 2px,
    x: Distance = parent.left,
    y: Distance = parent.top,
    on_change: Handler = unset,
    on_click: Handler = self.click,
    on_focus: Handler = disabled ? unset : self.focus,
    on_blur: Handler = self.blur,
    on_pointer_enter: Handler = self.pointer_enter,
    on_pointer_leave: Handler = self.pointer_leave,
    on_pointer_down: Handler = self.pointer_down,
    on_pointer_up: Handler = self.pointer_up
) {
    \state is_checked: Boolean = checked;
    \state is_indeterminate: Boolean = indeterminate;
    \state hovered: Boolean = false;
    \state focused: Boolean = false;
    \state pressed: Boolean = false;

    \let on_click: Handler = disabled ? self.click : self.on_click;

    \let is_small = size == CheckboxSize.Small;

    \let control_size: Distance = is_small ? 34px : 42px;
    \let box_size: Distance = is_small ? 16px : 18px;
    \let box_inset: Distance = (control_size - box_size) / 2;

    \env font = \Font(
        font: self.font,
        size: is_small ? 14px : 16px,
        weight: 400,
        line_height: is_small ? 20px : 24px
    );

    \let is_primary = color == MaterialColor.Primary;
    \let is_secondary = color == MaterialColor.Secondary;
    \let is_success = color == MaterialColor.Success;
    \let is_error = color == MaterialColor.Error;
    \let is_info = color == MaterialColor.Info;
    \let is_warning = color == MaterialColor.Warning;

    \let ch_main = is_primary ? #1976d2 : (
        is_secondary ? #9c27b0 : (
            is_success ? #2e7d32 : (
                is_error ? #d32f2f : (
                    is_info ? #0288d1 : (
                        is_warning ? #ed6c02 : #212121
                    )
                )
            )
        )
    );

    \let ch_hover_bg = is_primary ? #1976d20a : (
        is_secondary ? #9c27b00a : (
            is_success ? #2e7d320a : (
                is_error ? #d32f2f0a : (
                    is_info ? #0288d10a : (
                        is_warning ? #ed6c020a : #0000000a
                    )
                )
            )
        )
    );

    \let ch_focus_bg = is_primary ? #1976d21f : (
        is_secondary ? #9c27b01f : (
            is_success ? #2e7d321f : (
                is_error ? #d32f2f1f : (
                    is_info ? #0288d11f : (
                        is_warning ? #ed6c021f : #0000001f
                    )
                )
            )
        )
    );

    \let ch_active_bg = is_primary ? #1976d229 : (
        is_secondary ? #9c27b029 : (
            is_success ? #2e7d3229 : (
                is_error ? #d32f2f29 : (
                    is_info ? #0288d129 : (
                        is_warning ? #ed6c0229 : #00000029
                    )
                )
            )
        )
    );

    \let is_filled = is_checked || is_indeterminate;
    \let show_check = is_checked && !is_indeterminate;
    \let show_dash = is_indeterminate;

    \let halo_color = disabled
        ? #00000000
        : (pressed
            ? (is_filled ? ch_active_bg : #00000029)
            : (focused
                ? (is_filled ? ch_focus_bg : #0000001f)
                : (hovered
                    ? (is_filled ? ch_hover_bg : #0000000a)
                    : #00000000)));

    \let box_bg = is_filled
        ? (disabled ? #00000042 : ch_main)
        : #00000000;

    \let box_border_color = is_filled
        ? #00000000
        : (disabled ? #00000042 : #00000099);

    \let box_border_w: Distance = is_filled ? 0px : 2px;

    \assert children.len <= 1 as "Checkbox accepts at most one label child.";

    \let has_label = children.len > 0;
    \let eff_gap: Distance = has_label ? label_gap : 0px;
    \let label_w: Distance = has_label ? max(children.width) : 0px;
    \let label_h: Distance = has_label ? max(children.height) : 0px;
    \let resolved_w: Distance = control_size + eff_gap + label_w;
    \let resolved_h: Distance = has_label ? max(control_size, label_h) : control_size;
    \let control_y: Distance = y + (resolved_h - control_size) / 2;

    \let box_x: Distance = x + box_inset;
    \let box_y: Distance = control_y + box_inset;

    \let label_color = disabled ? #00000061 : #000000de;

    \alias width = resolved_w;
    \alias height = resolved_h;
    \alias right = x + resolved_w;
    \alias bottom = y + resolved_h;

    \let hit_area = \Rect(
        x: x,
        y: y,
        width: resolved_w,
        height: resolved_h,
        color: #00000000
    );

    \let halo = \Rect(
        x: x,
        y: control_y,
        width: control_size,
        height: control_size,
        radius: control_size / 2,
        color: halo_color
    );

    \let box_rect = \Rect(
        x: box_x,
        y: box_y,
        width: box_size,
        height: box_size,
        radius: 2px,
        color: box_bg,
        border_color: box_border_color,
        border_width: box_border_w
    );

    \let check_short = \Line(
        x1: box_x + box_size * 0.22,
        y1: box_y + box_size * 0.52,
        x2: box_x + box_size * 0.42,
        y2: box_y + box_size * 0.72,
        thickness: show_check ? 2px : 0px,
        cap: LineCap.Round,
        color: show_check ? #ffffff : #00000000
    );

    \let check_long = \Line(
        x1: box_x + box_size * 0.42,
        y1: box_y + box_size * 0.72,
        x2: box_x + box_size * 0.78,
        y2: box_y + box_size * 0.28,
        thickness: show_check ? 2px : 0px,
        cap: LineCap.Round,
        color: show_check ? #ffffff : #00000000
    );

    \let dash_rect = \Rect(
        x: box_x + 3px,
        y: box_y + (box_size - 2px) / 2,
        width: box_size - 6px,
        height: 2px,
        radius: 1px,
        color: show_dash ? #ffffff : #00000000
    );

    \Children(
        x: x + control_size + eff_gap,
        y: y + max(0px, (resolved_h - child.height) / 2),
        color: label_color
    )
}
