// DirectedType Material UI Component Library: Typography
// Reimplementation of @mui/material Typography with the 13-role Material Design type scale,
// reusable \Font tokens, \Typography component, and semantic shorthand components (\H1-\H6,
// \Subtitle1, \Subtitle2, \Body1, \Body2, \Caption, \Overline).

\use "components/Align.dt"
\use "components/TextBounds.dt"
\use "components/material/Palette.dt"

\let material_text_bounds = \TextBounds(
    start_at: TextStart.LineHeight,
    end_at: TextEnd.LineHeight
);

\Enum TypographyVariant {
    H1,
    H2,
    H3,
    H4,
    H5,
    H6,
    Subtitle1,
    Subtitle2,
    Body1,
    Body2,
    Button,
    Caption,
    Overline,
}

// Standard @mui/material Type Scale Font Tokens
\let material_font_h1 = \Font(size: 96px, weight: 300, line_height: 112px);
\let material_font_h2 = \Font(size: 60px, weight: 300, line_height: 72px);
\let material_font_h3 = \Font(size: 48px, weight: 400, line_height: 56px);
\let material_font_h4 = \Font(size: 34px, weight: 400, line_height: 42px);
\let material_font_h5 = \Font(size: 24px, weight: 400, line_height: 32px);
\let material_font_h6 = \Font(size: 20px, weight: 500, line_height: 32px);
\let material_font_subtitle1 = \Font(size: 16px, weight: 400, line_height: 28px);
\let material_font_subtitle2 = \Font(size: 14px, weight: 500, line_height: 22px);
\let material_font_body1 = \Font(size: 16px, weight: 400, line_height: 24px);
\let material_font_body2 = \Font(size: 14px, weight: 400, line_height: 20px);
\let material_font_button = \Font(size: 14px, weight: 500, line_height: 24px);
\let material_font_caption = \Font(size: 12px, weight: 400, line_height: 20px);
\let material_font_overline = \Font(size: 12px, weight: 400, line_height: 32px);

// Reusable \Expr definitions for mapping TypographyVariant -> (size, weight, line_height)
// across all Typography component overloads.
\let typography_variant_size: Expr = \Expr(v: TypographyVariant) {
    match v {
        H1 => 96px,
        H2 => 60px,
        H3 => 48px,
        H4 => 34px,
        H5 => 24px,
        H6 => 20px,
        Subtitle1 | Body1 => 16px,
        Subtitle2 | Body2 | Button => 14px,
        Caption | Overline => 12px,
    }
};

\let typography_variant_weight: Expr = \Expr(v: TypographyVariant) {
    match v {
        H1 | H2 => 300,
        H6 | Subtitle2 | Button => 500,
        _ => 400,
    }
};

\let typography_variant_line_height: Expr = \Expr(v: TypographyVariant) {
    match v {
        H1 => 112px,
        H2 => 72px,
        H3 => 56px,
        H4 => 42px,
        H5 | H6 | Overline => 32px,
        Subtitle1 => 28px,
        Subtitle2 => 22px,
        Body1 | Button => 24px,
        Body2 | Caption => 20px,
    }
};

// 1. Explicit Width Typography (Wrapping or Aligned within Container)
\Component Typography(
    width: Distance,
    env font: Font = \Font(size: 16px),
    variant: TypographyVariant = TypographyVariant.Body1,
    color: Color = #000000de,
    align: Align = Align.Left,
    gutter_bottom: Boolean = false,
    x: Distance = parent.left,
    y: Distance = parent.top
) {
    \let v_size = typography_variant_size(variant);
    \let v_weight = typography_variant_weight(variant);
    \let v_line_height = typography_variant_line_height(variant);

    \env font = \Font(
        font: self.font,
        size: v_size,
        weight: v_weight,
        line_height: v_line_height
    );

    \let t = \Text(
        x: x,
        y: y,
        width: width,
        font: env.font,
        color: color,
        align: align,
        text_bounds: material_text_bounds
    ) {
        \Children
    };

    \let gutter = gutter_bottom ? (v_size * 0.35) : 0px;

    \alias right = x + width;
    \alias height = t.height + gutter;
    \alias bottom = y + height;
    \alias baseline = t.baseline;
}

// 2. Intrinsic Width Typography (Single-Line Auto-Sized to Content)
\Component Typography(
    env font: Font = \Font(size: 16px),
    variant: TypographyVariant = TypographyVariant.Body1,
    color: Color = #000000de,
    align: Align = Align.Left,
    gutter_bottom: Boolean = false,
    x: Distance = parent.left,
    y: Distance = parent.top
) {
    \let v_size = typography_variant_size(variant);
    \let v_weight = typography_variant_weight(variant);
    \let v_line_height = typography_variant_line_height(variant);

    \env font = \Font(
        font: self.font,
        size: v_size,
        weight: v_weight,
        line_height: v_line_height
    );

    \let t = \Text(
        x: x,
        y: y,
        font: env.font,
        color: color,
        align: align,
        text_bounds: material_text_bounds
    ) {
        \Children
    };

    \let gutter = gutter_bottom ? (v_size * 0.35) : 0px;

    \alias width = t.width;
    \alias right = x + width;
    \alias height = t.height + gutter;
    \alias bottom = y + height;
    \alias baseline = t.baseline;
}

