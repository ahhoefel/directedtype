    x: Distance = parent.left,
    y: Distance = parent.top
) {
    \env font = self.font;
    \let t = \Typography(
        x: x,
        y: y,
        width: width,
        variant: TypographyVariant.H1,
        color: color,
        align: align,
        gutter_bottom: gutter_bottom
    ) {
        \Children
    };
    \alias right = x + width;
    \alias height = t.height;
    \alias bottom = y + height;
    \alias baseline = t.baseline;
