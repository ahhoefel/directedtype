// DirectedType Standard Component Library Demo: Button & Card
// Showcases interactive variants, intrinsic text-metric sizing, and ambient Card surfaces.

\use "../components/VStack.dt"
\use "../components/HStack.dt"
\use "../components/Card.dt"
\use "../components/Button.dt"

// Background Canvas
\Rect(
    x: 0,
    y: 0,
    width: window.width,
    height: window.height,
    color: #0f172a
)

// Header Section
\Text(
    x: 40,
    y: 36,
    size: 26,
    weight: 700,
    color: #f8fafc,
    text: "DirectedType Component Library"
)

\Text(
    x: 40,
    y: 72,
    size: 15,
    weight: 400,
    color: #94a3b8,
    text: "Standard \\Card and \\Button with intrinsic typography sizing, 6 variants, and direct text support."
)

// Vertical stack of cards with automatic spacing and stretch alignment
\VStack(
    x: 40,
    y: 110,
    width: min(window.width - 80, 720),
    gap: 14,
    align: "stretch"
) {
    // Section 1: Visual Variants
    \Card("card_variants"; padding_x: 20, padding_y: 16) {
        \Text(size: 13, weight: 700, color: #94a3b8) { 1. DESIGN VARIANTS (AUTO-SIZED) }
        \HStack(gap: 12) {
            \Button("btn_primary"; label: "Primary", variant: "primary")
            \Button("btn_secondary"; label: "Secondary", variant: "secondary")
            \Button("btn_outline"; label: "Outline", variant: "outline")
            \Button("btn_ghost"; label: "Ghost", variant: "ghost")
            \Button("btn_danger"; label: "Danger", variant: "danger")
            \Button("btn_success"; label: "Success", variant: "success")
        }
    }

    // Section 2: Dynamic Intrinsic Sizing vs Fixed Width
    \Card("card_sizing"; padding_x: 20, padding_y: 16) {
        \Text(size: 13, weight: 700, color: #94a3b8) { 2. INTRINSIC TEXT METRIC SIZING VS FIXED OVERRIDE }
        \HStack(gap: 12) {
            \Button("btn_short"; label: "OK")
            \Button("btn_medium"; label: "Save Changes", variant: "secondary")
            \Button("btn_wide"; label: "Export Diagnostics Report", variant: "outline")
            \Button("btn_fixed"; width: 200, label: "Fixed Width (200px)", variant: "primary")
        }
    }

    // Section 3: Interactive & Disabled States
    \Card("card_interactive"; padding_x: 20, padding_y: 16) {
        \Text(size: 13, weight: 700, color: #94a3b8) { 3. INTERACTIVE COUNTER & DISABLED EVENT SUPPRESSION }
        \HStack(gap: 16) {
            \Button("btn_active"; label: "Click To Test Tracking", show_count: true, variant: "primary")
            \Button("btn_disabled"; label: "Disabled Button (Suppressed)", show_count: true, disabled: true)
        }

        \Text(
            size: 13,
            weight: 500,
            color: #64748b,
            text: "Clicking 'Click To Test Tracking' dynamically updates its reactive count badge; the disabled button suppresses clicks."
        )
    }

    // Section 4: Direct Text in Card (Auto-Wrapping Height)
    \Card("card_direct_text"; padding_x: 20, padding_y: 14) {
        Direct text passed straight to Card with auto-wrapping height!
    }
}

