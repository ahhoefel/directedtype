// DirectedType Standard Component Library Demo: Button
// Showcases interactive variants, intrinsic text-metric sizing, and companion state.

\use "../components/Button.dt"

\Component Card(
    x: 40,
    y: 0,
    width: min(window.width - 80, 720),
    height: 150,
    title: String: ""
) {
    \Rect(
        x: x,
        y: y,
        width: width,
        height: height,
        color: #1e293b,
        radius: 12,
        border_color: #334155,
        border_width: 1
    )
    \Text(
        x: x + 20,
        y: y + 16,
        size: 14,
        weight: 700,
        color: #94a3b8,
        text: self.title
    )
    \Children {
        y: parent.top + 52
    }
}

// Background Canvas
\Rect(
    x: 0,
    y: 0,
    width: window.width,
    height: window.height,
    color: #0f172a
)

// Header Section
\Text(
    x: 40,
    y: 36,
    size: 26,
    weight: 700,
    color: #f8fafc,
    text: "DirectedType Component Library"
)

\Text(
    x: 40,
    y: 72,
    size: 15,
    weight: 400,
    color: #94a3b8,
    text: "Standard \\Button with intrinsic typography sizing, 6 design variants, and companion state."
)

// Section 1: Visual Variants
\Card("card_variants"; y: 110, height: 120, title: "1. DESIGN VARIANTS (AUTO-SIZED)") {
    \Button("btn_primary"; x: parent.left + 20, label: "Primary", variant: "primary")
    \Button("btn_secondary"; x: prev.right + 12, label: "Secondary", variant: "secondary")
    \Button("btn_outline"; x: prev.right + 12, label: "Outline", variant: "outline")
    \Button("btn_ghost"; x: prev.right + 12, label: "Ghost", variant: "ghost")
    \Button("btn_danger"; x: prev.right + 12, label: "Danger", variant: "danger")
    \Button("btn_success"; x: prev.right + 12, label: "Success", variant: "success")
}

// Section 2: Dynamic Intrinsic Sizing vs Fixed Width
\Card("card_sizing"; y: 250, height: 120, title: "2. INTRINSIC TEXT METRIC SIZING VS FIXED OVERRIDE") {
    \Button("btn_short"; x: parent.left + 20, label: "OK")
    \Button("btn_medium"; x: prev.right + 12, label: "Save Changes", variant: "secondary")
    \Button("btn_wide"; x: prev.right + 12, label: "Export Diagnostics Report", variant: "outline")
    \Button("btn_fixed"; x: prev.right + 12, width: 200, label: "Fixed Width (200px)", variant: "primary")
}

// Section 3: Interactive & Disabled States
\Card("card_interactive"; y: 390, height: 130, title: "3. INTERACTIVE COUNTER & DISABLED EVENT SUPPRESSION") {
    \Button("btn_active"; x: parent.left + 20, label: "Click To Test Tracking", show_count: true, variant: "primary")
    \Button("btn_disabled"; x: prev.right + 16, label: "Disabled Button (Suppressed)", show_count: true, disabled: true)

    \Text(
        x: parent.left + 20,
        y: prev.bottom + 14,
        size: 13,
        weight: 500,
        color: #64748b,
        text: "Clicking 'Click To Test Tracking' dynamically updates its reactive count badge; the disabled button suppresses clicks."
    )
}
