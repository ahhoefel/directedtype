// DirectedType Standard Component Library Demo: Button & Card
// Showcases interactive variants, intrinsic text-metric sizing, and ambient Card surfaces.

\use "../components/VStack.dt"
\use "../components/HStack.dt"
\use "../components/Card.dt"
\use "../components/Button.dt"
\use "../components/ButtonVariant.dt"
\use "../components/Divider.dt"
\use "../components/Spacer.dt"
\use "../theme/default.dt"

// Background Canvas
\Rect(
    x: 0,
    y: 0,
    width: window.width,
    height: window.height,
    color: #0f172a
)

// Main Page Layout
\VStack(
    x: 40,
    y: 36,
    width: min(window.width - 80, 720),
    gap: 14,
    align: Align.Stretch
) {
    // Header Section
    \Text(
        size: 26,
        weight: 700,
        color: #f8fafc
    ) {
        DirectedType Component Library
    }

    \Text(
        size: 15,
        weight: 400,
        color: #94a3b8
    ) {
        Standard \\Card and \\Button with intrinsic typography sizing, 6 variants, and direct text support.
    }

    \Divider(color: #334155)
    \Spacer(height: 6)

    // Section 1: Visual Variants
    \Card("card_variants"; style: card_dark, gap: 10) {
        \Text(size: 13, weight: 700, color: #94a3b8) { 1. DESIGN VARIANTS (AUTO-SIZED) }
        \HStack(gap: 12) {
            \Button("btn_primary"; variant: ButtonVariant.Primary, label: "Primary")
            \Button("btn_secondary"; variant: ButtonVariant.Secondary, label: "Secondary")
            \Button("btn_outline"; variant: ButtonVariant.Outline, label: "Outline")
            \Button("btn_ghost"; variant: ButtonVariant.Ghost, label: "Ghost")
            \Button("btn_danger"; variant: ButtonVariant.Danger, label: "Danger")
            \Button("btn_success"; variant: ButtonVariant.Success, label: "Success")
        }
    }

    // Section 2: Dynamic Intrinsic Sizing vs Fixed Width
    \Card("card_sizing"; style: card_dark, gap: 10) {
        \Text(size: 13, weight: 700, color: #94a3b8) { 2. INTRINSIC TEXT METRIC SIZING VS FIXED OVERRIDE }
        \HStack(gap: 12) {
            \Button("btn_short"; style: button_primary, label: "OK")
            \Button("btn_medium"; style: button_secondary, label: "Save Changes")
            \Button("btn_wide"; style: button_outline, label: "Export Diagnostics Report")
            \Button("btn_fixed"; style: button_primary, width: 200, label: "Fixed Width (200px)")
        }
    }

    // Section 3: Active vs Disabled States
    \Card("card_interactive"; style: card_dark, gap: 12) {
        \Text(size: 13, weight: 700, color: #94a3b8) { 3. ACTIVE VS DISABLED STATES }
        \HStack(gap: 16) {
            \Button("btn_active"; style: button_primary, label: "Active Button")
            \Button("btn_disabled"; style: button_primary, label: "Disabled Button (Suppressed)", disabled: true)
        }

        \Text(
            size: 13,
            weight: 500,
            color: #64748b
        ) {
            Disabled buttons render with theme disabled styling and suppress pointer events.
        }
    }

    // Section 4: Direct Text in Card (Auto-Wrapping Height)
    \Card("card_direct_text"; style: card_dark) {
        \Text(color: #f8fafc) {
            Direct text passed straight to Card with auto-wrapping height!
        }
    }
}

