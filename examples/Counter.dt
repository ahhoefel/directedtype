// DirectedType (DTML) Reactive Counter Component
// Accompanied by native Rust companion file: Counter.rs
\use "components/VStack.dt"
\use "components/HStack.dt"
\use "components/Card.dt"
\use "components/CardStyle.dt"
\use "components/Button.dt"
\use "components/ButtonStyle.dt"
\use "theme/default.dt"

\Component Counter(x: Number, y: Number, initial: Number: 0) {
    state count: Number: initial;

    let is_max = count >= 10;
    let is_zero = count <= 0;
    let bar_width = (count * 26) + 12;
    let count_label = "Count: " + count;
    let status_label = is_max ? "MAX (10)" : (is_zero ? "MIN (0)" : "Active");

    alias width = 360;
    alias height = 270;
    alias right = x + 360;
    alias bottom = y + 270;

    let outer_card_style = \CardStyle(
        bg: #1e293b,
        border_color: is_max ? #ef4444 : #334155,
        border_width: 2,
        radius: 16,
        padding: 24
    );

    let inner_card_style = \CardStyle(
        bg: #0f172a,
        border_color: is_max ? #7f1d1d : #1e293b,
        border_width: 1,
        radius: 10,
        padding_x: 20,
        padding_y: 16
    );

    let counter_btn_decrement = \ButtonStyle(
        bg: #334155,
        text_color: #ffffff,
        border_color: #475569,
        border_width: 1,
        radius: 10,
        height: 48,
        size: 22,
        weight: 700,
        disabled_bg: #33415580,
        disabled_text: #64748b,
        disabled_border_color: #33415540
    );

    let counter_btn_increment = \ButtonStyle(
        bg: is_max ? #dc2626 : #2563eb,
        text_color: #ffffff,
        border_color: is_max ? #ef4444 : #3b82f6,
        border_width: 1,
        radius: 10,
        height: 48,
        size: 22,
        weight: 700,
        disabled_bg: #33415580,
        disabled_text: #64748b,
        disabled_border_color: #33415540
    );

    let counter_btn_reset = \ButtonStyle(
        bg: #334155,
        text_color: #ffffff,
        border_color: #475569,
        border_width: 1,
        radius: 10,
        height: 48,
        size: 14,
        weight: 600,
        disabled_bg: #33415580,
        disabled_text: #64748b,
        disabled_border_color: #33415540
    );

    \Card(
        style: outer_card_style,
        width: 360,
        x: x,
        y: y,
        gap: 16
    ) {
        // Component Title & Subtitle via VStack
        \VStack(gap: 4) {
            \Text(size: 22, weight: 700, color: #f8fafc) {
                Reactive Counter
            }

            \Text(size: 12, color: #94a3b8) {
                One-Way Pipeline: State -> DAG -> Pixels
            }
        }

        // Count Value Display Surface via nested Card & HStack
        \Card(
            style: inner_card_style,
            width: 312
        ) {
            \HStack(gap: 60, align: "center") {
                \Text(
                    size: 26,
                    weight: 700,
                    color: is_max ? #ef4444 : (is_zero ? #94a3b8 : #38bdf8),
                    text: count_label
                )
                \Text(
                    size: 12,
                    weight: 600,
                    color: is_max ? #f87171 : #64748b,
                    text: status_label
                )
            }
        }

        // Reactive Progress Gauge
        \Rect(width: 312, height: 8, color: #0f172a, radius: 4) {
            \Rect(
                x: parent.left,
                y: parent.top,
                width: min(bar_width, 312),
                height: 8,
                color: is_max ? #ef4444 : #3b82f6,
                radius: 4
            )
        }

        // Interactive Button Row: [-], [+], [Reset] via HStack
        \HStack(gap: 16) {
            \Button(
                style: counter_btn_decrement,
                width: 72,
                label: "-",
                disabled: is_zero,
                on_click: self.decrement
            )

            \Button(
                style: counter_btn_increment,
                width: 72,
                label: "+",
                on_click: self.increment
            )

            \Button(
                style: counter_btn_reset,
                width: 136,
                label: "Reset",
                on_click: self.reset
            )
        }
    }
}

// Root Document: Centered Dark Canvas
\Rect(x: 0, y: 0, width: window.width, height: window.height, color: #0b0f19) {
    \Counter(
        x: (window.width - 360) / 2,
        y: (window.height - 270) / 2,
        initial: 3
    )
}
