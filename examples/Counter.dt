// DirectedType (DTML) Reactive Counter Component
// Accompanied by native Rust companion file: Counter.rs
\use "components/VStack.dt"
\use "components/HStack.dt"
\use "components/Card.dt"
\use "components/Button.dt"

\Component Counter(x: Number, y: Number, initial: Number: 0) {
    state count: Number: initial;

    let is_max = count >= 10;
    let is_zero = count <= 0;
    let bar_width = (count * 26) + 12;
    let count_label = "Count: " + count;
    let status_label = is_max ? "MAX (10)" : (is_zero ? "MIN (0)" : "Active");

    alias width = 360;
    alias height = 270;
    alias right = x + 360;
    alias bottom = y + 270;

    \Card(
        width: 360,
        x: x,
        y: y,
        color: #1e293b,
        radius: 16,
        border_width: 2,
        border_color: is_max ? #ef4444 : #334155,
        padding_x: 24,
        padding_y: 24,
        gap: 16
    ) {
        // Component Title & Subtitle via VStack
        \VStack(gap: 4) {
            \Text(size: 22, weight: 700, color: #f8fafc) {
                Reactive Counter
            }

            \Text(size: 12, color: #94a3b8) {
                One-Way Pipeline: State -> DAG -> Pixels
            }
        }

        // Count Value Display Surface via nested Card & HStack
        \Card(
            width: 312,
            color: #0f172a,
            radius: 10,
            border_width: 1,
            border_color: is_max ? #7f1d1d : #1e293b,
            padding_x: 20,
            padding_y: 16
        ) {
            \HStack(gap: 60, align: "center") {
                \Text(
                    size: 26,
                    weight: 700,
                    color: is_max ? #ef4444 : (is_zero ? #94a3b8 : #38bdf8),
                    text: count_label
                )
                \Text(
                    size: 12,
                    weight: 600,
                    color: is_max ? #f87171 : #64748b,
                    text: status_label
                )
            }
        }

        // Reactive Progress Gauge
        \Rect(width: 312, height: 8, color: #0f172a, radius: 4) {
            \Rect(
                x: parent.left,
                y: parent.top,
                width: min(bar_width, 312),
                height: 8,
                color: is_max ? #ef4444 : #3b82f6,
                radius: 4
            )
        }

        // Interactive Button Row: [-], [+], [Reset] via HStack
        \HStack(gap: 16) {
            \Button(
                width: 72,
                height: 48,
                label: "-",
                size: 22,
                weight: 700,
                disabled: is_zero,
                variant: "secondary",
                radius: 10,
                on_click: self.decrement
            )

            \Button(
                width: 72,
                height: 48,
                label: "+",
                size: 22,
                weight: 700,
                variant: is_max ? "danger" : "primary",
                radius: 10,
                on_click: self.increment
            )

            \Button(
                width: 136,
                height: 48,
                label: "Reset",
                size: 14,
                weight: 600,
                variant: "secondary",
                radius: 10,
                on_click: self.reset
            )
        }
    }
}

// Root Document: Centered Dark Canvas
\Rect(x: 0, y: 0, width: window.width, height: window.height, color: #0b0f19) {
    \Counter(
        x: (window.width - 360) / 2,
        y: (window.height - 270) / 2,
        initial: 3
    )
}
