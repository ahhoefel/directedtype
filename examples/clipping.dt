// DirectedType (DTML) Clipping & Environmental Clip Contexts Example
\use "components/VStack.dt"
\use "components/VStackStretch.dt"

// A rounded viewport container that establishes a GPU hardware clip boundary
\Component ScrollView(
    x: Distance = parent.left,
    y: Distance = parent.top,
    width: Distance = 320px, 
    height: Distance = 190px, 
    radius: Distance = 16px,
    bg_color: Color = #0f172a,
    border_color: Color = #3b82f6
) {
    // 1. Background frame
    \Rect(
        x: left,
        y: top,
        width: width,
        height: height,
        color: bg_color,
        radius: radius,
        border_width: 2px,
        border_color: border_color
    )

    // 2. Hardware clip node defining the rounded geometry
    \let clip = \Clip(
        up: self.clip, 
        box: \Box(
            x: left, 
            y: top, 
            width: width, 
            height: height, 
            radius: radius
        )
    )

    // 3. Children inherit the clip context ambiently
    \Children(
        clip: clip,
        x: left + 24px,
        y: prev ? prev.bottom + 12px : top + 24px,
        width: width - 48px
    )
}

\VStackStretch(
    x: 32px,
    y: 32px,
    gap: 20px,
    width: min(max(window.width - 64px, 400px), 600px)
) {
    \Text(font: \Font(size: 28px, weight: 700), color: #0f172a) {
        Spatial Clipping Demonstration
    }

    \Text(font: \Font(size: 15px), color: #475569) {
        In DirectedType, clipping is a GPU hardware state decoupled from the layout hierarchy. The ScrollView below establishes a rounded hardware clip mask.
    }

    \ScrollView(height: 200px, radius: 16px, bg_color: #0f172a, border_color: #38bdf8) {
        \Text(font: \Font(size: 16px, weight: 600), color: #38bdf8) {
            Clipped Viewport Content
        }

        \Text(font: \Font(size: 14px), color: #94a3b8) {
            This content overflows the bottom and side boundaries of the ScrollView. Notice how fragments are clipped cleanly against the rounded corner mask.
        }

        // An oversized accent block that extends past the right edge
        \Rect(x: parent.left + 10px, width: 500px, height: 44px, color: #6366f1, radius: 8px)

        \Text(font: \Font(size: 13px), color: #e2e8f0) {
           If you shrink the window enough, you'll see overflowing text that gets clipped smoothly at the bottom rounded boundary.
        }

        // Floating badge that escapes ScrollView clipping to illustrate clip: window.clip
        \Rect(
            clip: window.clip,
            x: parent.right - 120px,
            y: parent.top - 14px,
            width: 100px,
            height: 28px,
            color: #ec4899,
            radius: 14px
        )
        \Text(
            clip: window.clip,
            x: parent.right - 105px,
            y: parent.top - 7px,
            font: \Font(size: 11px, weight: 700),
            color: #ffffff
        ) {
            UNCLIPPED
        }
    }

    \Text(font: \Font(size: 15px), color: #475569) {
        Escape Hatches: Nodes can step up the clip chain via 'clip: clip.up' or bypass clipping entirely using 'clip: window.clip'.
    }
}
