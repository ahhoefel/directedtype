\use "components/Padding.dt"
\use "components/VStack.dt"
\use "components/Center.dt"


\Component Box(x, y, width, height, env font) {
    
    // Background card (drawn first so it stays behind text and guides)
    \Rect(x: self.left, y: self.top, width: self.width, height: self.height, color: #0f172a)
    // Centered text
    \Center {
        \let t = \Text(
            color: #f8fafc,
            start_at: TextStart.Ascender,
            end_at: TextEnd.Descender
        ) {
            Typography
        }
    }
}

\Component Measurement(x, y1, y2, arm: 5, color: #ffffff) {
    \env font = \Font(family: "Arial", size: 10);
    \Rect(x: x, y: y1, width: 1, height: y2 - y1, color: #ef4444)
    \Rect(x: x-arm, y: y1, width: 2*arm, height: 1, color: #ef4444)
    \Rect(x: x-arm, y: y2, width: 2*arm, height: 1, color: #ef4444)
    \Text(x: x + 2, y: (y1 + y2)/2, color: color, text: to_fixed(y2 - y1, 2))
}

\Center{
    \VStack(shrink: true, gap: 50) {
        \Box(width: 1000, height: 160, font: \Font(family: "Arial", size: 120, weight: 700))
        \Box(width: 1000, height: 160, font: \Font(family: "Times New Roman", size: 120, weight: 700))
        \Box(width: 1000, height: 160, font: \Font(family: "Georgia", size: 120, weight: 700))
        \Box(width: 1000, height: 160, font: \Font(family: "Courier New", size: 120, weight: 700))
    }
}