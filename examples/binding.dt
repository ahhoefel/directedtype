\Component Foo(env color: Color) {
    \Children
}

\Component Bar(env color: Color) {
    \Children(
        color: color
    )
}

\Foo(color: #F00) {
    \Bar() {
        \Rect(x: 100px, y: 100px, width: 100px, height: 100px)
    }

    \Rect(x: 100px, y: 300px, width: 100px, height: 100px, color: #0F0)
}