// Font Sharing & Typographic Metric Demo
// Demonstrates reference-based font sharing, DAG port minimization,
// and typographic vertical centering using font.cap_height.

\use "components/VStack.dt"
\use "components/Card.dt"
\use "components/CardStyle.dt"

let font_card_style_1 = \CardStyle(
    bg: #f8fafc,
    border_color: #e2e8f0,
    border_width: 1,
    radius: 12,
    padding_x: 24,
    padding_y: 20
);

let font_card_style_2 = \CardStyle(
    bg: #f1f5f9,
    border_color: #e2e8f0,
    border_width: 1,
    radius: 12,
    padding_x: 24,
    padding_y: 20
);

// 1. Reusable font resource definitions
let heading_font = \Font(size: 28, weight: 700);
let subhead_font = \Font(size: 18, weight: 600);
let badge_font = \Font(size: 13, weight: 600);
let body_font = \Font(size: 15, weight: 400);

let badge_pad = 8;

\VStack(
    x: 40,
    y: 40,
    gap: 24,
    width: min(max(window.width - 80, 400), 800),
    align: Align.Stretch
) {
    // Section Header using shared heading_font
    \Text(font: heading_font, color: #0f172a) {
        Font Sharing & Typographic Metrics
    }

    \Text(font: subhead_font, color: #475569) {
        Shared font nodes eliminate duplicate metric ports across the layout DAG
    }

    // Card 1: Typographic badge centered using badge_font.cap_height
    \Card(style: font_card_style_1) {
        // Badge background sized to precisely fit cap_height + padding
        \Rect(
            width: 180,
            height: badge_font.cap_height + (2 * badge_pad) + 4,
            color: #dbeafe,
            radius: 6
        ) {
            // Text mathematically centered on the cap_height optical baseline
            \Text(
                font: badge_font,
                x: parent.left + 14,
                y: parent.top + badge_pad,
                color: #1e40af
            ) {
                TYPOGRAPHIC BADGE
            }
        }

        \Text(
            font: body_font,
            color: #334155
        ) {
            The badge height and vertical centering adapt dynamically to the intrinsic font cap_height metric.
        }
    }

    // Card 2: Shared font metrics across diverse UI elements
    \Card(style: font_card_style_2) {
        \Text(font: body_font, color: #475569) {
            All four cards and text blocks reference the same Font nodes, minimizing duplicate measurement passes.
        }
    }
}
