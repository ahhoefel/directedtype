\use { List, Item, BulletType } from "components/List.dt";
\use { Align } from "components/Align.dt";
\use { VStack } from "components/VStack.dt";

\env font = \Font(family: "Arial", size: 16px);
\let inset = 20px;

\VStack(x:10px, y:10px, gap: 10px){
    \List(inset, width: 200px, gap: 10px, item_gap: 10px, bullet_type: BulletType.Bullet) {
        \Item{One}
        \Item{Two}
        \Item{Three}
    }
    \List(inset, width: 200px, gap: 10px, item_gap: 10px) {
        \Item{Hello, lorem ipsum dolor emit sum. Hello, lorem ipsum dolor emit sum. Hello, lorem ipsum dolor emit sum.}
        \Item{Two}
        \Item{Three}
    }
    \List(inset, width: 200px, gap: 10px, item_gap: 10px) {
        \Item{Hello, lorem ipsum dolor emit sum. Hello, lorem ipsum dolor emit sum. Hello, lorem ipsum dolor emit sum.}
        \Item{Two}
        \Item{Three}
        \Item{Four}
        \Item{Five}
        \Item{Six}
        \Item{Seven}
        \Item{Eight}
        \Item{Nine}
        \Item{Ten}
    }
}