// DirectedType Standard Component Library Demo: VStack
// Showcases vertically stacked flow with left, center, right, and stretch alignments,
// dynamic child spacing (gap), and container padding.

\use "../components/PadIn.dt"
\use "../components/PadOut.dt"
\use "../components/VStack.dt"
\use "../components/VStackStretch.dt"
\use "../components/HStack.dt"
\use "../components/Align.dt"
\use "../components/Card.dt"
\use "../components/CardStyle.dt"
\use "../components/Button.dt"
\use "../components/Spacer.dt"
\use "../theme/default.dt"

\let col_card_style = \CardStyle(
    bg: #1e293b,
    border_color: #334155,
    border_width: 1px,
    radius: 12px,
    padding_x: 16px,
    padding_y: 16px
);

// Canvas Background
\Rect(
    x: 0,
    y: 0,
    width: window.width,
    height: window.height,
    color: #0f172a
)

// Main Page Layout using declarative PadIn and VStack
\PadIn(padding_x: 40px, padding_y: 36px, x: 0, y: 0) {
    \VStack(gap: 14px) {
    // Header Section
    \Text(
        font: \Font(size: 26px, weight: 700),
        color: #f8fafc
    ) {
        VStack Flow Component
    }

    \Text(
        font: \Font(size: 15px, weight: 400),
        color: #94a3b8
    ) {
        Declarative vertical stacking with gap recurrence, padding, and cross-axis alignment.
    }

    \Spacer(height: 8px)

    // Horizontal row of columns using HStack
    \HStack(gap: 25px) {
        // Column 1: Left Alignment (Default)
        \Card(
            style: col_card_style,
            width: 210px,
            gap: 14px
        ) {
            \Text(font: \Font(size: 13px, weight: 700), color: #38bdf8) { ALIGN: LEFT (DEFAULT) }

            \VStack(
                width: 178px,
                gap: 14px,
                align: Align.Left
            ) {
                \Rect(width: 90px, height: 32px, radius: 6px, color: #3b82f6)
                \Button(style: button_primary, label: "Short")
                \Rect(width: 140px, height: 32px, radius: 6px, color: #10b981)
                \Button(style: button_secondary, label: "Medium Action")
                \Rect(width: 60px, height: 28px, radius: 6px, color: #f59e0b)
            }
        }

        // Column 2: Center Alignment
        \Card(
            style: col_card_style,
            width: 210px,
            gap: 14px
        ) {
            \Text(font: \Font(size: 13px, weight: 700), color: #a78bfa) { ALIGN: CENTER }

            \VStack(
                width: 178px,
                gap: 14px,
                align: Align.Center
            ) {
                \Rect(width: 90px, height: 32px, radius: 6px, color: #8b5cf6)
                \Button(style: button_outline, width: 110px, label: "Centered")
                \Rect(width: 140px, height: 32px, radius: 6px, color: #ec4899)
                \Button(style: button_secondary, width: 130px, label: "Centered Item")
                \Rect(width: 60px, height: 28px, radius: 6px, color: #06b6d4)
            }
        }

        // Column 3: Right Alignment
        \Card(
            style: col_card_style,
            width: 210px,
            gap: 14px
        ) {
            \Text(font: \Font(size: 13px, weight: 700), color: #f472b6) { ALIGN: RIGHT }

            \VStack(
                width: 178px,
                gap: 14px,
                align: Align.Right
            ) {
                \Rect(width: 90px, height: 32px, radius: 6px, color: #ec4899)
                \Button(style: button_danger, width: 80px, label: "Right")
                \Rect(width: 140px, height: 32px, radius: 6px, color: #f97316)
                \Button(style: button_outline, width: 124px, label: "Aligned Right")
                \Rect(width: 60px, height: 28px, radius: 6px, color: #eab308)
            }
        }

        // Column 4: Stretch Alignment
        \Card(
            style: col_card_style,
            width: 215px,
            gap: 14px
        ) {
            \Text(font: \Font(size: 13px, weight: 700), color: #4ade80) { ALIGN: STRETCH }

            \VStackStretch(
                width: 183px,
                gap: 14px
            ) {
                \Rect(height: 32px, radius: 6px, color: #10b981)
                \Button(style: button_success, label: "Full Width Button")
                \Rect(height: 32px, radius: 6px, color: #14b8a6)
                \Button(style: button_primary, label: "Stretched Action")
                \Rect(width: 80px, height: 28px, radius: 6px, color: #6366f1)
            }
        }
    }
}
}

