\use "components/Padding.dt"
\use "components/VStack.dt"
\use "components/HStack.dt"
\use "components/Card.dt"
\use "components/CardStyle.dt"
\use "components/Button.dt"
\use "components/Divider.dt"
\use "components/Spacer.dt"
\use "theme/default.dt"

let demo_card_style = \CardStyle(
    bg: #0f172a,
    border_color: #3b82f6,
    border_width: 2,
    radius: 12,
    padding_x: 22,
    padding_y: 20
);

// Main Page Layout with uniform window margin padding
\Padding(padding: 40, x: 0, y: 0) {
    \VStack(
        width: min(max(window.width - 80, 400), 720),
        gap: 20,
        align: "stretch"
    ) {
        // Document Header
        \Text(size: 34, weight: 700, color: #0f172a) {
            DirectedType Native Layout Engine
        }

        \Text(size: 16, color: #475569) {
            A pure functional reactive layout engine based on a Directed Acyclic Graph (DAG) of layout equations, powered by Vello GPU rendering and Parley text shaping.
        }

        \Spacer(height: 4)

        // Architecture Callout Surface using standard Card
        \Card(
            style: demo_card_style,
            gap: 10
        ) {
            \Text(size: 13, weight: 700, color: #38bdf8) {
                TOPOLOGICAL DAG EVALUATION
            }
            \Text(size: 15, width: parent.width - 44, color: #e2e8f0) {
                Layout is Math: Every spatial coordinate (x, y, width, height, z) is an explicit edge in a topological dependency graph. Kahn's algorithm guarantees deterministic evaluation without CSS layout thrashing.
            }
        }

        // Action Buttons Row using standard HStack & Button
        \HStack(gap: 12) {
            \Button(style: button_primary, label: "Explore Architecture")
            \Button(style: button_outline, label: "GPU Compute Shaders")
        }

        \Spacer(height: 6)
        \Divider(thickness: 2, color: #e2e8f0)

        // Footer Note
        \Text(size: 14, color: #64748b) {
            Rendered natively on Apple Metal with compute-centric vector pipelines via Vello and wgpu.
        }
    }
}
