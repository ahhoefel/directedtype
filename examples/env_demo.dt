// Environmental Scoping & Lexical Propagation Demo
// Demonstrates the 2x2 Orthogonal Matrix and Lexical Tombstones

\Component Flow(
    x: Distance = parent.x, 
    y: Distance = parent.y + margin, 
    gap: Distance = 20px, 
    width: Distance = min(max(window.width, 400px), 700px), 
    margin: Distance = 30px
) {
    \Children(
        x: left + margin,
        y: prev ? prev.bottom + gap : top,
        width: width - (2 * margin)
    )
}

\Enum Theme {
    Dark,
    Light
}

// 1. Translator / Provider: Takes parameter and exposes as ambient environment
\Component ThemeProvider(
    theme: Theme = Theme.Dark,
    x: Distance = parent.left,
    y: Distance = parent.top,
    width: Distance = parent.width,
    height: Distance = sum(children.height)
) {
    \env text_color = (theme == Theme.Dark) ? #f8fafc : #0f172a
    \env card_bg = (theme == Theme.Dark) ? #1e293b : #e2e8f0
    \env accent_color = #3b82f6
    \Children(
        x: left,
        y: prev ? prev.bottom + 20px : top,
        width: width
    )
}

// 2. Interceptor: Intercepts ambient env accent_color and replaces it for subtrees
\Component AccentInterceptor(
    new_accent: Color = #ec4899,
    x: Distance = parent.left,
    y: Distance = parent.top,
    width: Distance = parent.width,
    height: Distance = sum(children.height)
) {
    \env accent_color = new_accent
    \Children(
        x: left,
        y: top,
        width: width
    )
}

// 3. Shield / Swallower: Consumes env card_bg and text_color, swallowing propagation to descendants
\Component SwallowerShield(
    env card_bg: Color, 
    env text_color: Color, 
    env accent_color: Color, 
    x: Distance = parent.left,
    y: Distance = parent.top,
    width: Distance = parent.width,
    height: Distance = sum(children.height) + 50px
) {
    // Firewall tombstones: stop ambient theme propagation to children
    \let card_bg;
    \let text_color;
    // Local let shadows env parameter, creating a firewall that stops accent propagation
    \let accent_color = #94a3b8;
    \Rect(x: left, y: top, width: width, height: 36px, color: accent_color, radius: 8px)
    \Text(x: left + 12px, y: top + 10px, size: 13px, weight: 600, color: #ffffff) {
        Shield / Swallower Firewall: stopped env propagation below
    }
    \Children(
        x: left,
        y: top + 50px,
        width: width
    )
}

// A leaf card component that automatically consumes ambient text_color, card_bg, and accent_color
\Component AmbientCard(
    x: Distance = parent.left,
    y: Distance = parent.top,
    width: Distance = parent.width, 
    height: Distance = 90px, 
    env card_bg: Color = #ffffff, 
    env text_color: Color = #000000, 
    env accent_color: Color = #2563eb
) {
    \Rect(
        x: left,
        y: top,
        width: width,
        height: height,
        color: card_bg,
        radius: 10px,
        border_width: 2px,
        border_color: accent_color
    )
    \Text(
        x: left + 16px,
        y: top + 20px,
        size: 16px,
        weight: 600,
        color: text_color
    ) {
        Environmental Scoping Active
    }
    \Text(
        x: left + 16px,
        y: top + 48px,
        size: 14px,
        color: accent_color
    ) {
        Accent border color inherited via env propagation
    }
}

// A leaf card component that automatically consumes ambient text_color, card_bg, and accent_color
\Component DirectCard(
    x: Distance = parent.left,
    y: Distance = parent.top,
    width: Distance = parent.width, 
    height: Distance = 90px, 
    card_bg: Color = #ff0000, 
    text_color: Color = #009900, 
    accent_color: Color = #009900
) {
    \Rect(
        x: left,
        y: top,
        width: width,
        height: height,
        color: card_bg,
        radius: 10px,
        border_width: 2px,
        border_color: accent_color
    )
    \Text(
        x: left + 16px,
        y: top + 20px,
        size: 16px,
        weight: 600,
        color: text_color
    ) {
        No environmental scoping.
    }
    \Text(
        x: left + 16px,
        y: top + 48px,
        size: 14px,
        color: accent_color
    ) {
        Accent color not taken from environment. card_bg set from env.card_bg.
    }
}

\Flow(margin: 40px, gap: 24px) {
    \Text(size: 28px, weight: 700, color: #0f172a) {
        Environmental Scope Showcase
    }

    // Outer Dark Theme Provider
    \ThemeProvider(theme: Theme.Dark) {
        \AmbientCard()

        // Nested subtree with Interceptor (Pink Accent)
        \AccentInterceptor(new_accent: #ec4899) {
            \AmbientCard()
        }

        // Nested subtree with Swallower Shield (Reverts to Tier 1 default accent)
        \SwallowerShield {
            \AmbientCard()
        }

        \DirectCard(card_bg: env.card_bg)
    }
}
