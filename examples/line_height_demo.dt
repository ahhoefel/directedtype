\use "components/VStack.dt"
\use "components/Center.dt"
\use "components/PadOut.dt"
\use "components/TextBounds.dt"


\Component Box(x, y, width, height, env font) {
    \env text_bounds = \TextBounds(start_at: TextStart.EmTop, end_at: TextEnd.GapBottom);
    // Background card (drawn first so it stays behind text and guides)
    \Rect(x: left, y: top, width: width, height: height, color: #0f172a)
    // Centered text
    \Center {
        \let t = \Text(
            color: #f8fafc,
        ) {
            Typography
        }
    }
    // Text bounding box (cyan)
    \Rect(x: t.left, y: t.top, width: t.width, height: t.height, color: #00000000, border_color: #38bdf8, border_width: 1px)
    // Baseline (red)
    \let baseline_y = t.font.baseline;
    \let guide_outset = 25px;
    \let guide_x = t.left - guide_outset;
    \let guide_width = t.width + (2 * guide_outset);
    \let cap_height_y = baseline_y - t.font.cap_height;
    \let x_height_y = baseline_y - t.font.x_height;
    \let descender_y = baseline_y + t.font.descent;
    \let gap_y = baseline_y + t.font.gap_bottom;

    // 1em square at the start of the text (from baseline_y - t.font.em_top down to descender_y)
    \Rect(
        x: t.left,
        y: baseline_y - t.font.em_top,
        width: 1em,
        height: 1em,
        color: #eab30822,
        border_color: #eab308,
        border_width: 1px
    )

    \HLine(x: guide_x, y: baseline_y, length: guide_width, color: #ef4444)
    \HLine(x: guide_x, y: cap_height_y, length: guide_width, color: #22c55e)
    \HLine(x: guide_x, y: x_height_y, length: guide_width, color: #f97316)
    \HLine(x: guide_x, y: descender_y, length: guide_width, color: #a855f7)
    \HLine(x: guide_x, y: gap_y, length: guide_width, color: #0b52c3)


    \Measurement(x: guide_x - 10px, y1: t.top, y2: t.bottom)
    \Measurement(x: guide_x + guide_width + 10px, y1: t.y, y2: baseline_y)
    \Measurement(x: guide_x + guide_width + 30px, y1: cap_height_y, y2: descender_y)
    \Measurement(x: guide_x + guide_width + 50px, y1: baseline_y, y2: gap_y)
    \Measurement(x: guide_x + guide_width/2, y1: y, y2: t.y)
    \Measurement(x: guide_x + guide_width/2, y1: t.bottom, y2: bottom)
    \Measurement(x: right + 10px, y1: top, y2: bottom, color: #000000)

}

\Component Measurement(x, y1, y2, arm: 5px, color: #ffffff) {
    \env font = \Font(family: "Arial", size: 10px);
    \Rect(x: x-0.5px, y: y1, width: 1px, height: y2 - y1, color: #ef4444)
    \Rect(x: x-arm, y: y1-0.5px, width: 2*arm, height: 1px, color: #ef4444)
    \Rect(x: x-arm, y: y2-0.5px, width: 2*arm, height: 1px, color: #ef4444)
    \Text(x: x + 2px, y: (y1 + y2)/2, color: color, text: to_fixed(distance_to_float(y2 - y1, px), 2))
}

\Component HLine(x, y, length, thickness: Distance: 1px, color) {
    \Rect(x, y: y - thickness/2, width: length, height: thickness, color)
}

\Center {
    \PadOut(padding_y: 30px) {
        \VStack(shrink: true, gap: 50px) {
            \Box(width: 1000px, height: 200px, font: \Font(family: "Arial", size: 120px, line_height: 180px, weight: 700))
            \Box(width: 1000px, height: 200px, font: \Font(family: "Times New Roman", size: 120px, line_height: 180px, weight: 700))
            \Box(width: 1000px, height: 200px, font: \Font(family: "Georgia", size: 120px, line_height: 180px, weight: 700))
            \Box(width: 1000px, height: 200px, font: \Font(family: "Courier New", size: 120px, line_height: 180px, weight: 700))
        }
    }
}