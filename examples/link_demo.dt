\use "components/PadOut.dt"
\use "components/VStack.dt"
\use "components/VStackStretch.dt"
\use "components/HStack.dt"
\use "components/Card.dt"
\use "components/CardStyle.dt"
\use "components/Button.dt"
\use "components/Divider.dt"
\use "components/Spacer.dt"
\use "components/LinkStyle.dt"
\use "components/Link.dt"
\use "theme/default.dt"

\env link_style = link_default;

\let link_card_style = \CardStyle(
    bg: #f8fafc,
    border_color: #cbd5e1,
    border_width: 1px,
    radius: 12px,
    padding_x: 24px,
    padding_y: 20px
);

\let callout_card_style = \CardStyle(
    bg: #eff6ff,
    border_color: #93c5fd,
    border_width: 1px,
    radius: 12px,
    padding_x: 24px,
    padding_y: 20px
);

// Custom Brand LinkStyles demonstrating LinkStyle component polymorphism
\let vello_link_style = \LinkStyle(
    color: #7c3aed,
    underline: true,
    bg: #00000000,
    hover_color: #6d28d9,
    hover_underline: true,
    hover_bg: #ede9fe80,
    focused_color: #5b21b6,
    focused_underline: true,
    focused_bg: #ede9fe
);

\let parley_link_style = \LinkStyle(
    color: #059669,
    underline: true,
    bg: #00000000,
    hover_color: #047857,
    hover_underline: true,
    hover_bg: #d1fae580,
    focused_color: #065f46,
    focused_underline: true,
    focused_bg: #d1fae5
);

\let crates_link_style = \LinkStyle(
    color: #d97706,
    underline: false,
    bg: #00000000,
    hover_color: #b45309,
    hover_underline: true,
    hover_bg: #fef3c780,
    focused_color: #92400e,
    focused_underline: true,
    focused_bg: #fef3c7
);

\let rust_link_style = \LinkStyle(
    color: #ea580c,
    underline: true,
    bg: #00000000,
    hover_color: #c2410c,
    hover_underline: true,
    hover_bg: #ffedd580,
    focused_color: #9a3412,
    focused_underline: true,
    focused_bg: #ffedd5
);

\let w3c_link_style = \LinkStyle(
    color: #0284c7,
    underline: true,
    bg: #00000000,
    hover_color: #0369a1,
    hover_underline: true,
    hover_bg: #e0f2fe80,
    focused_color: #075985,
    focused_underline: true,
    focused_bg: #e0f2fe
);

\PadOut(padding: 40px, x: 0, y: 0) {
    \VStackStretch(
        width: min(max(window.width - 80px, 400px), 740px),
        gap: 22px
    ) {
        \Anchor("top")

        // Title & Header
        \VStack(gap: 8px) {
            \Text(font: \Font(size: 32px, weight: 700), color: #0f172a) {
                Hypertext Links & In-Page Navigation
            }
            \Text(font: \Font(size: 16px), color: #64748b) {
                Demonstrating inline links, in-page anchor navigation, and window-level scrolling.
            }
        }

        // Table of Contents Card (relies on ambient env link_style = link_default)
        \Card(style: callout_card_style, gap: 10px) {
            \Text(font: \Font(size: 14px, weight: 700), color: #1d4ed8) {
                TABLE OF CONTENTS (IN-PAGE ANCHORS)
            }
            \VStack(gap: 6px) {
                \Text(font: \Font(size: 15px), color: #1e293b) {
                    • \Link(url: "#inline-links"){1. Inline Text Hyperlinks}
                }
                \Text(font: \Font(size: 15px), color: #1e293b) {
                    • \Link(url: "#custom-styling"){2. Custom Link Styling & Accents}
                }
                \Text(font: \Font(size: 15px), color: #1e293b) {
                    • \Link(url: "#quick-nav"){3. External Resource Links}
                }
                \Text(font: \Font(size: 15px), color: #1e293b) {
                    • \Link(url: "#deep-section"){4. Deep Document Section (Scroll Test)}
                }
            }
        }

        \Divider(thickness: 1px, color: #e2e8f0)

        // Section 1
        \Card(
            style: link_card_style,
            gap: 14px,
            focused_bg: #eff6ff,
            focused_border_color: #3b82f6,
            focused_border_width: 2px
        ) {
            \Anchor("inline-links") {
                \Text(font: \Font(size: 14px, weight: 700), color: #475569) {
                    1. INLINE TEXT WITH EMBEDDED HYPERLINKS
                }
            }
            \Text(font: \Font(size: 16px), width: parent.width - 48px, color: #1e293b) {
                DirectedType now supports first-class inline components. You can read the documentation at \Link(url: "https://directedtype.org"){directedtype.org} or check out our project repository on \Link(url: "https://github.com"){GitHub}. Notice how spaces between adjacent inline links and plain words are naturally preserved by the cursor stream.
            }
        }

        // Section 2
        \Card(
            style: callout_card_style,
            gap: 12px,
            focused_bg: #dbeafe,
            focused_border_color: #2563eb,
            focused_border_width: 2px
        ) {
            \Anchor("custom-styling") {
                \Text(font: \Font(size: 14px, weight: 700), color: #1d4ed8) {
                    2. CUSTOM LINK STYLING & ACCENTS
                }
            }
            \Text(font: \Font(size: 16px), width: parent.width - 48px, color: #1e293b) {
                Links can define custom LinkStyle bundles: visit \Link(url: "https://vello.dev", link_style: vello_link_style){Vello 2D Graphics} for GPU compute rendering, \Link(url: "https://parley.dev", link_style: parley_link_style){Parley} for typographic shaping, or \Link(url: "https://crates.io", link_style: crates_link_style){Crates.io} without an initial underline.
            }
        }

        // Section 3
        \Card(
            style: link_card_style,
            gap: 10px,
            focused_bg: #f8fafc,
            focused_border_color: #6366f1,
            focused_border_width: 2px
        ) {
            \Anchor("quick-nav") {
                \Text(font: \Font(size: 14px, weight: 700), color: #334155) {
                    3. EXTERNAL RESOURCE LINKS
                }
            }
            \Text(font: \Font(size: 15px), width: parent.width - 48px, color: #334155) {
                Explore: \Link(url: "https://google.com"){Google} | \Link(url: "https://rust-lang.org", link_style: rust_link_style){Rust Language} | \Link(url: "https://w3.org", link_style: w3c_link_style){W3C Standards} | \Link(url: "https://github.com/directedtype"){Source Repository}
            }
        }

        \Spacer(height: 120px)

        // Section 4 (Deep Section to test window scrolling)
        \Card(
            style: link_card_style,
            gap: 14px,
            focused_bg: #f0fdf4,
            focused_border_color: #059669,
            focused_border_width: 2px
        ) {
            \Anchor("deep-section") {
                \Text(font: \Font(size: 14px, weight: 700), color: #0f766e) {
                    4. DEEP DOCUMENT SECTION
                }
            }
            \Text(font: \Font(size: 16px), width: parent.width - 48px, color: #1e293b) {
                You navigated here via an in-page anchor! Clicking on \Text(font: \Font(weight: 600)){#deep-section} scrolled the window directly to this element. Notice the subtle overlay scrollbar indicator on the right edge of the window.
            }
            \Text(font: \Font(size: 15px), color: #2563eb) {
                \Link(url: "#top"){↑ Back to top}
            }
        }

        \Divider(thickness: 1px, color: #e2e8f0)

        // Footer Note
        \Text(font: \Font(size: 13px), color: #94a3b8) {
            DirectedType Hypertext Navigation: Inline Spans, Anchor Scopes, Window Scrolling, and Trackpad/Wheel Interaction.
        }
    }
}
