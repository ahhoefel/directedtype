// End Matter: Errata & Typesetting Notes
// Documents line-break departures from the 1866 Macmillan edition (plus the 5 editorial punctuation fixes).

\use "components/Align.dt"
\use "components/LineBreak.dt"
\use "components/TextBounds.dt"
\use "components/TextStart.dt"
\use "components/TextEnd.dt"
\use "components/VStackStretch.dt"
\use "components/SmallCaps.dt"
\use "components/Spacer.dt"
\use "components/Italic.dt"
\use "AliceStyle.dt"

\Component CorrectionList(
    x: Distance = parent.left,
    y: Distance = parent.top,
    width: Distance = parent.width,
    gap: Distance = 6pt,
    comma_gap: Distance = 2.5pt,
    bullet_gap: Distance = 7pt,
    indent: Distance = 12pt,
    pagination: Pagination = \Pagination(breakable: true)
) {
    \let max_page_w = max(children.page_w);
    \let max_line_w = max(children.line_w);
    \let max_loc_w = max(children.loc_w);
    \let max_before_bullet = max(max_loc_w, max_page_w + comma_gap + max_line_w);

    \let comma_x = indent + max_before_bullet - max_line_w - comma_gap;
    \let bullet_x = indent + max_before_bullet + bullet_gap;

    \Children(
        x: x,
        y: prev ? prev.bottom + gap : y,
        width: width,
        comma_x: comma_x,
        comma_gap: comma_gap,
        bullet_x: bullet_x,
        bullet_gap: bullet_gap
    )

    \alias height: Distance = sum(children.height) + max(0, children.len - 1) * gap;
    \alias bottom: Distance = y + height;
}

\Component CorrectionRow(
    loc: String = "",
    page_ref: String = "",
    line_ref: String = "",
    comma_x: Distance = 0pt,
    comma_gap: Distance = 2.5pt,
    bullet_x: Distance = 0pt,
    bullet_gap: Distance = 7pt,
    x: Distance = parent.left,
    y: Distance = parent.top,
    width: Distance = parent.width,
    pagination: Pagination = \Pagination(breakable: false),
    env font: Font
) {
    \let row_font = \Font(font: font, size: 8.5pt, line_height: 13pt);
    \let row_ps = \ParagraphStyle(align: Align.Left);

    \let page_t = \Text(
        x: x + comma_x - page_t.width,
        y: y,
        font: row_font,
        paragraph_style: row_ps,
        text: page_ref != "" ? (page_ref + ",") : ""
    );
    \let line_t = \Text(
        x: x + comma_x + comma_gap,
        y: y,
        font: row_font,
        paragraph_style: row_ps,
        text: line_ref
    );
    \let loc_t = \Text(
        x: x + bullet_x - bullet_gap - loc_t.width,
        y: y,
        font: row_font,
        paragraph_style: row_ps,
        text: loc
    );
    \let bullet_t = \Text(
        x: x + bullet_x - bullet_t.width * 0.5,
        y: y,
        font: row_font,
        paragraph_style: row_ps,
        text: "•"
    );
    \let detail = \Text(
        x: x + bullet_x + bullet_gap,
        y: y,
        width: width - bullet_x - bullet_gap,
        font: row_font,
        paragraph_style: row_ps
    ) {
        \Children
    };

    \alias page_w: Distance = page_t.width;
    \alias line_w: Distance = line_t.width;
    \alias loc_w: Distance = loc_t.width;
    \alias height: Distance = max(detail.height, max(page_t.height, loc_t.height));
    \alias bottom: Distance = y + height;
}

\Component EndMatter(
    x: Distance = parent.left,
    y: Distance = parent.top,
    width: Distance = parent.width,
    pagination: Pagination = \Pagination(breakable: true, break_before: Break.Recto),
    env font: Font
) {
    \let title_font = \Font(font: font, size: 11pt, letter_spacing: 0.75pt);

    \env font = \Font(font: self.font, size: 9pt, line_height: 13pt);
    \env text_bounds = \TextBounds(start_at: TextStart.LineHeight, end_at: TextEnd.LineHeight);
    \env paragraph_style = \ParagraphStyle(align: Align.Justify, indent: 12pt, line_break: LineBreak.Optimal);

    \let stack = \VStackStretch(
        x: x,
        y: y,
        width: width,
        gap: 0pt,
        pagination: \Pagination(breakable: true)
    ) {
        \Spacer(height: 12pt)
        \Text(
            width: parent.width,
            font: title_font,
            paragraph_style: \ParagraphStyle(align: Align.Center),
            text: "TYPESETTING NOTES."
        )
        \Spacer(height: 12pt)
        \DoubleRule(rule_width: 56.25pt)
        \Spacer(height: 14pt)

        \FlushPara {
            This edition is set in Old Standard TT 12pt with 18pt leading
            across a 265pt measure.
            Every line break matches the original 1866 \SmallCaps{Macmillan} printing.
        }

        The 1866 edition used generous word and sentence spacing, as well
        as extra space around certain punctuation marks—a convention no 
        longer in common practice and not reproduced here.

        We matched the line breaks in the original using the Knuth\=Plass
        line\=breaking algorithm (word spacing 6.36pt, range 2.99–12.08pt, sentence
        space 8.04pt). But we still needed to manually break 658/2,625 (25.1%) of the interior
        line breaks.

        Six minor typographical slips in the 1866 \SmallCaps{Macmillan} printing were corrected:

        \Spacer(height: 8pt)
        \CorrectionList(gap: 6pt) {
            \CorrectionRow(loc: "Contents")                     { 67 → 76 }
            \CorrectionRow(page_ref: "p.67",  line_ref: "l.6")  { minutes, → minutes. }
            \CorrectionRow(page_ref: "p.87",  line_ref: "l.5")  { Alice; that’s → Alice; “that’s }
            \CorrectionRow(page_ref: "p.102", line_ref: "l.16") { asked.” → asked. }
            \CorrectionRow(page_ref: "p.119", line_ref: "l.14") { “The soldiers → The soldiers }
            \CorrectionRow(page_ref: "p.120", line_ref: "l.1")  { Duchess? → Duchess?” }
        }
    };

    \alias height: Distance = stack.height;
}
