// Chapter III: A Caucus-Race and a Long Tale — Complete (Pages 29–40)
// Verbatim 1866 Macmillan text, line breaks, page breaks, Caucus-Race header (#9 p. 29),
// Dodo thimble plate (#10 p. 35), and S-curve typographic calligram "The Mouse's Tale" (p. 37).

\use "components/Align.dt"
\use "components/Italic.dt"
\use "AliceStyle.dt"

// Exact 50-line S-curve typographic calligram from Book Page 37
\Component TailLine(
    dx: Distance,
    dy: Distance,
    size: Distance,
    italic: Boolean = false,
    x: Distance = parent.left,
    y: Distance = parent.top,
    env font: Font
) {
    \let f = \Font(font: self.font, size: size, line_height: size * 1.15, italic: italic);
    \env font = f;
    \Text(
        x: x + dx,
        y: y + dy,
        width: 120pt,
        font: f
    ) {
        \Children
    }
}

