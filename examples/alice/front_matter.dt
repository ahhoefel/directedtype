// 1865 Macmillan Front Matter (Pages [i] through [x])
// [i]   Recto: Half-Title
// [ii]  Verso: Frontispiece (Tenniel #1 — Courtroom Trial)
// [iii] Recto: 1865 Macmillan Title Page
// [iv]  Verso: R. Clay, Son, and Taylor Printer's Imprint
// [v]   Recto: Prefatory Poem ("All in the golden afternoon", Stanzas 1–2)
// [vi]  Verso: Prefatory Poem (Stanzas 3–5)
// [vii] Recto: Prefatory Poem (Stanzas 6–7)
// [viii] Verso: Blank
// [ix]  Recto: CONTENTS.
// [x]   Verso: Blank (followed by Page 1 on Recto)

\use "components/Align.dt"
\use "components/Center.dt"
\use "components/VStackStretch.dt"
\use "components/Spacer.dt"
\use "components/Italic.dt"
\use "AliceStyle.dt"

\Component FrontispiecePlate(
    src: Path = "images/tenniel_01.png",
    x: Distance = parent.left,
    y: Distance = parent.top,
    width: Distance = parent.width,
    pagination: Pagination = \Pagination(breakable: false, break_before: Break.Verso)
) {
    // 746x1077px at 200 DPI = 268.56pt x 387.72pt, centered optically across the 250pt measure
    \let img = \Image(
        src: src,
        x: x + (width - img.width) * 0.5,
        y: y - 5pt,
        dpi: 200.0
    );

    \alias right: Distance = x + width;
    \alias height: Distance = 372pt;
    \alias bottom: Distance = y + height;
}

\Component ContentsHeaderRow(
    x: Distance = parent.left,
    y: Distance = parent.top,
    width: Distance = parent.width,
    pagination: Pagination = \Pagination(breakable: false),
    env font: Font
) {
    \let col_font = \Font(font: font, size: 5.5pt);
    \Text(x: x, y: y, font: col_font, color: #111111, text: "CHAPTER")
    \Text(x: x, y: y, width: width, font: col_font, color: #111111, align: Align.Right, text: "PAGE")

    \alias right: Distance = x + width;
    \alias height: Distance = 8pt;
    \alias bottom: Distance = y + height;
}

\Component ContentsRow(
    roman: String,
    title: String,
    dots: String,
    page_num: String,
    x: Distance = parent.left,
    y: Distance = parent.top,
    width: Distance = parent.width,
    pagination: Pagination = \Pagination(breakable: false),
    env font: Font
) {
    \let row_font = \Font(font: font, size: 7.5pt, line_height: 10pt);
    \let dot_font = \Font(font: font, size: 8pt, line_height: 10pt);

    \Text(
        x: x,
        y: y,
        width: 19pt,
        font: row_font,
        color: #111111,
        align: Align.Right,
        text: roman + "."
    )

    \Text(
        x: x + 26pt,
        y: y,
        font: row_font,
        color: #111111,
        text: title
    )

    \Text(
        x: x,
        y: y,
        width: width - 22pt,
        font: dot_font,
        color: #111111,
        align: Align.Right,
        text: dots
    )

    \Text(
        x: x,
        y: y,
        width: width,
        font: dot_font,
        color: #111111,
        align: Align.Right,
        text: page_num
    )

    \alias right: Distance = x + width;
    \alias height: Distance = 21pt;
    \alias bottom: Distance = y + height;
}

\Component FrontMatter(
    x: Distance = parent.left,
    y: Distance = parent.top,
    width: Distance = parent.width,
    pagination: Pagination = \Pagination(breakable: true),
    env font: Font
) {
    \let stack = \VStackStretch(
        x: x,
        y: y,
        width: width,
        gap: 0pt,
        pagination: \Pagination(breakable: true)
    ) {
        // ============================================================
        // Page [i] (Recto): Half-Title
        // ============================================================
        \VStackStretch(width: parent.width, gap: 0pt, pagination: \Pagination(breakable: false)) {
            \Spacer(height: 118pt)
            \Text(
                width: parent.width,
                font: \Font(font: font, size: 13.5pt),
                color: #111111,
                align: Align.Center,
                text: "ALICE’S ADVENTURES"
            )
            \Spacer(height: 22pt)
            \Text(
                width: parent.width,
                font: \Font(font: font, size: 13.5pt),
                color: #111111,
                align: Align.Center,
                text: "IN WONDERLAND."
            )
        }

        // ============================================================
        // Page [ii] (Verso): Frontispiece
        // ============================================================
        \FrontispiecePlate()

        // ============================================================
        // Page [iii] (Recto): 1865 Macmillan Title Page
        // ============================================================
        \VStackStretch(width: parent.width, gap: 0pt, pagination: \Pagination(breakable: false, break_before: Break.Recto)) {
            \Spacer(height: 28pt)
            \Text(
                width: parent.width,
                font: \Font(font: font, size: 17.5pt),
                color: #111111,
                align: Align.Center,
                text: "ALICE’S ADVENTURES"
            )
            \Spacer(height: 28pt)
            \Text(
                width: parent.width,
                font: \Font(font: font, size: 17.5pt),
                color: #111111,
                align: Align.Center,
                text: "IN WONDERLAND."
            )
            \Spacer(height: 56pt)
            \Text(
                width: parent.width,
                font: \Font(font: font, size: 8.5pt),
                color: #111111,
                align: Align.Center,
                text: "BY"
            )
            \Spacer(height: 12pt)
            \Text(
                width: parent.width,
                font: \Font(font: font, size: 10.5pt),
                color: #111111,
                align: Align.Center,
                text: "LEWIS CARROLL."
            )
            \Spacer(height: 56pt)
            \Text(
                width: parent.width,
                font: \Font(font: font, size: 8.8pt, italic: true),
                color: #111111,
                align: Align.Center,
                text: "WITH FORTY-TWO ILLUSTRATIONS"
            )
            \Spacer(height: 11pt)
            \Text(
                width: parent.width,
                font: \Font(font: font, size: 8.8pt, italic: true),
                color: #111111,
                align: Align.Center,
                text: "BY JOHN TENNIEL."
            )
            \Spacer(height: 54pt)
            \Text(
                width: parent.width,
                font: \Font(font: font, size: 11pt, weight: 700),
                color: #111111,
                align: Align.Center,
                text: "Mexico City"
            )
            \Spacer(height: 11pt)
            \Text(
                width: parent.width,
                font: \Font(font: font, size: 9.5pt),
                color: #111111,
                align: Align.Center,
                text: "Typeset with DirectedType"
            )
            \Spacer(height: 10pt)
            \Text(
                width: parent.width,
                font: \Font(font: font, size: 9pt),
                color: #111111,
                align: Align.Center,
                text: "November 2026"
            )
        }

        // ============================================================
        // Page [iv] (Verso): Replacing the 1865 Printer's Imprint
        // ============================================================
        \Center(
            height: 377.2pt,
            pagination: \Pagination(breakable: false, break_before: Break.Verso)
        ) {
            \Text(
                width: parent.width * 0.75,
                font: \Font(font: font, size: 9pt, line_height: 13.5pt),
                color: #111111,
                align: Align.Justify
            ) {
                This book was digitally typeset using a new typesetting system
                called DirectedType and made to resemble the
                original Macmillan edition produced in London in 1865.
                The type is set in Old Standard TT which is a 2006 revival of
                late 19th-century academic typefaces.
            }
        }

        // ============================================================
        // Page [v] (Recto): Prefatory Poem — Stanzas 1 & 2
        // ============================================================
        \PoemBlock(pagination: \Pagination(breakable: false, break_before: Break.Recto)) {
            \Spacer(height: 33pt)
            \DoubleRule(rule_width: 56.25pt)
            \Spacer(height: 30pt)

            \VerseLine(indent: 0pt) { All in the golden afternoon }
            \VerseLine(indent: 11.2pt) { Full leisurely we glide; }
            \VerseLine(indent: 0pt) { For both our oars, with little skill, }
            \VerseLine(indent: 11.2pt) { By little arms are plied, }
            \VerseLine(indent: 0pt) { While little hands make vain pretence }
            \VerseLine(indent: 11.2pt) { Our wanderings to guide. }

            \Spacer(height: 42pt)

            \VerseLine(indent: 0pt) { Ah, cruel Three! In such an hour, }
            \VerseLine(indent: 11.2pt) { Beneath such dreamy weather, }
            \VerseLine(indent: 0pt) { To beg a tale of breath too weak }
            \VerseLine(indent: 11.2pt) { To stir the tiniest feather! }
            \VerseLine(indent: 0pt) { Yet what can one poor voice avail }
            \VerseLine(indent: 11.2pt) { Against three tongues together? }
        }

        // ============================================================
        // Page [vi] (Verso): Prefatory Poem — Stanzas 3, 4, & 5
        // ============================================================
        \PoemBlock(leading: 16.0pt, pagination: \Pagination(breakable: false, break_before: Break.Verso)) {
            \Spacer(height: 2pt)

            \VerseLine(indent: 0pt) { Imperious Prima flashes forth }
            \VerseLine(indent: 11.2pt) { Her edict ‘to begin it’— }
            \VerseLine(indent: 0pt) { In gentler tone Secunda hopes }
            \VerseLine(indent: 11.2pt) { ‘There will be nonsense in it!’— }
            \VerseLine(indent: 0pt) { While Tertia interrupts the tale }
            \VerseLine(indent: 11.2pt) { Not \Italic{more} than once a minute. }

            \Spacer(height: 42pt)

            \VerseLine(indent: 0pt) { Anon, to sudden silence won, }
            \VerseLine(indent: 11.2pt) { In fancy they pursue }
            \VerseLine(indent: 0pt) { The dream-child moving through a land }
            \VerseLine(indent: 11.2pt) { Of wonders wild and new, }
            \VerseLine(indent: 0pt) { In friendly chat with bird or beast— }
            \VerseLine(indent: 11.2pt) { And half believe it true. }

            \Spacer(height: 42pt)

            \VerseLine(indent: 0pt) { And ever, as the story drained }
            \VerseLine(indent: 11.2pt) { The wells of fancy dry, }
            \VerseLine(indent: 0pt) { And faintly strove that weary one }
            \VerseLine(indent: 11.2pt) { To put the subject by, }
            \VerseLine(indent: 0pt) { “The rest next time—” “It \Italic{is} next time!” }
            \VerseLine(indent: 11.2pt) { The happy voices cry. }
        }

        // ============================================================
        // Page [vii] (Recto): Prefatory Poem — Stanzas 6 & 7
        // ============================================================
        \PoemBlock(pagination: \Pagination(breakable: false, break_before: Break.Recto)) {
            \Spacer(height: 62pt)

            \VerseLine(indent: 0pt) { Thus grew the tale of Wonderland: }
            \VerseLine(indent: 11.2pt) { Thus slowly, one by one, }
            \VerseLine(indent: 0pt) { Its quaint events were hammered out— }
            \VerseLine(indent: 11.2pt) { And now the tale is done, }
            \VerseLine(indent: 0pt) { And home we steer, a merry crew, }
            \VerseLine(indent: 11.2pt) { Beneath the setting sun. }

            \Spacer(height: 42pt)

            \VerseLine(indent: 0pt) { Alice! a childish story take, }
            \VerseLine(indent: 11.2pt) { And with a gentle hand }
            \VerseLine(indent: 0pt) { Lay it where Childhood’s dreams are twined }
            \VerseLine(indent: 11.2pt) { In Memory’s mystic band, }
            \VerseLine(indent: 0pt) { Like pilgrim’s withered wreath of flowers }
            \VerseLine(indent: 11.2pt) { Plucked in a far-off land. }
        }

        // ============================================================
        // Page [viii] (Verso): Blank -> Page [ix] (Recto): CONTENTS.
        // ============================================================
        \VStackStretch(width: parent.width, gap: 0pt, pagination: \Pagination(breakable: false, break_before: Break.Recto)) {
            \Spacer(height: 36pt)
            \Text(
                width: parent.width,
                font: \Font(font: font, size: 12pt),
                color: #111111,
                align: Align.Center,
                text: "CONTENTS."
            )
            \Spacer(height: 44pt)

            // Column headers: CHAPTER / PAGE
            \ContentsHeaderRow()
            \Spacer(height: 15pt)

            \ContentsRow(roman: "I", title: "DOWN THE RABBIT-HOLE", dots: ".  .  .  .  .  .  .  .  .  .  .  .  .  .", page_num: "1")
            \ContentsRow(roman: "II", title: "THE POOL OF TEARS", dots: ".  .  .  .  .  .  .  .  .  .  .  .  .  .  .  .  .", page_num: "15")
            \ContentsRow(roman: "III", title: "A CAUCUS-RACE AND A LONG TALE", dots: ".  .  .  .  .  .  .  .", page_num: "29")
            \ContentsRow(roman: "IV", title: "THE RABBIT SENDS IN A LITTLE BILL", dots: ".  .  .  .  .  .", page_num: "41")
            \ContentsRow(roman: "V", title: "ADVICE FROM A CATERPILLAR", dots: ".  .  .  .  .  .  .  .  .  .  .", page_num: "59")
            \ContentsRow(roman: "VI", title: "PIG AND PEPPER", dots: ".  .  .  .  .  .  .  .  .  .  .  .  .  .  .  .  .  .  .", page_num: "67")
            \ContentsRow(roman: "VII", title: "A MAD TEA-PARTY", dots: ".  .  .  .  .  .  .  .  .  .  .  .  .  .  .  .  .  .", page_num: "95")
            \ContentsRow(roman: "VIII", title: "THE QUEEN’S CROQUET-GROUND", dots: ".  .  .  .  .  .  .  .  .  .", page_num: "112")
            \ContentsRow(roman: "IX", title: "THE MOCK TURTLE’S STORY", dots: ".  .  .  .  .  .  .  .  .  .  .  .  .", page_num: "130")
            \ContentsRow(roman: "X", title: "THE LOBSTER QUADRILLE", dots: ".  .  .  .  .  .  .  .  .  .  .  .  .  .", page_num: "147")
            \ContentsRow(roman: "XI", title: "WHO STOLE THE TARTS?", dots: ".  .  .  .  .  .  .  .  .  .  .  .  .  .  .", page_num: "162")
            \ContentsRow(roman: "XII", title: "ALICE’S EVIDENCE", dots: ".  .  .  .  .  .  .  .  .  .  .  .  .  .  .  .  .  .  .", page_num: "176")
        }
    };

    \alias right: Distance = x + width;
    \alias height: Distance = stack.height;
    \alias bottom: Distance = y + height;
}
