// Alice's Adventures in Wonderland — 1865 Macmillan Crown Octavo Stylesheet
// Page trim: 365pt x 540pt (5.07in x 7.50in Crown Octavo)
// Type block: 257.5pt (+3.0%) measure x 22 lines at 18.0pt leading (12pt Old Standard TT, 190 DPI engravings)

\use "components/Align.dt"
\use "components/TextBounds.dt"
\use "components/TextStart.dt"
\use "components/TextEnd.dt"
\use "components/VStackStretch.dt"
\use "components/Spacer.dt"
\use "components/Bold.dt"
\use "components/Italic.dt"

// Metadata deposited at each chapter start for running headers
\Component AliceChapterMeta(
    number: String,
    title: String,
    verso_header: String,
    recto_header: String,
    full_header: String = ""
) {}

// Marker deposited at the end of a chapter so closing pages follow 1865 header rules
\Component ChapterEndMeta(
    ended: Boolean = true
) {}

// Zero-height flow marker placed at the end of each chapter
\Component ChapterEnd(
    x: Distance = parent.left,
    y: Distance = parent.top,
    width: Distance = parent.width,
    env chapter_end_meta: PageValue
) {
    \Deposit(into: chapter_end_meta) {
        \ChapterEndMeta(ended: true)
    }
    \alias right: Distance = x + width;
    \alias height: Distance = 0pt;
    \alias bottom: Distance = y;
}

// Inline first-line paragraph indent (16pt in the 1865 Macmillan setting)
\InlineBox Indent(
    width: Distance = 16pt,
    x: Distance = parent.left,
    y: Distance = parent.top,
    env font: Font
) {
    \alias height: Distance = 0pt;
    \alias baseline: Distance = y;
}

// Inline thin space helper for 19th-century punctuation spacing where desired
\InlineBox ThinSpace(
    width: Distance = 1.5pt,
    x: Distance = parent.left,
    y: Distance = parent.top,
    env font: Font
) {
    \alias height: Distance = 0pt;
    \alias baseline: Distance = y;
}

// Continuous multi-em dash (default 2em) matching Old Standard TT's U+2014 stroke geometry
// (stroke thickness 0.036em, top at 0.28em above baseline, 0.06em outer sidebearings, zero internal gap)
\InlineBox DoubleEmDash(
    ems: Float = 2.0,
    sidebearing: Distance = 0.06em,
    thickness: Distance = 0.036em,
    top_above_baseline: Distance = 0.28em,
    color: Color = #111111,
    x: Distance = parent.left,
    y: Distance = parent.top,
    env font: Font
) {
    \let total_w = ems * 1em;

    \Rect(
        x: x + sidebearing,
        y: y,
        width: total_w - 2 * sidebearing,
        height: thickness,
        color: color
    )

    \alias width: Distance = total_w;
    \alias height: Distance = top_above_baseline;
    \alias baseline: Distance = y + top_above_baseline;
}

// Atomic non-breaking inline run (keeps a word, \DoubleEmDash{}, and closing quote together on one line)
\InlineBox NoBreak(
    color: Color = #111111,
    x: Distance = parent.left,
    y: Distance = parent.top,
    env font: Font
) {
    \let grid_bounds = \TextBounds(start_at: TextStart.LineHeight, end_at: TextEnd.LineHeight);
    \let t = \Text(x: x, y: y, font: font, color: color, text_bounds: grid_bounds) {
        \Children
    };

    \alias width: Distance = t.width;
    \alias height: Distance = t.height;
    \alias baseline: Distance = t.baseline;
}

// Inline Small Caps span (scales uppercase glyphs to match Victorian small-cap optical height)
\Span SmallCaps(env font: Font, scale: Float = 0.74) {
    \env font = \Font(font: self.font, size: self.font.size * scale);
    \Children
}

// Inline large initial cap for chapter openings (e.g. "A" in "ALICE")
\Span DropInitial(env font: Font, size: Distance = 17.5pt) {
    \env font = \Font(font: self.font, size: size);
    \Children
}

// Centered DPI-sized illustration block compatible with VStackStretch (uses embedded PNG pHYs DPI)
\Component CenteredPlate(
    src: Path,
    top_pad: Distance = 0pt,
    bottom_pad: Distance = 0pt,
    shift_x: Distance = 0pt,
    x: Distance = parent.left,
    y: Distance = parent.top,
    width: Distance = parent.width,
    pagination: Pagination = \Pagination(breakable: false)
) {
    \let img = \Image(
        src: src,
        x: x + (width - img.width) * 0.5 + shift_x,
        y: y + top_pad,
        dpi: img.file_dpi
    );

    \alias right: Distance = x + width;
    \alias height: Distance = top_pad + img.height + bottom_pad;
    \alias bottom: Distance = y + height;
}

// Top-of-page wood-engraving locked to an integer number of 18.0pt grid lines
\Component TopPlate(
    src: Path,
    grid_lines: Float,
    img_top: Distance = 4pt,
    shift_x: Distance = 0pt,
    break_before: Break = Break.Page,
    x: Distance = parent.left,
    y: Distance = parent.top,
    width: Distance = parent.width,
    pagination: Pagination = \Pagination(breakable: false, break_before: break_before, keep_with_next: true)
) {
    \let img = \Image(
        src: src,
        x: x + (width - img.width) * 0.5 + shift_x,
        y: y + img_top,
        dpi: img.file_dpi
    );

    \alias right: Distance = x + width;
    \alias height: Distance = grid_lines * 18.0pt;
    \alias bottom: Distance = y + height;
}

// Mid-page wood-engraving locked to an integer number of 18.0pt grid lines
\Component MidPlate(
    src: Path,
    grid_lines: Float,
    img_top: Distance = 9pt,
    shift_x: Distance = 0pt,
    x: Distance = parent.left,
    y: Distance = parent.top,
    width: Distance = parent.width,
    pagination: Pagination = \Pagination(breakable: false)
) {
    \let img = \Image(
        src: src,
        x: x + (width - img.width) * 0.5 + shift_x,
        y: y + img_top,
        dpi: img.file_dpi
    );

    \alias right: Distance = x + width;
    \alias height: Distance = grid_lines * 18.0pt;
    \alias bottom: Distance = y + height;
}

// Left-aligned wood-engraving with single narrow justified text block wrapped along its right side
\Component WrapLeft(
    src: Path,
    img_offset_x: Distance = 1pt,
    img_offset_y: Distance = 9pt,
    narrow_x: Distance = 180pt,
    align: Align = Align.JustifyAll,
    x: Distance = parent.left,
    y: Distance = parent.top,
    width: Distance = parent.width,
    pagination: Pagination = \Pagination(breakable: false),
    env font: Font
) {
    \let grid_bounds = \TextBounds(start_at: TextStart.LineHeight, end_at: TextEnd.LineHeight);
    \let img = \Image(
        src: src,
        x: x + img_offset_x,
        y: y + img_offset_y,
        dpi: img.file_dpi
    );

    \let t = \Text(
        x: x + narrow_x,
        y: y,
        width: width - narrow_x,
        font: font,
        color: #111111,
        align: align,
        text_bounds: grid_bounds
    ) {
        \Children
    };

    \alias right: Distance = x + width;
    \alias height: Distance = t.height;
    \alias bottom: Distance = y + height;
}

// Left-aligned wood-engraving with multi-paragraph VStackStretch along its right side
// Also handles L-shaped wraps:
//   - top_blank_lines > 0 reserves full-width canopy above the right column (p. 91 Cheshire Cat tree)
//   - min_grid_lines > 0 extends total height below the right column (p. 186 King & Tart Table)
\Component WrapLeftStack(
    src: Path,
    img_offset_x: Distance = 0pt,
    img_offset_y: Distance = 6pt,
    narrow_x: Distance = 156pt,
    top_blank_lines: Float = 0.0,
    min_grid_lines: Float = 0.0,
    break_before: Break = Break.Auto,
    x: Distance = parent.left,
    y: Distance = parent.top,
    width: Distance = parent.width,
    pagination: Pagination = \Pagination(breakable: false, break_before: break_before),
    env font: Font
) {
    \let img = \Image(
        src: src,
        x: x + img_offset_x,
        y: y + img_offset_y,
        dpi: img.file_dpi
    );

    \let top_pad = top_blank_lines * 18.0pt;
    \let col = \VStackStretch(
        x: x + narrow_x,
        y: y + top_pad,
        width: width - narrow_x,
        gap: 0pt,
        pagination: \Pagination(breakable: false)
    ) {
        \Children
    };

    \let natural_h = top_pad + col.height;
    \let min_h = min_grid_lines * 18.0pt;

    \alias right: Distance = x + width;
    \alias height: Distance = natural_h > min_h ? natural_h : min_h;
    \alias bottom: Distance = y + height;
}

// Right-aligned wood-engraving with narrow justified text wrapped along its left side
\Component WrapRight(
    src: Path,
    img_right_bleed: Distance = 4pt,
    img_offset_y: Distance = 7pt,
    narrow_width: Distance = 113pt,
    align: Align = Align.JustifyAll,
    x: Distance = parent.left,
    y: Distance = parent.top,
    width: Distance = parent.width,
    pagination: Pagination = \Pagination(breakable: false),
    env font: Font
) {
    \let grid_bounds = \TextBounds(start_at: TextStart.LineHeight, end_at: TextEnd.LineHeight);
    \let img = \Image(
        src: src,
        x: x + width + img_right_bleed - img.width,
        y: y + img_offset_y,
        dpi: img.file_dpi
    );

    \let t = \Text(
        x: x,
        y: y,
        width: narrow_width,
        font: font,
        color: #111111,
        align: align,
        text_bounds: grid_bounds
    ) {
        \Children
    };

    \alias right: Distance = x + width;
    \alias height: Distance = t.height;
    \alias bottom: Distance = y + height;
}

// Staggered 4-3-4 asterisk transformation break occupying exact 3 grid lines (3 * 18.0pt = 54.0pt)
\Component Asterism(
    step: Distance = 64pt,
    line_step: Distance = 18.0pt,
    star_drop: Distance = 3.5pt,
    x: Distance = parent.left,
    y: Distance = parent.top,
    width: Distance = parent.width,
    pagination: Pagination = \Pagination(breakable: false),
    env font: Font
) {
    \let grid_bounds = \TextBounds(start_at: TextStart.LineHeight, end_at: TextEnd.LineHeight);
    \let cx = x + width * 0.5;
    \let row1_y = y + star_drop;
    \let row2_y = y + line_step + star_drop;
    \let row3_y = y + line_step * 2.0 + star_drop;

    // Row 1: 4 stars at -1.5, -0.5, +0.5, +1.5 * step
    \Text(x: cx - step * 1.5 - 4pt, y: row1_y, width: 8pt, font: font, color: #111111, align: Align.Center, text_bounds: grid_bounds, text: "*")
    \Text(x: cx - step * 0.5 - 4pt, y: row1_y, width: 8pt, font: font, color: #111111, align: Align.Center, text_bounds: grid_bounds, text: "*")
    \Text(x: cx + step * 0.5 - 4pt, y: row1_y, width: 8pt, font: font, color: #111111, align: Align.Center, text_bounds: grid_bounds, text: "*")
    \Text(x: cx + step * 1.5 - 4pt, y: row1_y, width: 8pt, font: font, color: #111111, align: Align.Center, text_bounds: grid_bounds, text: "*")

    // Row 2: 3 stars staggered at -1.0, 0.0, +1.0 * step
    \Text(x: cx - step - 4pt, y: row2_y, width: 8pt, font: font, color: #111111, align: Align.Center, text_bounds: grid_bounds, text: "*")
    \Text(x: cx - 4pt, y: row2_y, width: 8pt, font: font, color: #111111, align: Align.Center, text_bounds: grid_bounds, text: "*")
    \Text(x: cx + step - 4pt, y: row2_y, width: 8pt, font: font, color: #111111, align: Align.Center, text_bounds: grid_bounds, text: "*")

    // Row 3: 4 stars at -1.5, -0.5, +0.5, +1.5 * step
    \Text(x: cx - step * 1.5 - 4pt, y: row3_y, width: 8pt, font: font, color: #111111, align: Align.Center, text_bounds: grid_bounds, text: "*")
    \Text(x: cx - step * 0.5 - 4pt, y: row3_y, width: 8pt, font: font, color: #111111, align: Align.Center, text_bounds: grid_bounds, text: "*")
    \Text(x: cx + step * 0.5 - 4pt, y: row3_y, width: 8pt, font: font, color: #111111, align: Align.Center, text_bounds: grid_bounds, text: "*")
    \Text(x: cx + step * 1.5 - 4pt, y: row3_y, width: 8pt, font: font, color: #111111, align: Align.Center, text_bounds: grid_bounds, text: "*")

    \alias right: Distance = x + width;
    \alias height: Distance = line_step * 3.0;
    \alias bottom: Distance = y + height;
}

// Staggered 5-4-5 asterisk break on p. 69 occupying exact 3 grid lines
\Component Asterism545(
    step: Distance = 52pt,
    line_step: Distance = 18.0pt,
    star_drop: Distance = 3.5pt,
    x: Distance = parent.left,
    y: Distance = parent.top,
    width: Distance = parent.width,
    pagination: Pagination = \Pagination(breakable: false),
    env font: Font
) {
    \let grid_bounds = \TextBounds(start_at: TextStart.LineHeight, end_at: TextEnd.LineHeight);
    \let cx = x + width * 0.5;
    \let row1_y = y + star_drop;
    \let row2_y = y + line_step + star_drop;
    \let row3_y = y + line_step * 2.0 + star_drop;

    // Row 1: 5 stars
    \Text(x: cx - step * 2.0 - 4pt, y: row1_y, width: 8pt, font: font, color: #111111, align: Align.Center, text_bounds: grid_bounds, text: "*")
    \Text(x: cx - step * 1.0 - 4pt, y: row1_y, width: 8pt, font: font, color: #111111, align: Align.Center, text_bounds: grid_bounds, text: "*")
    \Text(x: cx - 4pt,              y: row1_y, width: 8pt, font: font, color: #111111, align: Align.Center, text_bounds: grid_bounds, text: "*")
    \Text(x: cx + step * 1.0 - 4pt, y: row1_y, width: 8pt, font: font, color: #111111, align: Align.Center, text_bounds: grid_bounds, text: "*")
    \Text(x: cx + step * 2.0 - 4pt, y: row1_y, width: 8pt, font: font, color: #111111, align: Align.Center, text_bounds: grid_bounds, text: "*")

    // Row 2: 4 stars
    \Text(x: cx - step * 1.5 - 4pt, y: row2_y, width: 8pt, font: font, color: #111111, align: Align.Center, text_bounds: grid_bounds, text: "*")
    \Text(x: cx - step * 0.5 - 4pt, y: row2_y, width: 8pt, font: font, color: #111111, align: Align.Center, text_bounds: grid_bounds, text: "*")
    \Text(x: cx + step * 0.5 - 4pt, y: row2_y, width: 8pt, font: font, color: #111111, align: Align.Center, text_bounds: grid_bounds, text: "*")
    \Text(x: cx + step * 1.5 - 4pt, y: row2_y, width: 8pt, font: font, color: #111111, align: Align.Center, text_bounds: grid_bounds, text: "*")

    // Row 3: 5 stars
    \Text(x: cx - step * 2.0 - 4pt, y: row3_y, width: 8pt, font: font, color: #111111, align: Align.Center, text_bounds: grid_bounds, text: "*")
    \Text(x: cx - step * 1.0 - 4pt, y: row3_y, width: 8pt, font: font, color: #111111, align: Align.Center, text_bounds: grid_bounds, text: "*")
    \Text(x: cx - 4pt,              y: row3_y, width: 8pt, font: font, color: #111111, align: Align.Center, text_bounds: grid_bounds, text: "*")
    \Text(x: cx + step * 1.0 - 4pt, y: row3_y, width: 8pt, font: font, color: #111111, align: Align.Center, text_bounds: grid_bounds, text: "*")
    \Text(x: cx + step * 2.0 - 4pt, y: row3_y, width: 8pt, font: font, color: #111111, align: Align.Center, text_bounds: grid_bounds, text: "*")

    \alias right: Distance = x + width;
    \alias height: Distance = line_step * 3.0;
    \alias bottom: Distance = y + height;
}

// Standard justified body paragraph locked to the 18.0pt baseline grid with 16pt first-line indent
\Component Para(
    indent: Distance = 16pt,
    align: Align = Align.Justify,
    x: Distance = parent.left,
    y: Distance = parent.top,
    width: Distance = parent.width,
    pagination: Pagination = \Pagination(breakable: true),
    env font: Font
) {
    \let grid_bounds = \TextBounds(start_at: TextStart.LineHeight, end_at: TextEnd.LineHeight);
    \let t = \Text(
        x: x,
        y: y,
        width: width,
        font: font,
        color: #111111,
        align: align,
        text_bounds: grid_bounds,
        pagination: \Pagination(breakable: true)
    ) {
        \Indent(width: indent)//
        \Children
    };

    \alias right: Distance = x + width;
    \alias height: Distance = t.height;
    \alias bottom: Distance = y + height;
}

// Flush-left paragraph (used for chapter openings and continuations after display/wrap blocks)
\Component FlushPara(
    align: Align = Align.Justify,
    x: Distance = parent.left,
    y: Distance = parent.top,
    width: Distance = parent.width,
    pagination: Pagination = \Pagination(breakable: true),
    env font: Font
) {
    \let grid_bounds = \TextBounds(start_at: TextStart.LineHeight, end_at: TextEnd.LineHeight);
    \let t = \Text(
        x: x,
        y: y,
        width: width,
        font: font,
        color: #111111,
        align: align,
        text_bounds: grid_bounds,
        pagination: \Pagination(breakable: true)
    ) {
        \Children
    };

    \alias right: Distance = x + width;
    \alias height: Distance = t.height;
    \alias bottom: Distance = y + height;
}

// Centered double ornamental rule (used above the prefatory poem and on p. 190)
\Component DoubleRule(
    rule_width: Distance = 56.25pt,
    gap: Distance = 2.5pt,
    thickness: Distance = 0.5pt,
    x: Distance = parent.left,
    y: Distance = parent.top,
    width: Distance = parent.width,
    pagination: Pagination = \Pagination(breakable: false)
) {
    \let rx = x + (width - rule_width) * 0.5;
    \Rect(x: rx, y: y, width: rule_width, height: thickness, color: #111111)
    \Rect(x: rx, y: y + thickness + gap, width: rule_width, height: thickness, color: #111111)

    \alias right: Distance = x + width;
    \alias height: Distance = thickness * 2.0 + gap;
    \alias bottom: Distance = y + height;
}

// Unbreakable poem page container that scopes 10pt verse font and leading to its children
\Component PoemBlock(
    size: Distance = 10pt,
    leading: Distance = 16.5pt,
    italic: Boolean = false,
    break_before: Break = Break.Auto,
    x: Distance = parent.left,
    y: Distance = parent.top,
    width: Distance = parent.width,
    pagination: Pagination = \Pagination(breakable: false, break_before: break_before),
    env font: Font
) {
    \env font = \Font(font: self.font, size: size, line_height: leading, italic: italic);
    \let stack = \VStackStretch(x: x, y: y, width: width, gap: 0pt, pagination: \Pagination(breakable: false)) {
        \Children
    };

    \alias right: Distance = x + width;
    \alias height: Distance = stack.height;
    \alias bottom: Distance = y + height;
}

// Single verse line for poems and songs
\Component VerseLine(
    indent: Distance = 0pt,
    left_margin: Distance = 36pt,
    x: Distance = parent.left,
    y: Distance = parent.top,
    width: Distance = parent.width,
    pagination: Pagination = \Pagination(breakable: false),
    env font: Font
) {
    \let grid_bounds = \TextBounds(start_at: TextStart.LineHeight, end_at: TextEnd.LineHeight);
    \let t = \Text(
        x: x + left_margin + indent,
        y: y,
        width: width - left_margin - indent,
        font: font,
        color: #111111,
        text_bounds: grid_bounds
    ) {
        \Children
    };

    \alias right: Distance = x + width;
    \alias height: Distance = t.height;
    \alias bottom: Distance = y + height;
}

// Unbreakable chapter header block (illustration + CHAPTER N. + subtitle) sized to leave exact opening lines
\Component ChapterImageHeader(
    number: String,
    title: String,
    img_src: Path,
    total_height: Distance = 306.0pt,
    img_top: Distance = 8pt,
    ch_gap: Distance = 16pt,
    sub_gap: Distance = 22pt,
    x: Distance = parent.left,
    y: Distance = parent.top,
    width: Distance = parent.width,
    pagination: Pagination = \Pagination(breakable: false, keep_with_next: true),
    env font: Font
) {
    \let art = \Image(
        src: img_src,
        x: x + (width - art.width) * 0.5,
        y: y + img_top,
        dpi: art.file_dpi
    );

    \let ch_label = \Text(
        x: x,
        y: art.bottom + ch_gap,
        width: width,
        font: \Font(font: font, size: 12.5pt),
        color: #111111,
        align: Align.Center,
        text: "CHAPTER " + number + "."
    );

    \Text(
        x: x,
        y: ch_label.bottom + sub_gap,
        width: width,
        font: \Font(font: font, size: 8.25pt),
        color: #111111,
        align: Align.Center,
        text: title + "."
    )

    \alias right: Distance = x + width;
    \alias height: Distance = total_height;
    \alias bottom: Distance = y + height;
}

// Unbreakable plain chapter header block (CHAPTER N. + subtitle without illustration)
\Component ChapterPlainHeader(
    number: String,
    title: String,
    title_punct: String = ".",
    grid_lines: Float = 10.0,
    ch_top: Distance = 118pt,
    sub_gap: Distance = 19pt,
    x: Distance = parent.left,
    y: Distance = parent.top,
    width: Distance = parent.width,
    pagination: Pagination = \Pagination(breakable: false, keep_with_next: true),
    env font: Font
) {
    \let ch_label = \Text(
        x: x,
        y: y + ch_top,
        width: width,
        font: \Font(font: font, size: 12.5pt),
        color: #111111,
        align: Align.Center,
        text: "CHAPTER " + number + "."
    );

    \Text(
        x: x,
        y: ch_label.bottom + sub_gap,
        width: width,
        font: \Font(font: font, size: 8.25pt),
        color: #111111,
        align: Align.Center,
        text: title + title_punct
    )

    \alias right: Distance = x + width;
    \alias height: Distance = grid_lines * 18.0pt;
    \alias bottom: Distance = y + height;
}

// Chapter II full-height side-wrapped chapter opener (Giant stretched Alice on left, title + 17 lines on right)
\Component ChapterSideOpener(
    number: String,
    title: String,
    img_src: Path,
    img_offset_x: Distance = -4pt,
    narrow_x: Distance = 149pt,
    x: Distance = parent.left,
    y: Distance = parent.top,
    width: Distance = parent.width,
    pagination: Pagination = \Pagination(breakable: false),
    env font: Font
) {
    \let grid_bounds = \TextBounds(start_at: TextStart.LineHeight, end_at: TextEnd.LineHeight);
    \let col_w = width - narrow_x;

    \let img = \Image(
        src: img_src,
        x: x + img_offset_x,
        y: y + 21pt,
        dpi: img.file_dpi
    );

    \Text(
        x: x + narrow_x,
        y: y + 17pt,
        width: col_w,
        font: \Font(font: font, size: 12.5pt),
        color: #111111,
        align: Align.Center,
        text: "CHAPTER " + number + "."
    )

    \Text(
        x: x + narrow_x,
        y: y + 55pt,
        width: col_w,
        font: \Font(font: font, size: 8.25pt),
        color: #111111,
        align: Align.Center,
        text: title + "."
    )

    \let t = \Text(
        x: x + narrow_x,
        y: y + 90.0pt,
        width: col_w,
        font: font,
        color: #111111,
        align: Align.JustifyAll,
        text_bounds: grid_bounds
    ) {
        \Indent(width: 16pt)//
        \Children
    };

    \alias right: Distance = x + width;
    \alias height: Distance = 22.0 * 18.0pt;
    \alias bottom: Distance = y + height;
}

// Generic Chapter container (deposits chapter running-header metadata and flows chapter blocks)
\Component AliceChapter(
    number: String,
    title: String,
    verso_header: String,
    recto_header: String,
    full_header: String = "",
    break_before: Break = Break.Page,
    x: Distance = parent.left,
    y: Distance = parent.top,
    width: Distance = parent.width,
    pagination: Pagination = \Pagination(breakable: true, break_before: break_before),
    env font: Font,
    env chapter_meta: PageValue
) {
    \let eff_full = full_header != "" ? full_header : (title + ".");
    \Deposit(into: chapter_meta) {
        \AliceChapterMeta(
            number: number,
            title: title,
            verso_header: verso_header,
            recto_header: recto_header,
            full_header: eff_full
        )
    }

    \let body = \VStackStretch(
        x: x,
        y: y,
        width: width,
        gap: 0pt,
        pagination: \Pagination(breakable: true)
    ) {
        \Children
    };

    \alias right: Distance = x + width;
    \alias height: Distance = body.height;
    \alias bottom: Distance = y + height;
}

// Chapter container with top Tenniel wood-engraving (Chapters I, III, V)
\Component AliceChapterWithImage(
    number: String,
    title: String,
    verso_header: String,
    recto_header: String,
    img_src: Path,
    header_height: Distance = 306.0pt,
    img_top: Distance = 8pt,
    ch_gap: Distance = 16pt,
    sub_gap: Distance = 22pt,
    break_before: Break = Break.Page,
    x: Distance = parent.left,
    y: Distance = parent.top,
    width: Distance = parent.width,
    pagination: Pagination = \Pagination(breakable: true, break_before: break_before),
    env font: Font,
    env chapter_meta: PageValue
) {
    \Deposit(into: chapter_meta) {
        \AliceChapterMeta(
            number: number,
            title: title,
            verso_header: verso_header,
            recto_header: recto_header,
            full_header: title + "."
        )
    }

    \let hdr = \ChapterImageHeader(
        x: x,
        y: y,
        width: width,
        number: number,
        title: title,
        img_src: img_src,
        total_height: header_height,
        img_top: img_top,
        ch_gap: ch_gap,
        sub_gap: sub_gap
    );

    \let body = \VStackStretch(
        x: x,
        y: hdr.bottom,
        width: width,
        gap: 0pt,
        pagination: \Pagination(breakable: true)
    ) {
        \Children
    };

    \alias right: Distance = x + width;
    \alias height: Distance = hdr.height + body.height;
    \alias bottom: Distance = y + height;
}

// Chapter container without top illustration (Chapters IV, VI, VII, VIII, IX, X, XI, XII)
\Component AliceChapterPlain(
    number: String,
    title: String,
    title_punct: String = ".",
    verso_header: String,
    recto_header: String,
    full_header: String = "",
    header_lines: Float = 10.0,
    ch_top: Distance = 118pt,
    sub_gap: Distance = 19pt,
    break_before: Break = Break.Page,
    x: Distance = parent.left,
    y: Distance = parent.top,
    width: Distance = parent.width,
    pagination: Pagination = \Pagination(breakable: true, break_before: break_before),
    env font: Font,
    env chapter_meta: PageValue
) {
    \let eff_full = full_header != "" ? full_header : (title + title_punct);
    \Deposit(into: chapter_meta) {
        \AliceChapterMeta(
            number: number,
            title: title,
            verso_header: verso_header,
            recto_header: recto_header,
            full_header: eff_full
        )
    }

    \let hdr = \ChapterPlainHeader(
        x: x,
        y: y,
        width: width,
        number: number,
        title: title,
        title_punct: title_punct,
        grid_lines: header_lines,
        ch_top: ch_top,
        sub_gap: sub_gap
    );

    \let body = \VStackStretch(
        x: x,
        y: hdr.bottom,
        width: width,
        gap: 0pt,
        pagination: \Pagination(breakable: true)
    ) {
        \Children
    };

    \alias right: Distance = x + width;
    \alias height: Distance = hdr.height + body.height;
    \alias bottom: Distance = y + height;
}

// 1865 Macmillan Crown Octavo Page Template
\Component AlicePage(
    width: Distance = 365pt,
    height: Distance = 540pt,
    x: Distance = page.left,
    y: Distance = page.top,
    margin_inner: Distance = 53.0pt,
    margin_outer: Distance = 54.5pt,
    header_y: Distance = 50.0pt,
    body_top: Distance = 67.4pt,
    flow_height: Distance = 397.0pt,
    folio_offset: Integer = 10,
    page_bg: Color = #fdfcf8,
    env font: Font,
    env chapter_meta: PageValue,
    env chapter_end_meta: PageValue
) {
    \let body_width = width - margin_inner - margin_outer;
    \let is_verso = page.is_verso;
    \let body_x = is_verso ? (x + margin_outer) : (x + margin_inner);
    \let folio = page.number - folio_offset;

    \let has_chapter_start = chapter_meta[page].has_value;
    \alias did_start_chapter: Boolean = has_chapter_start;
    \alias running_verso: String = has_chapter_start
        ? chapter_meta[page].value.verso_header
        : (page.prev ? page.prev.running_verso : "");
    \alias running_recto: String = has_chapter_start
        ? chapter_meta[page].value.recto_header
        : (page.prev ? page.prev.running_recto : "");
    \alias running_full: String = has_chapter_start
        ? chapter_meta[page].value.full_header
        : (page.prev ? page.prev.running_full : "");

    \alias right: Distance = x + width;
    \alias bottom: Distance = y + height;

    // Cream paper ground
    \Rect(
        x: x,
        y: y,
        width: width,
        height: height,
        color: page_bg
    )

    // 1866 Macmillan Running Header & Folio Conventions:
    // 1. Chapter-start pages suppress both running title and folio.
    // 2. Closing dream sequence (pp. 190–192) suppresses running title and centers bare folio.
    // 3. Recto page immediately facing a verso chapter-opener (pp. 113, 131, 163, 177) prints full_header.
    // 4. Verso chapter-end pages (pp. 14, 28, 40, 58, 94, 146) & p. 161 print full_header;
    //    recto chapter-end pages (pp. 75, 111, 129, 175) complete the spread with recto_header.
    // 5. All non-chapter-start body pages print their folio (no suppressed folios).
    \let is_dream_page = folio >= 190 && folio <= 192;
    \let is_body_page = folio >= 1 && folio <= 189;
    \let show_header = is_body_page && !has_chapter_start && running_verso != "";
    \let is_chapter_end = chapter_end_meta[page].has_value;
    \let prev_was_chapter_start = page.prev ? page.prev.did_start_chapter : false;
    \let use_full_header = (is_chapter_end && (is_verso || folio == 161)) || (!is_verso && prev_was_chapter_start);

    \let header_title = show_header
        ? (use_full_header ? running_full : (is_verso ? running_verso : running_recto))
        : "";
    \let folio_text = is_dream_page
        ? ("" + folio)
        : (show_header ? ("" + folio) : "");
    \let folio_align = is_dream_page ? Align.Center : (is_verso ? Align.Left : Align.Right);

    \let hdr_font = \Font(font: font, size: 8.25pt, line_height: 10pt);
    \let folio_font = \Font(font: font, size: 8pt, line_height: 10pt);

    \Text(
        x: body_x,
        y: y + header_y,
        width: body_width,
        font: hdr_font,
        color: #111111,
        align: Align.Center,
        text: header_title
    )

    \Text(
        x: body_x,
        y: y + header_y + 0.3pt,
        width: body_width,
        font: folio_font,
        color: #111111,
        align: folio_align,
        text: folio_text
    )

    // 22-line body region (22 * 18.0pt = 396.0pt)
    \FlowBody(
        x: body_x,
        y: y + body_top,
        width: body_width,
        height: flow_height
    )

    // 1866 8-page half-sheet Crown Octavo signature marks in the bottom margin
    // (italic "b" on Prefatory Poem p. 3 [vii]; "B".."Z", "A A", "B B" every 8 pages skipping J, V, W)
    \let offset_in_gathering = (folio - 1) % 8;
    \let gathering = ((folio - 1) - offset_in_gathering) / 8;
    \let sig_letter = gathering == 0 ? "B"
        : (gathering == 1 ? "C"
        : (gathering == 2 ? "D"
        : (gathering == 3 ? "E"
        : (gathering == 4 ? "F"
        : (gathering == 5 ? "G"
        : (gathering == 6 ? "H"
        : (gathering == 7 ? "I"
        : (gathering == 8 ? "K"
        : (gathering == 9 ? "L"
        : (gathering == 10 ? "M"
        : (gathering == 11 ? "N"
        : (gathering == 12 ? "O"
        : (gathering == 13 ? "P"
        : (gathering == 14 ? "Q"
        : (gathering == 15 ? "R"
        : (gathering == 16 ? "S"
        : (gathering == 17 ? "T"
        : (gathering == 18 ? "U"
        : (gathering == 19 ? "X"
        : (gathering == 20 ? "Y"
        : (gathering == 21 ? "Z"
        : (gathering == 22 ? "A A"
        : (gathering == 23 ? "B B" : "")))))))))))))))))))))));
    \let is_prelim_sig = folio == -3;
    \let sig_text = is_prelim_sig
        ? "b"
        : ((folio >= 1 && folio <= 192 && offset_in_gathering == 0) ? sig_letter : "");
    \let sig_font = \Font(font: folio_font, italic: is_prelim_sig);

    \Text(
        x: body_x,
        y: y + body_top + 396.0pt + 8.5pt,
        width: body_width,
        font: sig_font,
        color: #111111,
        align: Align.Center,
        text: sig_text
    )
}

// Top-level Alice Book wrapper
\Component AliceBook(
    folio_offset: Integer = 10,
    start_page: Integer = 1,
    page_gap: Distance = 12pt,
    x: Distance = parent.left,
    y: Distance = parent.top,
    font_size: Distance = 12.0pt,
    line_height: Distance = 18.0pt
) {
    \let body_font = \Font(family: "Old Standard TT", size: font_size, line_height: line_height);
    \env font = body_font;
    \env chapter_meta = \PageValue();
    \env chapter_end_meta = \PageValue();

    \let flow = \PagedFlow(
        x: x,
        y: y,
        gap: page_gap,
        orphans: 1,
        widows: 1,
        start_page: start_page,
        page: \AlicePage(folio_offset: folio_offset)
    ) {
        \VStackStretch(
            width: 257.5pt,
            gap: 0pt,
            pagination: \Pagination(breakable: true)
        ) {
            \Children
        }
    };

    \alias page_count: Integer = flow.page_count;
    \alias end_page: Integer = flow.end_page;
    \alias width: Distance = flow.width;
    \alias height: Distance = flow.height;
    \alias right: Distance = x + width;
    \alias bottom: Distance = y + height;
}
