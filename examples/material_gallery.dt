// DirectedType Material UI Component Gallery
// Interactive showcase of @mui/material components reimplemented for DirectedType.

\use "../components/Align.dt"
\use "../components/VStack.dt"
\use "../components/HStack.dt"
\use "../components/Center.dt"
\use "../components/Spacer.dt"
\use "../components/material/Palette.dt"
\use "../components/material/Button.dt"
\use "../components/material/Paper.dt"
\use "../components/material/Divider.dt"
\use "../components/material/Typography.dt"
\use "../components/material/Card.dt"
\use "../components/material/Avatar.dt"
\use "../components/material/Chip.dt"
\use "../components/material/Switch.dt"
\use "../components/material/Checkbox.dt"
\use "../components/material/Radio.dt"
\use "../components/material/List.dt"
\use "../components/material/AppBar.dt"
\use "../components/material/Tabs.dt"
\use "../components/material/Slider.dt"

\Window(title: "Material UI Component Gallery")

// Background Canvas (Material grey[100])
\Rect(
    x: 0,
    y: 0,
    width: max(window.width, page.right + 40px),
    height: max(window.height, page.bottom + 40px),
    color: #f5f5f5
)

\let target_inner_width = min(max(0, window.width - 120px), 840px);

// Main Gallery Layout
\let page = \VStack(
    x: 40px,
    y: 36px,
    gap: 16px
) {
    // Header
    \H5(color: material_primary.main) {
        Material UI Component Gallery
    }

    \Body2(color: material_text_secondary) {
        Interactive showcase of @mui/material components — hover, focus, and click components to see state transitions.
    }

    \Divider
    \Spacer(height: 4px)

    // Section 1: Basic Button Variants
    \Paper("card_basic_variants"; elevation: 1, radius: 8px, padding_x: 20px, padding_y: 20px) {
        \VStack(min_width: target_inner_width, gap: 12px) {
            \Subtitle2(color: material_text_secondary) {
                1. BUTTON VARIANTS (TEXT, CONTAINED, OUTLINED & DISABLED)
            }
            \HStack(gap: 12px, align: Align.Center) {
                \Button("basic_text";) { Text }
                \Button("basic_contained"; variant: ButtonVariant.Contained) { Contained }
                \Button("basic_outlined"; variant: ButtonVariant.Outlined) { Outlined }
                \Button("basic_disabled_text"; disabled: true) { Disabled Text }
                \Button("basic_disabled_contained"; variant: ButtonVariant.Contained, disabled: true) { Disabled Contained }
                \Button("basic_disabled_outlined"; variant: ButtonVariant.Outlined, disabled: true) { Disabled Outlined }
            }
        }
    }

    // Section 2: Semantic Palette Colors (Contained)
    \Paper("card_contained_colors"; elevation: 1, radius: 8px, padding_x: 20px, padding_y: 20px) {
        \VStack(min_width: target_inner_width, gap: 12px) {
            \Subtitle2(color: material_text_secondary) {
                2. CONTAINED PALETTE COLORS
            }
            \HStack(gap: 12px, align: Align.Center) {
                \Button("c_primary"; variant: ButtonVariant.Contained, color: MaterialColor.Primary, label: "Primary")
                \Button("c_secondary"; variant: ButtonVariant.Contained, color: MaterialColor.Secondary, label: "Secondary")
                \Button("c_success"; variant: ButtonVariant.Contained, color: MaterialColor.Success, label: "Success")
                \Button("c_error"; variant: ButtonVariant.Contained, color: MaterialColor.Error, label: "Error")
                \Button("c_info"; variant: ButtonVariant.Contained, color: MaterialColor.Info, label: "Info")
                \Button("c_warning"; variant: ButtonVariant.Contained, color: MaterialColor.Warning, label: "Warning")
                \Button("c_inherit"; variant: ButtonVariant.Contained, color: MaterialColor.Inherit, label: "Inherit")
            }
        }
    }

    // Section 3: Semantic Palette Colors (Outlined & Text)
    \Paper("card_outlined_text_colors"; elevation: 1, radius: 8px, padding_x: 20px, padding_y: 20px) {
        \VStack(min_width: target_inner_width, gap: 12px) {
            \Subtitle2(color: material_text_secondary) {
                3. OUTLINED & TEXT PALETTE COLORS
            }
            \HStack(gap: 12px, align: Align.Center) {
                \Button("o_primary"; variant: ButtonVariant.Outlined, color: MaterialColor.Primary) { Primary }
                \Button("o_secondary"; variant: ButtonVariant.Outlined, color: MaterialColor.Secondary) { Secondary }
                \Button("o_success"; variant: ButtonVariant.Outlined, color: MaterialColor.Success) { Success }
                \Button("o_error"; variant: ButtonVariant.Outlined, color: MaterialColor.Error) { Error }
                \Button("o_info"; variant: ButtonVariant.Outlined, color: MaterialColor.Info) { Info }
                \Button("o_warning"; variant: ButtonVariant.Outlined, color: MaterialColor.Warning) { Warning }
                \Button("o_inherit"; variant: ButtonVariant.Outlined, color: MaterialColor.Inherit) { Inherit }
            }
            \HStack(gap: 12px, align: Align.Center) {
                \Button("t_primary"; variant: ButtonVariant.Text, color: MaterialColor.Primary) { Primary }
                \Button("t_secondary"; variant: ButtonVariant.Text, color: MaterialColor.Secondary) { Secondary }
                \Button("t_success"; variant: ButtonVariant.Text, color: MaterialColor.Success) { Success }
                \Button("t_error"; variant: ButtonVariant.Text, color: MaterialColor.Error) { Error }
                \Button("t_info"; variant: ButtonVariant.Text, color: MaterialColor.Info) { Info }
                \Button("t_warning"; variant: ButtonVariant.Text, color: MaterialColor.Warning) { Warning }
                \Button("t_inherit"; variant: ButtonVariant.Text, color: MaterialColor.Inherit) { Inherit }
            }
        }
    }

    // Section 4: Button Sizes (Small 30px, Medium 36px, Large 42px)
    \Paper("card_sizes"; elevation: 1, radius: 8px, padding_x: 20px, padding_y: 20px) {
        \VStack(min_width: target_inner_width, gap: 12px) {
            \Subtitle2(color: material_text_secondary) {
                4. BUTTON SIZES (SMALL, MEDIUM, LARGE)
            }
            \HStack(gap: 12px, align: Align.Center) {
                \Button("sz_t_sm"; variant: ButtonVariant.Text, size: ButtonSize.Small) { Small }
                \Button("sz_t_md"; variant: ButtonVariant.Text, size: ButtonSize.Medium) { Medium }
                \Button("sz_t_lg"; variant: ButtonVariant.Text, size: ButtonSize.Large) { Large }
                \Spacer(width: 8px)
                \Button("sz_o_sm"; variant: ButtonVariant.Outlined, size: ButtonSize.Small) { Small }
                \Button("sz_o_md"; variant: ButtonVariant.Outlined, size: ButtonSize.Medium) { Medium }
                \Button("sz_o_lg"; variant: ButtonVariant.Outlined, size: ButtonSize.Large) { Large }
                \Spacer(width: 8px)
                \Button("sz_c_sm"; variant: ButtonVariant.Contained, size: ButtonSize.Small) { Small }
                \Button("sz_c_md"; variant: ButtonVariant.Contained, size: ButtonSize.Medium) { Medium }
                \Button("sz_c_lg"; variant: ButtonVariant.Contained, size: ButtonSize.Large) { Large }
            }
        }
    }

    // Section 5: Intrinsic Min-Width vs Fixed Width Override
    \Paper("card_widths"; elevation: 1, radius: 8px, padding_x: 20px, padding_y: 20px) {
        \VStack(min_width: target_inner_width, gap: 12px) {
            \Subtitle2(color: material_text_secondary) {
                5. INTRINSIC SIZING (64PX MIN-WIDTH) VS EXPLICIT WIDTH
            }
            \HStack(gap: 12px, align: Align.Center) {
                \Button("w_short"; variant: ButtonVariant.Contained) { OK }
                \Button("w_auto"; variant: ButtonVariant.Contained, color: MaterialColor.Secondary) { Auto-Sized to Label }
                \Button("w_fixed"; width: 220px, variant: ButtonVariant.Outlined, color: MaterialColor.Primary) { Explicit Width (220px) }
            }
        }
    }

    // Section 6: Paper Elevations
    \Paper("card_paper_elevations"; elevation: 1, radius: 8px, padding_x: 20px, padding_y: 20px) {
        \VStack(min_width: target_inner_width, gap: 16px) {
            \Subtitle2(color: material_text_secondary) {
                6. PAPER ELEVATIONS (0, 1, 2, 3, 4, 6, 8, 12, 16, 24)
            }
            \HStack(gap: 20px, align: Align.Center) {
                \Paper("elev_0"; elevation: 0) {
                    \Center(width: 64px, height: 64px) {
                        \Caption(color: material_text_secondary) { elev=0 }
                    }
                }
                \Paper("elev_1"; elevation: 1) {
                    \Center(width: 64px, height: 64px) {
                        \Caption(color: material_text_secondary) { elev=1 }
                    }
                }
                \Paper("elev_2"; elevation: 2) {
                    \Center(width: 64px, height: 64px) {
                        \Caption(color: material_text_secondary) { elev=2 }
                    }
                }
                \Paper("elev_3"; elevation: 3) {
                    \Center(width: 64px, height: 64px) {
                        \Caption(color: material_text_secondary) { elev=3 }
                    }
                }
                \Paper("elev_4"; elevation: 4) {
                    \Center(width: 64px, height: 64px) {
                        \Caption(color: material_text_secondary) { elev=4 }
                    }
                }
                \Paper("elev_6"; elevation: 6) {
                    \Center(width: 64px, height: 64px) {
                        \Caption(color: material_text_secondary) { elev=6 }
                    }
                }
                \Paper("elev_8"; elevation: 8) {
                    \Center(width: 64px, height: 64px) {
                        \Caption(color: material_text_secondary) { elev=8 }
                    }
                }
                \Paper("elev_12"; elevation: 12) {
                    \Center(width: 64px, height: 64px) {
                        \Caption(color: material_text_secondary) { elev=12 }
                    }
                }
                \Paper("elev_16"; elevation: 16) {
                    \Center(width: 64px, height: 64px) {
                        \Caption(color: material_text_secondary) { elev=16 }
                    }
                }
                \Paper("elev_24"; elevation: 24) {
                    \Center(width: 64px, height: 64px) {
                        \Caption(color: material_text_secondary) { elev=24 }
                    }
                }
            }
        }
    }

    // Section 7: Paper Variants & Corners
    \Paper("card_paper_variants"; elevation: 1, radius: 8px, padding_x: 20px, padding_y: 20px) {
        \VStack(min_width: target_inner_width, gap: 16px) {
            \Subtitle2(color: material_text_secondary) {
                7. PAPER VARIANTS (ELEVATION VS OUTLINED) & CORNERS (ROUNDED VS SQUARE)
            }
            \HStack(gap: 24px, align: Align.Center) {
                \Paper("p_elev_rounded"; variant: PaperVariant.Elevation, elevation: 3) {
                    \Center(width: 140px, height: 56px) {
                        \Body2 { Elevation (Rounded) }
                    }
                }
                \Paper("p_elev_square"; variant: PaperVariant.Elevation, elevation: 3, square: true) {
                    \Center(width: 140px, height: 56px) {
                        \Body2 { Elevation (Square) }
                    }
                }
                \Paper("p_outlined_rounded"; variant: PaperVariant.Outlined) {
                    \Center(width: 140px, height: 56px) {
                        \Body2 { Outlined (Rounded) }
                    }
                }
                \Paper("p_outlined_square"; variant: PaperVariant.Outlined, square: true) {
                    \Center(width: 140px, height: 56px) {
                        \Body2 { Outlined (Square) }
                    }
                }
            }
        }
    }

    // Section 8: Dividers (Variants, With Children & Vertical Orientation)
    \Paper("card_dividers"; elevation: 1, radius: 8px, padding_x: 20px, padding_y: 20px) {
        \VStack(min_width: target_inner_width, gap: 16px) {
            \Subtitle2(color: material_text_secondary) {
                8. DIVIDERS (VARIANTS, WITH CHILDREN & VERTICAL ORIENTATION)
            }
            \HStack(gap: 24px, align: Align.Top) {
                // 8a. FullWidth, Inset & Middle Variants in a bottom-up Paper + VStack
                \Paper("div_variants_box"; variant: PaperVariant.Outlined, padding_x: 0px, padding_y: 12px) {
                    \VStack(gap: 10px) {
                        \HStack(gap: 16px) {
                            \Spacer(width: 16px)
                            \Body2 { FullWidth Divider below }
                            \Spacer(width: 48px)
                        }
                        \Divider("div_full"; variant: DividerVariant.FullWidth)
                        \HStack(gap: 16px) {
                            \Spacer(width: 16px)
                            \Body2 { Inset Divider below (72px left) }
                            \Spacer(width: 24px)
                        }
                        \Divider("div_inset"; variant: DividerVariant.Inset)
                        \HStack(gap: 16px) {
                            \Spacer(width: 16px)
                            \Body2 { Middle Divider below (16px sides) }
                            \Spacer(width: 16px)
                        }
                        \Divider("div_middle"; variant: DividerVariant.Middle)
                        \HStack(gap: 16px) {
                            \Spacer(width: 16px)
                            \Body2(color: material_text_secondary) { Bottom item in intrinsic VStack }
                            \Spacer(width: 16px)
                        }
                    }
                }

                // 8b. Dividers with Child Content (Center, Left, Right)
                \Paper("div_children_box"; variant: PaperVariant.Outlined, padding_x: 16px, padding_y: 12px) {
                    \VStack(min_width: 260px, gap: 12px) {
                        \Caption(color: material_text_secondary) {
                            Dividers with Children (Center, Left, Right)
                        }
                        \Divider("div_text_center";) {
                            \Caption(color: material_text_secondary) { CENTER }
                        }
                        \Divider("div_text_left"; text_align: Align.Left) {
                            \Caption(color: material_text_secondary) { LEFT }
                        }
                        \Divider("div_text_right"; text_align: Align.Right) {
                            \Caption(color: material_text_secondary) { RIGHT }
                        }
                        \Divider("div_with_button";) {
                            \Button(size: ButtonSize.Small, variant: ButtonVariant.Outlined) { Action }
                        }
                    }
                }

                // 8c. Vertical Dividers in an HStack
                \Paper("div_vertical_box"; variant: PaperVariant.Outlined, padding_x: 16px, padding_y: 12px) {
                    \VStack(gap: 12px) {
                        \Caption(color: material_text_secondary) {
                            Vertical (FullWidth & Middle)
                        }
                        \HStack(gap: 12px, align: Align.Center) {
                            \Button(size: ButtonSize.Small) { Cut }
                            \Divider("div_vert_full"; orientation: DividerOrientation.Vertical)
                            \Button(size: ButtonSize.Small) { Copy }
                            \Divider("div_vert_middle"; orientation: DividerOrientation.Vertical, variant: DividerVariant.Middle)
                            \Button(size: ButtonSize.Small) { Paste }
                        }
                    }
                }
            }
        }
    }

    // Section 9: Typography Type Scale & Shorthand Components
    \Paper("card_typography"; elevation: 1, radius: 8px, padding_x: 20px, padding_y: 20px) {
        \VStack(min_width: target_inner_width, gap: 8px) {
            \Subtitle2(color: material_text_secondary) {
                9. TYPOGRAPHY TYPE SCALE (H1-H6, SUBTITLE1/2, BODY1/2, BUTTON, CAPTION, OVERLINE)
            }
            \H1 { h1. Heading }
            \H2 { h2. Heading }
            \H3 { h3. Heading }
            \H4 { h4. Heading }
            \H5 { h5. Heading }
            \H6 { h6. Heading }
            \Subtitle1 { subtitle1. Lorem ipsum dolor sit amet, consectetur adipisicing elit. Quos blanditiis tenetur }
            \Subtitle2(color: material_text_secondary) { subtitle2. Lorem ipsum dolor sit amet, consectetur adipisicing elit. Quos blanditiis tenetur }
            \Body1 { body1. Lorem ipsum dolor sit amet, consectetur adipisicing elit. Quos blanditiis tenetur unde suscipit, quam beatae rerum inventore consectetur. }
            \Body2(color: material_text_secondary) { body2. Lorem ipsum dolor sit amet, consectetur adipisicing elit. Quos blanditiis tenetur unde suscipit, quam beatae rerum inventore consectetur. }
            \Typography(variant: TypographyVariant.Button) { BUTTON TEXT }
            \Caption(color: material_text_secondary) { caption text }
            \Overline(color: material_text_disabled) { OVERLINE TEXT }
        }
    }

    // Section 10: Cards (Card, CardHeader, CardContent & CardActions)
    \Paper("card_mui_cards"; elevation: 1, radius: 8px, padding_x: 20px, padding_y: 20px) {
        \VStack(min_width: target_inner_width, gap: 16px) {
            \Subtitle2(color: material_text_secondary) {
                10. CARDS (CARD, CARDHEADER, CARDCONTENT & CARDACTIONS)
            }
            \HStack(gap: 20px, align: Align.Top) {
                // 10a. Complex Card with Avatar Header, Divider, Content & Actions
                \Card("demo_card_recipe"; width: 266px) {
                    \CardHeader(
                        avatar: "R",
                        avatar_bg: material_error.main,
                        title: "Shrimp and Chorizo Paella",
                        subheader: "September 14, 2016"
                    )
                    \Divider
                    \CardContent {
                        \Body2(color: material_text_secondary) {
                            This impressive paella is a perfect party dish and a fun meal to cook together with your guests.
                        }
                    }
                    \CardActions {
                        \Button(size: ButtonSize.Small) { Share }
                        \Button(size: ButtonSize.Small) { Learn More }
                    }
                }

                // 10b. Outlined Word-of-the-Day Card
                \Card("demo_card_outlined"; width: 266px, variant: CardVariant.Outlined) {
                    \CardContent {
                        \Caption(color: material_text_secondary, gutter_bottom: true) {
                            Word of the Day
                        }
                        \H5 {
                            be•nev•o•lent
                        }
                        \Body2(color: material_text_secondary, gutter_bottom: true) {
                            adjective
                        }
                        \Body2 {
                            well meaning and kindly. "a benevolent smile"
                        }
                    }
                    \CardActions {
                        \Button(size: ButtonSize.Small) { Learn More }
                    }
                }

                // 10c. Raised Card with Action Slot & Right-Aligned Actions
                \Card("demo_card_raised"; width: 266px, raised: true) {
                    \CardHeader(
                        avatar: "M",
                        avatar_bg: material_primary.main,
                        title: "System Update",
                        subheader: "v2.4 Available"
                    ) {
                        \Button(size: ButtonSize.Small, variant: ButtonVariant.Outlined) { Info }
                    }
                    \Divider
                    \CardContent {
                        \Body2(color: material_text_secondary) {
                            Includes Material Design typography, elevated surfaces, and card layout primitives.
                        }
                    }
                    \CardActions(align: Align.Right) {
                        \Button(size: ButtonSize.Small, color: MaterialColor.Inherit) { Later }
                        \Button(size: ButtonSize.Small, variant: ButtonVariant.Contained) { Install }
                    }
                }
            }
        }
    }

    // Section 11: Avatars & Chips (Variants, Semantic Colors, Avatars, Sizes & Clickable States)
    \Paper("card_avatars_and_chips"; elevation: 1, radius: 8px, padding_x: 20px, padding_y: 20px) {
        \VStack(min_width: target_inner_width, gap: 16px) {
            \Subtitle2(color: material_text_secondary) {
                11. AVATARS (CIRCULAR, ROUNDED, SQUARE & SIZES) & CHIPS (FILLED, OUTLINED, AVATAR & CLICKABLE)
            }

            // 11a. Avatars: Circular, Rounded, Square & Custom Sizes
            \HStack(gap: 16px, align: Align.Center) {
                \Avatar("av_default";) { H }
                \Avatar("av_primary"; bg: material_primary.main, label: "N")
                \Avatar("av_secondary"; bg: material_secondary.main) { OP }
                \Avatar("av_rounded"; variant: AvatarVariant.Rounded, bg: material_success.main) { R }
                \Avatar("av_square"; variant: AvatarVariant.Square, bg: material_warning.main) { SQ }
                \Spacer(width: 8px)
                \Avatar("av_sm"; size: 24px, bg: material_info.main) { S }
                \Avatar("av_md"; size: 40px, bg: material_primary.main) { M }
                \Avatar("av_lg"; size: 56px, bg: material_error.main) { L }
            }

            \Divider

            // 11b. Chips: Basic, Clickable, Disabled & Leading Avatar
            \HStack(gap: 12px, align: Align.Center) {
                \Chip("chip_filled";) { Chip Filled }
                \Chip("chip_outlined"; variant: ChipVariant.Outlined) { Chip Outlined }
                \Chip("chip_clickable_filled"; clickable: true) { Clickable }
                \Chip("chip_clickable_outlined"; variant: ChipVariant.Outlined, clickable: true) { Clickable Outlined }
                \Chip("chip_avatar_filled"; avatar: "M", clickable: true) { Avatar Chip }
                \Chip("chip_avatar_outlined"; variant: ChipVariant.Outlined, avatar: "F", avatar_bg: material_primary.main, clickable: true) { Custom Avatar }
                \Chip("chip_disabled"; disabled: true) { Disabled }
            }

            // 11c. Chips: Semantic Palette Colors (Filled & Outlined) + Small Size
            \HStack(gap: 10px, align: Align.Center) {
                \Chip("chip_c_primary"; color: MaterialColor.Primary, clickable: true) { Primary }
                \Chip("chip_c_secondary"; color: MaterialColor.Secondary, clickable: true) { Secondary }
                \Chip("chip_c_success"; color: MaterialColor.Success, clickable: true) { Success }
                \Chip("chip_c_error"; color: MaterialColor.Error, clickable: true) { Error }
                \Chip("chip_c_info"; color: MaterialColor.Info, clickable: true) { Info }
                \Chip("chip_c_warning"; color: MaterialColor.Warning, clickable: true) { Warning }
            }

            \HStack(gap: 10px, align: Align.Center) {
                \Chip("chip_o_primary"; variant: ChipVariant.Outlined, color: MaterialColor.Primary, avatar: "P", clickable: true) { Primary }
                \Chip("chip_o_secondary"; variant: ChipVariant.Outlined, color: MaterialColor.Secondary, clickable: true) { Secondary }
                \Chip("chip_o_success"; variant: ChipVariant.Outlined, color: MaterialColor.Success, clickable: true) { Success }
                \Chip("chip_o_error"; variant: ChipVariant.Outlined, color: MaterialColor.Error, clickable: true) { Error }
                \Spacer(width: 8px)
                \Chip("chip_sm_filled"; size: ChipSize.Small, color: MaterialColor.Primary) { Small Filled }
                \Chip("chip_sm_outlined"; size: ChipSize.Small, variant: ChipVariant.Outlined, color: MaterialColor.Secondary, avatar: "S") { Small Avatar }
            }
        }
    }

    // Section 12: Selection Controls (Switch, Checkbox & Radio)
    \Paper("card_selection_controls"; elevation: 1, radius: 8px, padding_x: 20px, padding_y: 20px) {
        \VStack(min_width: target_inner_width, gap: 16px) {
            \Subtitle2(color: material_text_secondary) {
                12. SELECTION CONTROLS (SWITCH, CHECKBOX & RADIO — STATES, PALETTE COLORS, SIZES & LABELS)
            }

            // 12a. Switches: States, Semantic Colors, Sizes & Labeled
            \HStack(gap: 16px, align: Align.Center) {
                \Switch("sw_unchecked";)
                \Switch("sw_checked"; checked: true) { Primary }
                \Switch("sw_secondary"; checked: true, color: MaterialColor.Secondary) { Secondary }
                \Switch("sw_success"; checked: true, color: MaterialColor.Success) { Success }
                \Switch("sw_warning"; checked: true, color: MaterialColor.Warning) { Warning }
                \Switch("sw_error"; checked: true, color: MaterialColor.Error) { Error }
                \Switch("sw_small"; checked: true, size: SwitchSize.Small, label: "Small")
                \Switch("sw_disabled_off"; disabled: true) { Disabled Off }
                \Switch("sw_disabled_on"; checked: true, disabled: true) { Disabled On }
            }

            \Divider

            // 12b. Checkboxes: Unchecked, Checked, Indeterminate, Semantic Colors, Sizes & Disabled
            \HStack(gap: 16px, align: Align.Center) {
                \Checkbox("cb_unchecked";) { Unchecked }
                \Checkbox("cb_checked"; checked: true) { Checked }
                \Checkbox("cb_indeterminate"; indeterminate: true) { Indeterminate }
                \Checkbox("cb_secondary"; checked: true, color: MaterialColor.Secondary) { Secondary }
                \Checkbox("cb_success"; checked: true, color: MaterialColor.Success) { Success }
                \Checkbox("cb_error"; checked: true, color: MaterialColor.Error) { Error }
                \Checkbox("cb_small"; checked: true, size: CheckboxSize.Small, label: "Small")
                \Checkbox("cb_disabled"; checked: true, disabled: true) { Disabled }
            }

            \Divider

            // 12c. Radio Buttons: Unchecked, Checked, Semantic Colors, Sizes & Disabled
            \HStack(gap: 16px, align: Align.Center) {
                \Radio("rad_unchecked";) { Option A }
                \Radio("rad_checked"; checked: true) { Option B }
                \Radio("rad_secondary"; checked: true, color: MaterialColor.Secondary) { Secondary }
                \Radio("rad_success"; checked: true, color: MaterialColor.Success) { Success }
                \Radio("rad_warning"; checked: true, color: MaterialColor.Warning) { Warning }
                \Radio("rad_error"; checked: true, color: MaterialColor.Error) { Error }
                \Radio("rad_small"; checked: true, size: RadioSize.Small, label: "Small")
                \Radio("rad_disabled"; checked: true, disabled: true) { Disabled }
            }
        }
    }

    // Section 13: Lists (List, ListItem, ListItemButton, ListItemText & ListItemAvatar)
    \Paper("card_lists"; elevation: 1, radius: 8px, padding_x: 20px, padding_y: 20px) {
        \VStack(min_width: target_inner_width, gap: 16px) {
            \Subtitle2(color: material_text_secondary) {
                13. LISTS (LIST, LISTITEM, LISTITEMBUTTON, LISTITEMTEXT & LISTITEMAVATAR)
            }

            \HStack(gap: 20px, align: Align.Top) {
                // 13a. Interactive Navigation List (ListItemButton, Selected, Inset & Disabled)
                \Paper("list_nav_paper"; variant: PaperVariant.Outlined, padding_x: 0px, padding_y: 0px) {
                    \List("list_nav"; width: 266px, subheader: "Mailbox Folders") {
                        \ListItemButton("list_btn_inbox"; selected: true) {
                            \ListItemAvatar(label: "I", bg: material_primary.main)
                            \ListItemText(primary: "Inbox", secondary: "3 unread messages")
                        }
                        \ListItemButton("list_btn_drafts";) {
                            \ListItemAvatar {
                                \Avatar(bg: material_secondary.main) { D }
                            }
                            \ListItemText(primary: "Drafts", secondary: "Updated 5m ago")
                        }
                        \Divider(variant: DividerVariant.Inset)
                        \ListItemButton("list_btn_starred";) {
                            \ListItemText(inset: true, primary: "Starred (Inset)")
                        }
                        \ListItemButton("list_btn_trash"; disabled: true) {
                            \ListItemText(inset: true, primary: "Trash (Disabled)")
                        }
                    }
                }

                // 13b. Two-Line Avatar List (ListItem, ListItemAvatar, ListItemText & Inset Dividers)
                \Paper("list_folders_paper"; variant: PaperVariant.Outlined, padding_x: 0px, padding_y: 0px) {
                    \List("list_folders"; width: 266px, subheader: "Recent Albums") {
                        \ListItem("list_item_photos";) {
                            \ListItemAvatar {
                                \Avatar(bg: material_success.main) { P }
                            }
                            \ListItemText(primary: "Photos", secondary: "Jan 9, 2026")
                        }
                        \Divider(variant: DividerVariant.Inset)
                        \ListItem("list_item_work";) {
                            \ListItemAvatar {
                                \Avatar(bg: material_info.main) { W }
                            }
                            \ListItemText(primary: "Work", secondary: "Jan 7, 2026")
                        }
                        \Divider(variant: DividerVariant.Inset)
                        \ListItem("list_item_vacation";) {
                            \ListItemAvatar {
                                \Avatar(bg: material_warning.main) { V }
                            }
                            \ListItemText(primary: "Vacation", secondary: "July 20, 2025")
                        }
                    }
                }

                // 13c. Settings List with Trailing Secondary Actions & Dense Mode
                \Paper("list_settings_paper"; variant: PaperVariant.Outlined, padding_x: 0px, padding_y: 0px) {
                    \List("list_settings"; width: 266px, dense: true, subheader: "Quick Settings (Dense)") {
                        \ListItem("list_item_wifi"; divider: true) {
                            \ListItemAvatar(label: "W", size: 32px, min_width: 48px, bg: material_primary.main)
                            \ListItemText(primary: "Wi-Fi", secondary: "Home-5G")
                            \Switch("list_sw_wifi"; checked: true, size: SwitchSize.Small)
                        }
                        \ListItem("list_item_bt"; divider: true) {
                            \ListItemAvatar(label: "B", size: 32px, min_width: 48px, bg: material_info.main)
                            \ListItemText(primary: "Bluetooth", secondary: "2 devices")
                            \Switch("list_sw_bt"; checked: true, size: SwitchSize.Small)
                        }
                        \ListItem("list_item_sync"; secondary_action: true) {
                            \ListItemText(primary: "Auto-Sync Backup", secondary: "Daily at 2:00 AM")
                            \Checkbox("list_cb_sync"; checked: true, size: CheckboxSize.Small)
                        }
                    }
                }
            }
        }
    }

    // Section 14: AppBar & Toolbar (Colors, Regular/Dense Variants, Actions & Embedded Tabs)
    \Paper("card_appbar_toolbar"; elevation: 1, radius: 8px, padding_x: 20px, padding_y: 20px) {
        \VStack(min_width: target_inner_width, gap: 16px) {
            \Subtitle2(color: material_text_secondary) {
                14. APPBAR & TOOLBAR (COLORS, REGULAR 64PX, DENSE 48PX, ACTIONS & EMBEDDED TABS)
            }

            // 14a. Primary Regular AppBar with Nav Icon, Title & Inherit Action Button
            \AppBar("appbar_primary"; width: target_inner_width, color: MaterialColor.Primary) {
                \Toolbar("toolbar_primary"; nav_icon: "☰", title: "News & Updates") {
                    \Button("appbar_btn_login"; color: MaterialColor.Inherit) { Login }
                }
            }

            // 14b. Secondary Dense AppBar with Avatar, Subtitle & Trailing Actions
            \AppBar("appbar_secondary"; width: target_inner_width, color: MaterialColor.Secondary) {
                \Toolbar("toolbar_dense"; variant: ToolbarVariant.Dense, avatar: "M", title: "Material Workspace", subtitle: "Dense 48px Toolbar") {
                    \Button("appbar_btn_share"; color: MaterialColor.Inherit, size: ButtonSize.Small) { Share }
                    \Button("appbar_btn_export"; variant: ButtonVariant.Outlined, color: MaterialColor.Inherit, size: ButtonSize.Small) { Export }
                }
            }

            // 14c. Light Inherit Outlined AppBar with Child Composition
            \AppBar("appbar_inherit"; width: target_inner_width, color: MaterialColor.Inherit, variant: AppBarVariant.Outlined) {
                \Toolbar("toolbar_inherit"; secondary_action: true, gap: 12px) {
                    \Avatar(size: 32px, bg: material_primary.main) { D }
                    \H6 { DirectedType Docs }
                    \Chip(size: ChipSize.Small, color: MaterialColor.Info, variant: ChipVariant.Outlined) { v2.4 }
                    \Button("appbar_btn_github"; variant: ButtonVariant.Outlined, size: ButtonSize.Small) { Star }
                }
            }

            // 14d. Primary AppBar with Embedded Inherit Tabs
            \AppBar("appbar_with_tabs"; width: target_inner_width, color: MaterialColor.Primary) {
                \Toolbar("toolbar_with_tabs"; variant: ToolbarVariant.Dense, nav_icon: "☰", title: "Analytics Dashboard") {
                    \Button("appbar_btn_profile"; color: MaterialColor.Inherit, size: ButtonSize.Small) { Profile }
                }
                \Tabs("appbar_tabs"; value: 0, text_color: MaterialColor.Inherit, indicator_color: MaterialColor.Inherit) {
                    \Tab("appbar_tab_0"; label: "OVERVIEW")
                    \Tab("appbar_tab_1"; label: "METRICS")
                    \Tab("appbar_tab_2"; label: "ALERTS")
                }
            }
        }
    }

    // Section 15: Tabs & Tab (Standard, Centered, FullWidth, Icons, Disabled & Vertical)
    \Paper("card_tabs"; elevation: 1, radius: 8px, padding_x: 20px, padding_y: 20px) {
        \VStack(min_width: target_inner_width, gap: 16px) {
            \Subtitle2(color: material_text_secondary) {
                15. TABS & TAB (STANDARD, CENTERED, FULLWIDTH, ICON POSITIONS, DISABLED & VERTICAL)
            }

            // 15a. Standard Horizontal Tabs with Bottom Divider & Disabled Item
            \Paper("tabs_standard_paper"; variant: PaperVariant.Outlined, padding_x: 0px, padding_y: 0px) {
                \Tabs("tabs_standard"; width: target_inner_width, value: 0, divider: true) {
                    \Tab("tab_std_0"; label: "ITEM ONE")
                    \Tab("tab_std_1"; label: "ITEM TWO")
                    \Tab("tab_std_2"; label: "ITEM THREE")
                    \Tab("tab_std_disabled"; label: "DISABLED", disabled: true)
                }
            }

            // 15b. Centered Secondary Tabs & FullWidth Tabs
            \HStack(gap: 20px, align: Align.Top) {
                \Paper("tabs_centered_paper"; variant: PaperVariant.Outlined, padding_x: 0px, padding_y: 0px) {
                    \Tabs(
                        "tabs_centered";
                        width: 410px,
                        value: 1,
                        centered: true,
                        divider: true,
                        text_color: MaterialColor.Secondary,
                        indicator_color: MaterialColor.Secondary
                    ) {
                        \Tab("tab_cnt_0"; label: "RECENTS")
                        \Tab("tab_cnt_1"; label: "FAVORITES")
                        \Tab("tab_cnt_2"; label: "NEARBY")
                    }
                }

                \Paper("tabs_fullwidth_paper"; variant: PaperVariant.Outlined, padding_x: 0px, padding_y: 0px) {
                    \Tabs(
                        "tabs_fullwidth";
                        width: 410px,
                        value: 0,
                        variant: TabsVariant.FullWidth,
                        divider: true,
                        text_color: MaterialColor.Success,
                        indicator_color: MaterialColor.Success
                    ) {
                        \Tab("tab_fw_0"; label: "ACTIVE")
                        \Tab("tab_fw_1"; label: "COMPLETED")
                        \Tab("tab_fw_2"; label: "ARCHIVED")
                    }
                }
            }

            // 15c. Icon Tabs (Stacked Top 72px & Inline Start 48px) and Vertical Tabs
            \HStack(gap: 20px, align: Align.Top) {
                \Paper("tabs_icons_paper"; variant: PaperVariant.Outlined, padding_x: 0px, padding_y: 0px) {
                    \VStack(gap: 0px) {
                        \Tabs("tabs_icon_top"; width: 520px, value: 0, variant: TabsVariant.FullWidth, divider: true) {
                            \Tab("tab_ic_top_0"; icon: "☎", label: "CALLS")
                            \Tab("tab_ic_top_1"; icon: "♥", label: "FAVORITES")
                            \Tab("tab_ic_top_2"; icon: "⌂", label: "NEARBY")
                        }
                        \Tabs(
                            "tabs_icon_start";
                            width: 520px,
                            value: 1,
                            variant: TabsVariant.FullWidth,
                            text_color: MaterialColor.Info,
                            indicator_color: MaterialColor.Info
                        ) {
                            \Tab("tab_ic_start_0"; icon: "✉", icon_position: TabIconPosition.Start, label: "INBOX")
                            \Tab("tab_ic_start_1"; icon: "★", icon_position: TabIconPosition.Start, label: "STARRED")
                            \Tab("tab_ic_start_2"; icon: "⚙", icon_position: TabIconPosition.Start, label: "SETTINGS")
                        }
                    }
                }

                \Paper("tabs_vertical_paper"; variant: PaperVariant.Outlined, padding_x: 0px, padding_y: 0px) {
                    \Tabs(
                        "tabs_vertical";
                        width: 300px,
                        value: 0,
                        orientation: TabsOrientation.Vertical,
                        divider: true
                    ) {
                        \Tab("tab_vert_0"; label: "GENERAL PROFILE")
                        \Tab("tab_vert_1"; label: "SECURITY & KEYS")
                        \Tab("tab_vert_2"; label: "NOTIFICATIONS")
                    }
                }
            }
        }
    }

    // Section 16: Sliders (Sizes, Palette Colors, Discrete Steps & Marks, Labeled Marks & Disabled)
    \Paper("card_sliders"; elevation: 1, radius: 8px, padding_x: 20px, padding_y: 20px) {
        \VStack(min_width: target_inner_width, gap: 16px) {
            \Subtitle2(color: material_text_secondary) {
                16. SLIDERS (CONTINUOUS, SMALL/MEDIUM SIZES, PALETTE COLORS, DISCRETE STEPS, MARKS & DISABLED)
            }

            // 16a. Continuous, Small Size, Disabled & Value Label Always On
            \HStack(gap: 28px, align: Align.Center) {
                \VStack(gap: 4px) {
                    \Caption(color: material_text_secondary) { Small (value=70) }
                    \Slider("sl_small"; width: 180px, size: SliderSize.Small, value: 70)
                }
                \VStack(gap: 4px) {
                    \Caption(color: material_text_secondary) { Medium Default (value=50) }
                    \Slider("sl_default"; width: 180px, value: 50)
                }
                \VStack(gap: 4px) {
                    \Caption(color: material_text_secondary) { Disabled (value=30) }
                    \Slider("sl_disabled"; width: 180px, value: 30, disabled: true)
                }
                \VStack(gap: 20px) {
                    \Caption(color: material_text_secondary) { Value Label On (value=80) }
                    \Slider("sl_val_on"; width: 180px, value: 80, value_label_display: SliderValueLabelDisplay.On)
                }
            }

            \Divider

            // 16b. Semantic Palette Colors (Secondary, Success, Warning, Error, Info)
            \HStack(gap: 20px, align: Align.Center) {
                \Slider("sl_secondary"; width: 150px, value: 65, color: MaterialColor.Secondary)
                \Slider("sl_success"; width: 150px, value: 80, color: MaterialColor.Success)
                \Slider("sl_warning"; width: 150px, value: 45, color: MaterialColor.Warning)
                \Slider("sl_error"; width: 150px, value: 25, color: MaterialColor.Error)
                \Slider("sl_info"; width: 150px, value: 90, color: MaterialColor.Info)
            }

            \Divider

            // 16c. Discrete Step Marks, Custom Labeled Marks & Inverted Track
            \HStack(gap: 32px, align: Align.Top) {
                \VStack(gap: 6px) {
                    \Caption(color: material_text_secondary) { Discrete Step=10 with Marks }
                    \Slider(
                        "sl_discrete";
                        width: 240px,
                        value: 30,
                        min: 0,
                        max: 100,
                        step: 10,
                        marks: true,
                        value_label_display: SliderValueLabelDisplay.Auto
                    )
                }

                \VStack(gap: 6px) {
                    \Caption(color: material_text_secondary) { Custom Labeled Marks (°C) }
                    \Slider(
                        "sl_custom_marks";
                        width: 260px,
                        value: 20,
                        min: 0,
                        max: 100,
                        step: 10
                    ) {
                        \SliderMark(value: 0, label: "0°C")
                        \SliderMark(value: 20, label: "20°C")
                        \SliderMark(value: 37, label: "37°C")
                        \SliderMark(value: 100, label: "100°C")
                    }
                }

                \VStack(gap: 6px) {
                    \Caption(color: material_text_secondary) { Inverted Track }
                    \Slider(
                        "sl_inverted";
                        width: 220px,
                        value: 30,
                        track: SliderTrack.Inverted,
                        color: MaterialColor.Secondary
                    )
                }
            }
        }
    }
};



