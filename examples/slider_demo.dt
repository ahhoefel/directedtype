// DirectedType Standard Component Library Demo: Slider & Callbacks
// Showcases hardware pointer capture, smooth dragging, and strongly-typed callbacks.

\use "../components/PadOut.dt"
\use "../components/HCenterUp.dt"
\use "../components/VStack.dt"
\use "../components/HStack.dt"
\use "../components/Card.dt"
\use "../components/Slider.dt"
\use "../components/Divider.dt"
\use "../components/Spacer.dt"
\use "../theme/default.dt"

\Window(title: "Studio Audio Mixer")

// Background Canvas
\Rect(
    x: 0,
    y: 0,
    width: max(window.width, content.width),
    height: max(window.height, content.bottom),
    color: #0f172a
)

\Component AudioMixer(
    width: Distance = 480px,
    x: Distance = parent.left,
    y: Distance = parent.top
) {
    \state master: Float = 75;
    \state bass: Float = 40;
    \state treble: Float = 60;

    \alias height = card.height;
    \alias right = card.right;
    \alias bottom = card.bottom;

    \let card = \Card("mixer_card"; x: x, y: y, width: width, style: card_dark, gap: 16px) {
        \Text(font: \Font(size: 18px, weight: 700), color: #f8fafc) {
            Studio Audio Mixer
        }
        \Text(font: \Font(size: 13px, weight: 400), color: #94a3b8) {
            Hardware pointer capture, smooth dragging, and strongly-typed callbacks.
        }

        \Divider(color: #334155)

        // Master Volume
        \VStack(gap: 6px) {
            \HStack(gap: 8px) {
                \Text(font: \Font(size: 14px, weight: 600), color: #e2e8f0) { Master Volume }
                \Spacer(width: 1px)
                \Text(text: to_fixed(master, 0) + "%", font: \Font(size: 14px, weight: 700), color: #38bdf8)
            }
            \Slider(
                width: 400px,
                height: 24px,
                min: 0,
                max: 100,
                value: 75,
                fill_color: #38bdf8,
                on_change: set_master
            )
        }

        // Bass Boost
        \VStack(gap: 6px) {
            \HStack(gap: 8px) {
                \Text(font: \Font(size: 14px, weight: 600), color: #e2e8f0) { Bass Boost }
                \Spacer(width: 1px)
                \Text(text: to_fixed(bass, 0) + "%", font: \Font(size: 14px, weight: 700), color: #a855f7)
            }
            \Slider(
                width: 400px,
                height: 24px,
                min: 0,
                max: 100,
                value: 40,
                fill_color: #a855f7,
                on_change: set_bass
            )
        }

        // Treble
        \VStack(gap: 6px) {
            \HStack(gap: 8px) {
                \Text(font: \Font(size: 14px, weight: 600), color: #e2e8f0) { Treble }
                \Spacer(width: 1px)
                \Text(text: to_fixed(treble, 0) + "%", font: \Font(size: 14px, weight: 700), color: #10b981)
            }
            \Slider(
                width: 400px,
                height: 24px,
                min: 0,
                max: 100,
                value: 60,
                fill_color: #10b981,
                on_change: set_treble
            )
        }

        \Divider(color: #334155)

        // Dynamic Output Monitor
        \VStack(gap: 8px) {
            \HStack(gap: 8px) {
                \Text(font: \Font(size: 14px, weight: 600), color: #e2e8f0) { Output Visualizer }
                \Spacer(width: 1px)
                \Text(text: to_fixed(40 + bass * 3.6, 0) + "w × " + to_fixed(20 + treble * 0.8, 0) + "h", font: \Font(size: 12px, weight: 600), color: #94a3b8)
            }
            \Rect(
                width: max(40px, min(400px, 40px + bass * 3.6px)),
                height: max(20px, min(100px, 20px + treble * 0.8px)),
                color: hsl(master * 3.6, 85, 55),
                radius: 8px
            )
        }
    };
}

// Main Page Layout: centered horizontally with outward padding around the card
\let content = \HCenterUp {
    \PadOut(padding_x: 40px, padding_y: 40px) {
        \AudioMixer(width: 480px)
    }
};

