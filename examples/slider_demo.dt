// DirectedType Standard Component Library Demo: Slider & Callbacks
// Showcases hardware pointer capture, smooth dragging, and strongly-typed callbacks.

\use "../components/PadOut.dt"
\use "../components/HCenter.dt"
\use "../components/VStack.dt"
\use "../components/HStack.dt"
\use "../components/Card.dt"
\use "../components/Slider.dt"
\use "../components/Divider.dt"
\use "../components/Spacer.dt"
\use "../theme/default.dt"

\Window(title: "Studio Audio Mixer")

// Background Canvas
\Rect(
    x: 0,
    y: 0,
    width: max(window.width, content.width),
    height: max(window.height, content.bottom),
    color: #0f172a
)

\Component AudioMixer(
    width: Number: 480,
    x: Number: parent.left,
    y: Number: parent.top
) {
    \state master: 75;
    \state bass: 40;
    \state treble: 60;

    \alias height = card.height;
    \alias right = card.right;
    \alias bottom = card.bottom;

    \let card = \Card("mixer_card"; x: self.x, y: self.y, width: self.width, style: card_dark, gap: 16) {
        \Text(size: 18, weight: 700, color: #f8fafc) {
            Studio Audio Mixer
        }
        \Text(size: 13, weight: 400, color: #94a3b8) {
            Hardware pointer capture, smooth dragging, and strongly-typed callbacks.
        }

        \Divider(color: #334155)

        // Master Volume
        \VStack(gap: 6) {
            \HStack(gap: 8) {
                \Text(size: 14, weight: 600, color: #e2e8f0) { Master Volume }
                \Spacer(width: 1)
                \Text(text: to_fixed(self.master, 0) + "%", size: 14, weight: 700, color: #38bdf8)
            }
            \Slider(
                width: 400,
                height: 24,
                min: 0,
                max: 100,
                value: 75,
                fill_color: #38bdf8,
                on_change: self.set_master
            )
        }

        // Bass Boost
        \VStack(gap: 6) {
            \HStack(gap: 8) {
                \Text(size: 14, weight: 600, color: #e2e8f0) { Bass Boost }
                \Spacer(width: 1)
                \Text(text: to_fixed(self.bass, 0) + "%", size: 14, weight: 700, color: #a855f7)
            }
            \Slider(
                width: 400,
                height: 24,
                min: 0,
                max: 100,
                value: 40,
                fill_color: #a855f7,
                on_change: self.set_bass
            )
        }

        // Treble
        \VStack(gap: 6) {
            \HStack(gap: 8) {
                \Text(size: 14, weight: 600, color: #e2e8f0) { Treble }
                \Spacer(width: 1)
                \Text(text: to_fixed(self.treble, 0) + "%", size: 14, weight: 700, color: #10b981)
            }
            \Slider(
                width: 400,
                height: 24,
                min: 0,
                max: 100,
                value: 60,
                fill_color: #10b981,
                on_change: self.set_treble
            )
        }

        \Divider(color: #334155)

        // Dynamic Output Monitor
        \VStack(gap: 8) {
            \HStack(gap: 8) {
                \Text(size: 14, weight: 600, color: #e2e8f0) { Output Visualizer }
                \Spacer(width: 1)
                \Text(text: to_fixed(40 + self.bass * 3.6, 0) + "w × " + to_fixed(20 + self.treble * 0.8, 0) + "h", size: 12, weight: 600, color: #94a3b8)
            }
            \Rect(
                width: max(40, min(400, 40 + self.bass * 3.6)),
                height: max(20, min(100, 20 + self.treble * 0.8)),
                color: hsl(self.master * 3.6, 85, 55),
                radius: 8
            )
        }
    };
}

// Main Page Layout: centered horizontally with outward padding around the card
\let content = \HCenter {
    \PadOut(padding_x: 40, padding_y: 40) {
        \AudioMixer(width: 480)
    }
};

